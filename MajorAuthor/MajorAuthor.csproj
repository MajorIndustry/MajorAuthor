    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f04f5431-80c3-44dd-a01e-6dc49cb8152d</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
