@model MajorAuthor.Models.ResetPasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Сброс пароля";
}

<div class="min-h-screen custom-bg flex items-start sm:items-center justify-center py-8 px-4">
    <div class="w-full max-w-md p-6 rounded-2xl white-block border shadow-xl card" style="background:#fff;">
        <header class="text-center mb-4">
            <h1 class="text-3xl sm:text-4xl font-extrabold gold-accent">@ViewData["Title"]</h1>
        </header>

        <p class="text-sm text-themed-label text-center mb-6 text-black">Введите ваш Email, новый пароль и подтвердите его.</p>

        <form method="post" asp-controller="Account" asp-action="ResetPassword" class="space-y-4">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-red-600 font-bold mb-4" role="alert"></div>

            @if (!string.IsNullOrEmpty(ViewBag.StatusMessage))
            {
                <div class="alert @((string)ViewBag.StatusMessageType == "success" ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700") p-3 rounded-md mb-4" role="alert">
                    @ViewBag.StatusMessage
                </div>
            }

            <!-- Скрытые поля для Code и Email -->
            <input type="hidden" asp-for="Code" />
            <input type="hidden" asp-for="Email" />

            <div>
                <label asp-for="Email" class="block text-sm font-medium label-dark mb-1">Почта</label>
                <input asp-for="Email" class="mt-1 block w-full rounded-lg py-3 px-4 border input-dark focus:outline-none focus:ring-4 focus:ring-yellow-300/20" autocomplete="email" aria-required="true" readonly />
                <span asp-validation-for="Email" class="text-red-600 text-xs mt-1 block"></span>
            </div>

            <div class="relative">
                <label asp-for="Password" class="block text-sm font-medium label-dark mb-1">Новый пароль</label>
                <input asp-for="Password" id="passwordInput" maxlength="100" minlength="6" class="mt-1 block w-full rounded-lg py-3 px-4 border input-dark focus:outline-none focus:ring-4 focus:ring-yellow-300/20" autocomplete="new-password" aria-required="true" placeholder="Новый пароль" />
                <span asp-validation-for="Password" class="text-red-600 text-xs mt-1 block"></span>
                <div id="passwordHelp" class="hidden absolute right-0 top-0 mt-12 w-64 p-3 bg-white border rounded shadow text-xs text-gray-700 z-10">
                    <strong>Требования к паролю:</strong>
                    <ul class="mt-2 list-disc list-inside">
                        <li>Минимум 6 символов</li>
                        <li>До 100 символов</li>
                        <li>Хотя бы 1 заглавная буква</li>
                        <li>Хотя бы 1 строчная буква</li>
                        <li>Хотя бы 1 цифра</li>
                        <li>Хотя бы 1 специальный символ</li>
                    </ul>
                </div>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium label-dark mb-1">Подтвердите пароль</label>
                <input asp-for="ConfirmPassword" class="mt-1 block w-full rounded-lg py-3 px-4 border input-dark focus:outline-none focus:ring-4 focus:ring-yellow-300/20" autocomplete="new-password" aria-required="true" placeholder="Подтвердите новый пароль" />
                <span asp-validation-for="ConfirmPassword" class="text-red-600 text-xs mt-1 block"></span>
            </div>

            <div>
                <button type="submit" class="btn-primary w-full py-3 rounded-full">Сбросить пароль</button>
            </div>
        </form>

        <div class="mt-4 text-center">
            <p class="text-sm text-black"> <a asp-controller="Account" asp-action="Login" class="text-accent-gold hover:underline">Вернуться к входу</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var pwd = document.getElementById('passwordInput');
            var help = document.getElementById('passwordHelp');
            if (pwd && help) {
                pwd.addEventListener('mouseenter', function () { help.classList.remove('hidden'); });
                pwd.addEventListener('focus', function () { help.classList.remove('hidden'); });
                pwd.addEventListener('mouseleave', function () { help.classList.add('hidden'); });
                pwd.addEventListener('blur', function () { help.classList.add('hidden'); });
            }
        })();
    </script>
}
