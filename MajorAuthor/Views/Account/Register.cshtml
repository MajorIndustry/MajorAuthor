@model MajorAuthor.Models.RegisterViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Регистрация";
}

<div class="min-h-screen custom-bg flex items-start sm:items-center justify-center py-8 px-4">
    <div class="w-full max-w-md p-6 rounded-2xl white-block">
        <!-- Заголовок -->
        <header class="text-center mb-6">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold section-title decorative-title">
                @ViewData["Title"]
            </h1>
        </header>

        <!-- Вывод общих ошибок -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-4 p-3 bg-red-100 border border-red-400 text-red-700 rounded">
                <div asp-validation-summary="All" class="text-sm"></div>
            </div>
        }

        <!-- Блок внешней авторизации -->
        <div class="mb-6">
            <p class="text-sm text-center mb-4">С помощью соцсетей</p>
            <div class="flex items-center justify-center gap-4">
                @if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <span class="text-sm">Внешние провайдеры не настроены.</span>
                }
                else
                {
                    @foreach (var provider in Model.ExternalLogins)
                    {
                        <a href="@Url.Action("ExternalLogin", "Account", new { provider = provider.Name, returnUrl = Model.ReturnUrl })"
                           class="external-login-btn w-12 h-12 rounded-xl flex items-center justify-center transition-all duration-200 hover:scale-105 social-btn-bg"
                           title="Зарегистрироваться через @provider.DisplayName"
                           aria-label="Зарегистрироваться через @provider.DisplayName">

                            @if (provider.DisplayName == "Google")
                            {
                                <svg width="20" height="20" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <path fill="#EA4335" d="M24 9.5c3.5 0 6.4 1.3 8.4 2.4l6.1-6.1C34.6 3 29.7 1 24 1 14.8 1 6.9 6.2 3 13.7l7.3 5.6C12.8 13 17.9 9.5 24 9.5z" />
                                    <path fill="#34A853" d="M46.5 24.5c0-1.5-.1-2.5-.4-3.7H24v7h12.6c-.6 3.1-2.6 6-6.1 7.7l7.4 5.8C43.6 37.6 46.5 31.7 46.5 24.5z" />
                                    <path fill="#4A90E2" d="M10.3 29.3A14.4 14.4 0 0 1 9 24.5c0-1.7.3-3.4.9-4.9L3.5 13.9A23.9 23.9 0 0 0 1 24.5c0 3.7.9 7.2 2.5 10.3l6.8-5.5z" />
                                    <path fill="#FBBC05" d="M24 46c6 0 11.1-2 15-5.5l-7.4-5.8c-2 1.5-4.6 2.4-7.6 2.4-6.2 0-11.3-3.5-13.7-8.6L3 34.3C6.9 41.8 14.8 47 24 47z" />
                                </svg>
                            }
                            else if (provider.DisplayName == "Yandex")
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="yandex-icon">
                                    <circle cx="12" cy="12" r="10" class="yandex-circle" />
                                    <text x="12" y="16" text-anchor="middle" font-family="Inter, Arial, sans-serif" font-size="12" class="yandex-text">Я</text>
                                </svg>
                            }
                            else
                            {
                                @if (!string.IsNullOrEmpty(provider.DisplayName))
                                {
                                    <span class="provider-initial">@provider.DisplayName[0]</span>
                                }
                                else
                                {
                                    <span class="provider-initial">?</span>
                                }
                            }
                        </a>
                    }
                }
            </div>
        </div>

        <!-- Разделитель -->
        <div class="flex items-center gap-3 mb-6">
            <div class="flex-1 border-t border-[var(--border-color)]"></div>
            <div class="text-xs">или</div>
            <div class="flex-1 border-t border-[var(--border-color)]"></div>
        </div>

        <!-- Форма регистрации -->
        <form asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="space-y-6" novalidate>
            @Html.AntiForgeryToken()

            <div>
                <label asp-for="UserName" class="block text-sm font-medium mb-2">Логин</label>
                <input asp-for="UserName" id="UserName" maxlength="100" class="auth-input w-full rounded-lg px-4 py-3"
                       autocomplete="username" aria-required="true" placeholder="Введите логин" />
                <span asp-validation-for="UserName" class="validation-error"></span>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium mb-2">Почта</label>
                <input asp-for="Email" id="emailInput" maxlength="200" class="auth-input w-full rounded-lg px-4 py-3"
                       autocomplete="email" aria-required="true" placeholder="name@example.com"
                       inputmode="email" />
                <span asp-validation-for="Email" class="validation-error"></span>
            </div>

            <div class="relative">
                <label asp-for="Password" class="block text-sm font-medium mb-2">Пароль</label>
                <input asp-for="Password" id="passwordInput" maxlength="100" minlength="6"
                       class="auth-input w-full rounded-lg px-4 py-3"
                       autocomplete="new-password" aria-required="true" placeholder="Введите пароль" />
                <span asp-validation-for="Password" class="validation-error"></span>

                <div id="passwordHelp" class="hidden absolute right-0 top-0 mt-12 w-64 p-3 bg-white border rounded shadow text-xs text-gray-700 z-10">
                    <strong>Требования к паролю:</strong>
                    <ul class="mt-2 list-disc list-inside">
                        <li>Минимум 6 символов</li>
                        <li>До 100 символов</li>
                        <li>Хотя бы 1 заглавная буква</li>
                        <li>Хотя бы 1 строчная буква</li>
                        <li>Хотя бы 1 цифра</li>
                        <li>Хотя бы 1 специальный символ (не буква и не цифра)</li>
                    </ul>
                </div>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium mb-2">Подтвердите пароль</label>
                <input asp-for="ConfirmPassword" maxlength="100" minlength="6" class="auth-input w-full rounded-lg px-4 py-3"
                       autocomplete="new-password" aria-required="true" placeholder="Повторите пароль" />
                <span asp-validation-for="ConfirmPassword" class="validation-error"></span>
            </div>

            <div>
                <button type="submit" class="auth-btn-primary w-full py-3 rounded-lg font-semibold">Зарегистрироваться</button>
            </div>

            <div class="text-center space-y-2">
                <p class="text-sm">Уже есть аккаунт? <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-[var(--accent-gold)] hover:underline transition-colors">Войти</a></p>
                <p class="text-xs">Если вы не получили письмо с подтверждением, вы можете <a asp-controller="Account" asp-action="ResendEmailConfirmation" class="text-[var(--accent-gold)] hover:underline transition-colors">отправить его повторно</a>.</p>
            </div>
        </form>

    </div>
</div>

<style>
    /* Общий фон для кнопок социальных сетей */
    .social-btn-bg {
        background-color: var(--bg-secondary) !important;
        border: 1px solid var(--border-color) !important;
    }

    /* Стили для иконки Яндекс */
    .yandex-icon {
        color: var(--yandex-bg);
    }

    /* Светлая тема - круг #2D3748, буква золотая */
    body:not(.dark-theme) .yandex-circle {
        fill: #2D3748;
    }

    body:not(.dark-theme) .yandex-text {
        fill: var(--accent-gold);
    }

    /* Темная тема - круг белый, буква золотая */
    body.dark-theme .yandex-circle {
        fill: #FFFFFF;
    }

    body.dark-theme .yandex-text {
        fill: var(--accent-gold);
    }

    /* Стили для инициалов провайдеров */
    .provider-initial {
        color: var(--text-primary);
        font-weight: bold;
    }

    /* Убедимся, что весь текст внутри white-block хорошо виден */
    .white-block,
    .white-block *:not(a):not(button) {
        color: var(--auth-block-text) !important;
    }

        /* Ссылки оставляем золотыми */
        .white-block a {
            color: var(--accent-gold) !important;
        }

    /* Стили для полей ввода */
    .auth-input {
        background-color: var(--bg-secondary) !important;
        border: 1px solid var(--border-color) !important;
        color: var(--text-primary) !important;
        transition: all 0.3s ease;
    }

        /* Обеспечиваем читаемость текста во всех состояниях */
        .auth-input:focus,
        .auth-input:not(:focus),
        .auth-input:hover {
            color: var(--text-primary) !important;
            background-color: var(--bg-secondary) !important;
        }

        .auth-input:focus {
            border-color: var(--accent-gold) !important;
            box-shadow: 0 0 0 2px rgba(var(--accent-gold-rgb), 0.2) !important;
            outline: none !important;
        }

        .auth-input::placeholder {
            color: var(--text-secondary) !important;
            opacity: 0.7 !important;
        }

        /* Стили для автозаполнения браузера */
        .auth-input:-webkit-autofill,
        .auth-input:-webkit-autofill:hover,
        .auth-input:-webkit-autofill:focus,
        .auth-input:-webkit-autofill:active {
            -webkit-text-fill-color: var(--text-primary) !important;
            -webkit-box-shadow: 0 0 0px 1000px var(--bg-secondary) inset !important;
            border: 1px solid var(--border-color) !important;
            transition: background-color 5000s ease-in-out 0s;
        }

    /* Стили для кнопок */
    .auth-btn-primary {
        background: var(--accent-gold) !important;
        color: var(--bg-dark) !important;
        border: none !important;
        transition: all 0.3s ease;
    }

        .auth-btn-primary:hover {
            background: var(--accent-light) !important;
            transform: translateY(-1px);
        }

    /* Стили для ошибок валидации */
    .validation-error {
        color: #dc2626 !important;
        font-size: 0.75rem;
        margin-top: 0.25rem;
        display: block;
    }

    .field-validation-error {
        color: #dc2626 !important;
        font-size: 0.75rem;
    }

    /* Убираем тени и лишние рамки у кнопок соцсетей */
    .external-login-btn {
        box-shadow: none !important;
        text-decoration: none !important;
    }

    /* Гарантируем читаемость текста в полях ввода при любых условиях */
    input[type="email"],
    input[type="password"],
    input[type="text"] {
        color: var(--text-primary) !important;
        background-color: var(--bg-secondary) !important;
    }

    /* Усиленные стили для гарантии читаемости */
    .auth-input:not(:placeholder-shown) {
        color: var(--text-primary) !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            var email = document.getElementById('emailInput');
            var user = document.getElementById('UserName');
            if (!email) return;
            if (!user) user = document.querySelector('[name="UserName"]');
            email.addEventListener('input', function () {
                try {
                    if (!user) return;
                    if (user.value && user.value.trim().length > 0) return; // don't overwrite if user typed login
                    var v = email.value || '';
                    var idx = v.indexOf('@@');
                    if (idx > 0) user.value = v.substring(0, idx);
                } catch (e) { /* ignore */ }
            });

            var pwd = document.getElementById('passwordInput');
            var help = document.getElementById('passwordHelp');
            if (pwd && help) {
                pwd.addEventListener('mouseenter', function () { help.classList.remove('hidden'); });
                pwd.addEventListener('focus', function () { help.classList.remove('hidden'); });
                pwd.addEventListener('mouseleave', function () { help.classList.add('hidden'); });
                pwd.addEventListener('blur', function () { help.classList.add('hidden'); });
            }

            // Дополнительный скрипт для гарантии читаемости текста в полях ввода
            document.addEventListener('DOMContentLoaded', function() {
                // Принудительно устанавливаем стили для всех полей ввода
                const inputs = document.querySelectorAll('.auth-input');
                inputs.forEach(input => {
                    // Устанавливаем стили при загрузке
                    input.style.color = 'var(--text-primary)';
                    input.style.backgroundColor = 'var(--bg-secondary)';

                    // Устанавливаем стили при изменении фокуса
                    input.addEventListener('blur', function() {
                        this.style.color = 'var(--text-primary)';
                        this.style.backgroundColor = 'var(--bg-secondary)';
                    });

                    input.addEventListener('focus', function() {
                        this.style.color = 'var(--text-primary)';
                        this.style.backgroundColor = 'var(--bg-secondary)';
                    });
                });
            });
        })();
    </script>
}