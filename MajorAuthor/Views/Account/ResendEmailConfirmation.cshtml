@model MajorAuthor.Models.ResendEmailConfirmationViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Повторное подтверждение Email";
}

<div class="min-h-screen custom-bg flex items-start sm:items-center justify-center py-8 px-4">
    <div class="w-full max-w-md p-6 rounded-2xl white-block border shadow-xl card" style="background:#fff;">
        <header class="text-center mb-4">
            <h1 class="text-3xl sm:text-4xl font-extrabold gold-accent">@ViewData["Title"]</h1>
        </header>

        <p class="text-sm text-themed-label text-center mb-6 text-black">Введите ваш адрес электронной почты, чтобы получить новое письмо для подтверждения аккаунта.</p>

        <form method="post" asp-controller="Account" asp-action="ResendEmailConfirmation">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-red-600 font-bold mb-4" role="alert"></div>

            @if (!string.IsNullOrEmpty(ViewBag.StatusMessage))
            {
                <div class="alert @((string)ViewBag.StatusMessageType == "success" ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700") p-3 rounded-md mb-4" role="alert">
                    @ViewBag.StatusMessage
                </div>
            }

            <div class="mb-4">
                <label asp-for="Email" class="block text-sm font-medium text-themed-label text-black">Почта</label>
                <input asp-for="Email" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-accent-gold focus:ring-accent-gold dark:bg-gray-700 dark:text-gray-100" autocomplete="email" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="text-red-600 text-xs mt-1 block"></span>
            </div>

            <div>
                <button type="submit" class="btn-primary w-full py-3 rounded-full">Отправить письмо с подтверждением</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
