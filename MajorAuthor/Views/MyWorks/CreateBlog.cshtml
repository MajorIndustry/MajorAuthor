@model MajorAuthor.Models.CreateBlogModel
@{
    ViewData["Title"] = "Создать блог";
}

<div class="min-h-screen custom-bg flex items-start sm:items-center justify-center py-10 px-4">
    <div class="w-full max-w-3xl white-block p-6 sm:p-8 lg:p-10">
        <header class="mb-5 text-center">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold gold-accent tracking-tight">Создать новый блог</h1>
        </header>

        <form asp-action="CreateBlog" method="post" enctype="multipart/form-data" class="space-y-4">
            <div>
                <label asp-for="Title" class="block text-sm font-medium label-dark mb-2">Название <span class="text-red-400">*</span></label>
                <input asp-for="Title"
                       id="title"
                       class="w-full rounded-lg py-3 px-4 border input-dark focus:outline-none focus:ring-4 focus:ring-yellow-300/30 focus:border-yellow-400 transition-shadow shadow-sm"
                       placeholder="Заголовок вашего блога"
                       minlength="3" maxlength="200" required />
                <div class="mt-1 flex items-center justify-between">
                    <span asp-validation-for="Title" class="text-red-400 text-xs"></span>
                    <span><span class="char-count-black title-char-count">0</span> / 200</span>
                </div>
            </div>

            <div>
                <label asp-for="Photo" class="block text-sm font-medium label-dark mb-2">Изображение (опционально)</label>
                <div class="flex items-center gap-3">
                    <label class="file-btn" for="photoInput">Выбрать файл</label>
                    <span class="text-sm text-gray-600 file-name" id="fileName">Файл не выбран</span>
                </div>
                <input asp-for="Photo" id="photoInput" type="file" class="file-input" accept=".jpg,.jpeg,.png,.gif,.webp,image/*" />
                <span asp-validation-for="Photo" class="text-red-400 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Content" class="block text-sm font-medium label-dark mb-2">Содержимое <span class="text-red-400">*</span></label>
                <textarea asp-for="Content"
                          id="content"
                          rows="12"
                          class="w-full rounded-lg py-4 px-4 border input-dark leading-relaxed focus:outline-none focus:ring-4 focus:ring-yellow-300/30 focus:border-yellow-400 transition-shadow resize-vertical content-min"
                          placeholder="Начните писать здесь..."
                          minlength="10" maxlength="20000" required></textarea>
                <div class="mt-1 flex items-center justify-between">
                    <span asp-validation-for="Content" class="text-red-400 text-xs"></span>
                    <span><span class="char-count-black content-char-count">0</span> / 20000</span>
                </div>
            </div>

            <div class="pt-4 flex flex-col sm:flex-row-reverse sm:items-center gap-3">
                <button type="submit"
                        class="w-full sm:w-auto inline-flex justify-center items-center bg-yellow-400 hover:bg-yellow-300 text-gray-900 font-semibold py-3 px-6 rounded-full transition transform hover:scale-[1.01] shadow-lg focus:outline-none focus:ring-4 focus:ring-yellow-300/40">
                    Опубликовать блог
                </button>

                <a asp-action="Index" class="w-full sm:w-auto text-center py-3 px-6 rounded-full font-semibold gold-accent hover:text-yellow-500 transition border border-transparent hover:border-yellow-700">
                    Вернуться к списку произведений
                </a>
            </div>

            <p class="text-xs text-gray-500 mt-1">Поля, отмеченные <span class="text-red-400">*</span>, обязательны.</p>
        </form>
    </div>
</div>
<style>
    .white-block .label-dark,
    .white-block .char-count-black {
        color: var(--auth-block-text) !important;
    }
</style>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const titleInput = document.getElementById('title');
            const contentTextarea = document.getElementById('content');
            const titleCount = document.querySelector('.title-char-count');
            const contentCount = document.querySelector('.content-char-count');

            const fileInput = document.getElementById('photoInput');
            const fileName = document.getElementById('fileName');
            const fileBtn = document.querySelector('.file-btn');

            function updateCount(inputElement, countElement) {
                if (!inputElement || !countElement) return;
                const len = inputElement.value.length;
                countElement.textContent = len;
                const max = inputElement.getAttribute('maxlength');
                if (max && len > parseInt(max)) {
                    countElement.classList.add('text-red-400');
                } else {
                    countElement.classList.remove('text-red-400');
                }
            }

            if (titleInput && titleCount) {
                titleInput.addEventListener('input', () => updateCount(titleInput, titleCount));
                updateCount(titleInput, titleCount);
            }

            if (contentTextarea && contentCount) {
                contentTextarea.addEventListener('input', () => updateCount(contentTextarea, contentCount));
                updateCount(contentTextarea, contentCount);
            }

            if (fileBtn && fileInput && fileName) {
                fileBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    fileInput.click();
                });
                fileInput.addEventListener('change', () => {
                    const file = fileInput.files && fileInput.files[0];
                    fileName.textContent = file ? file.name : 'Файл не выбран';
                });
            }
        });
    </script>
}
