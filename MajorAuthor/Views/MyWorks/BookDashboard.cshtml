        function previewCover(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('cover-preview');
                    if (preview.tagName === 'IMG') {
                        preview.src = e.target.result;
                    } else {
                        const newPreview = document.createElement('img');
                        newPreview.id = 'cover-preview';
                        newPreview.src = e.target.result;
                        newPreview.className = 'mx-auto mb-4 w-full max-w-xs h-64 object-cover rounded-xl shadow-lg';
                        preview.parentNode.replaceChild(newPreview, preview);
                    }

                    // Сбрасываем флаг удаления обложки при загрузке новой
                    document.getElementById('RemoveCover').value = 'false';

                    // Показываем кнопку удаления, если она была скрыта
                    const removeButton = document.querySelector('button[onclick="removeCover()"]');
                    if (removeButton) {
                        removeButton.style.display = 'block';
                    }
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

