@model BookDashboardViewModel
@{
    ViewData["Title"] = $"Управление книгой - {Model.Title}";
}

<div class="container mx-auto px-4 py-6 max-w-7xl">
    <!-- Заголовок и навигация -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <div class="flex items-center gap-4">
            @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
            {
                <img src="@Model.CoverImageUrl" alt="Обложка" class="w-16 h-20 object-cover rounded-lg shadow-md md:hidden">
            }
            <div>
                <!-- ЗОЛОТОЙ ШРИФТ ДЛЯ НАЗВАНИЯ КНИГИ -->
                <h1 class="text-2xl md:text-3xl font-bold text-gold">@Model.Title</h1>
                <p class="text-secondary-custom mt-1">@Model.WorkType • @Model.Status</p>
            </div>
        </div>
        <div class="flex gap-3 w-full md:w-auto">
            <a href="@Url.Action("Read", "Books", new { id = Model.Id })"
               class="gold-button flex-1 md:flex-none text-center">
                <i class="fas fa-eye mr-2"></i>Читать
            </a>
            <button class="auth-btn-secondary flex-1 md:flex-none text-center" onclick="saveChanges()">
                <i class="fas fa-save mr-2"></i>Сохранить
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Основной контент -->
        <div class="lg:col-span-3 space-y-6">
            <!-- Вкладки -->
            <div class="border-b border-[var(--border-color)] mb-6">
                <nav class="flex space-x-2 md:space-x-8 overflow-x-auto pb-2 -mb-2 scrollbar-hide">
                    <button class="tab-button active whitespace-nowrap" data-tab="settings">Основные настройки</button>
                    <button class="tab-button whitespace-nowrap" data-tab="chapters">Главы</button>
                    <button class="tab-button whitespace-nowrap" data-tab="tags">Теги и метаданные</button>
                    <button class="tab-button whitespace-nowrap" data-tab="statistics">Статистика</button>
                </nav>
            </div>

            <!-- Вкладка Основные настройки -->
            <div id="settings-tab" class="tab-content active space-y-6">
                <form id="mainForm" asp-action="BookDashboard" method="post" enctype="multipart/form-data" class="space-y-6">
                    <input type="hidden" asp-for="Id" />
                    <!-- Скрытые поля для логики -->
                    <input type="hidden" id="IsPublic" name="IsPublic" value="@Model.IsPublic.ToString().ToLower()" />
                    <input type="hidden" id="selectedGenresInput" name="Genre" value="@Model.Genre" />
                    <input type="hidden" id="selectedTagsInput" name="TagsString" value="@Model.TagsString" />

                    <input type="hidden" asp-for="AuthorId" />
                    <input type="hidden" asp-for="AuthorName" />
                    <input type="hidden" asp-for="CurrentAuthorName" />
                    <input type="hidden" asp-for="CurrentAuthorId" />

                    <!-- Скрытые поля для Status и WorkType -->
                    <input type="hidden" asp-for="Status" id="statusHidden" />
                    <input type="hidden" asp-for="WorkType" id="workTypeHidden" />

                    <!-- ВАЖНО: Скрытые поля для чекбоксов. Значения обновляются JS перед отправкой -->
                    <input type="hidden" id="hiddenIsAdultContent" name="IsAdultContent" value="@Model.IsAdultContent.ToString().ToLower()" />
                    <input type="hidden" id="hiddenEnableTTS" name="EnableTTS" value="@Model.EnableTTS.ToString().ToLower()" />
                    <input type="hidden" id="hiddenAllowDownload" name="AllowDownload" value="@Model.AllowDownload.ToString().ToLower()" />

                    <!-- ДОБАВЛЕНО: Скрытое поле для удаления обложки -->
                    <input type="hidden" id="RemoveCover" name="RemoveCover" value="false" />

                    <!-- Основная информация -->
                    <div class="white-block" style="overflow: visible !important;">
                        <h3 class="text-xl font-semibold mb-6 gradient-text">Основная информация</h3>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label for="Title" class="block text-sm font-medium text-primary-label">Название</label>
                                <input asp-for="Title" id="Title" class="w-full input-dark rounded-xl px-4 py-3" />
                                <div class="flex justify-between text-sm">
                                    <span asp-validation-for="Title" class="text-red-500"></span>
                                    <span class="char-count">@Model.Title.Length/150</span>
                                </div>
                            </div>

                            <div class="space-y-2">
                                <label for="TypeId" class="block text-sm font-medium text-primary-label">Тип произведения</label>
                                <select asp-for="TypeId" id="TypeId" class="w-full input-dark rounded-xl px-4 py-3" id="typeSelect">
                                    <option value="">Выберите тип</option>
                                    @foreach (var type in Model.AllTypes)
                                    {
                                        <option value="@type.Id" selected="@(type.Id == Model.TypeId)">@type.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="TypeId" class="text-red-500 text-sm"></span>
                            </div>
                        </div>

                        <!-- Статус и Цикл -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                            <div class="space-y-2">
                                <label for="statusSelect" class="block text-sm font-medium text-primary-label">Статус</label>
                                <select asp-for="Status" id="statusSelect" class="w-full input-dark rounded-xl px-4 py-3">
                                    @foreach (var status in Model.AllStatuses)
                                    {
                                        <option value="@status.Value" selected="@(status.Value == Model.Status)">@status.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="Status" class="text-red-500 text-sm"></span>
                            </div>

                            <div class="space-y-2">
                                <label for="CycleId" class="block text-sm font-medium text-primary-label">Цикл</label>
                                <div class="flex gap-2">
                                    <select asp-for="CycleId" id="CycleId" class="w-full input-dark rounded-xl px-4 py-3">
                                        <option value="">Без цикла</option>
                                        @foreach (var cycle in Model.AllCycles)
                                        {
                                            <option value="@cycle.Id" selected="@(cycle.Id == Model.CycleId)">@cycle.Name</option>
                                        }
                                    </select>
                                    <button type="button" onclick="showCreateCycleModal()"
                                            class="gold-button px-4 py-3 rounded-xl whitespace-nowrap">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Жанры с выпадающим списком как у статусов -->
                        <div class="mt-6">
                            <label for="genreSelect" class="block text-sm font-medium text-primary-label mb-3">Жанры</label>
                            <div class="relative">
                                <select id="genreSelect" class="w-full input-dark rounded-xl px-4 py-3 appearance-none cursor-pointer">
                                    <option value="">Выберите жанр...</option>
                                    @foreach (var genre in Model.AllGenres)
                                    {
                                        <option value="@genre.Name">@genre.Name</option>
                                    }
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700 dark:text-gray-300">
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>
                            <div class="flex flex-wrap gap-2 mt-3" id="selectedGenres">
                                @if (!string.IsNullOrEmpty(Model.Genre))
                                {
                                    foreach (var genre in Model.Genre.Split(',').Select(g => g.Trim()))
                                    {
                                        if (!string.IsNullOrEmpty(genre))
                                        {
                                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200">
                                                @genre
                                                <button type="button" onclick="removeSelectedGenre('@genre')" class="ml-2 hover:text-blue-600">×</button>
                                            </span>
                                        }
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Аннотация -->
                    <div class="white-block">
                        <h3 class="text-xl font-semibold mb-6 gradient-text">Аннотация</h3>
                        <textarea asp-for="Description" id="Description" rows="6"
                                  class="w-full input-dark rounded-xl px-4 py-3 resize-none"
                                  placeholder="Опишите ваше произведение..."></textarea>
                        <div class="flex justify-between text-sm mt-2">
                            <span class="text-secondary-custom">Расскажите читателям о вашей книге</span>
                            <span class="char-count">@(Model.Description?.Length ?? 0)/2000</span>
                        </div>
                        <span asp-validation-for="Description" class="text-red-500 text-sm"></span>
                    </div>

                    <!-- Соавторы -->
                    <div class="white-block" style="overflow: visible !important;">
                        <h3 class="text-xl font-semibold mb-6 gradient-text">Соавторы</h3>

                        <div class="space-y-3 mb-6" id="coAuthorsList">
                            @foreach (var coAuthor in Model.CoAuthors)
                            {
                                <div class="flex justify-between items-center p-4 bg-[var(--border-color)] rounded-xl">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 bg-[var(--accent-gold)] rounded-full flex items-center justify-center text-white font-semibold">
                                            @coAuthor.PenName[0]
                                        </div>
                                        <div>
                                            <div class="font-medium text-gold">@coAuthor.PenName</div>
                                            <div class="text-sm email-inverse">@coAuthor.Email</div>
                                        </div>
                                    </div>
                                    <button type="button"
                                            onclick="removeCoAuthor(@Model.Id, @coAuthor.Id)"
                                            class="text-red-500 hover:text-red-700 p-2 rounded-lg hover:bg-red-50 transition-colors">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </div>
                            }
                        </div>

                        <div class="autocomplete-wrapper">
                            <label for="newCoAuthorEmail" class="block text-sm font-medium mb-2 text-primary-label">Добавить соавтора</label>
                            <input type="email" id="newCoAuthorEmail"
                                   class="w-full input-dark rounded-xl px-4 py-3 border focus:ring-2 focus:ring-[var(--accent-gold)] focus:ring-opacity-20 transition-all duration-200"
                                   placeholder="Введите email пользователя"
                                   autocomplete="off" />
                            <ul id="emailSuggestions" class="autocomplete-dropdown"></ul>
                            <div class="text-xs text-secondary-custom mt-2">
                                Начните вводить email для поиска пользователей
                            </div>
                        </div>

                        <button type="button" onclick="addCoAuthor(@Model.Id)"
                                class="auth-btn-secondary mt-4 w-full md:w-auto px-6 py-3 rounded-xl">
                            <i class="fas fa-user-plus mr-2"></i>Добавить соавтора
                        </button>
                    </div>

                    <!-- Настройки публикации -->
                    <div class="white-block">
                        <h3 class="text-xl font-semibold mb-6 gradient-text">Публикация</h3>

                        <div class="flex items-center justify-between p-4 bg-[var(--border-color)] rounded-xl">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center text-green-600">
                                    <i class="fas fa-globe"></i>
                                </div>
                                <div>
                                    <div class="font-medium text-status-label">Статус публикации</div>
                                    <div class="text-sm text-secondary-custom" id="publicationStatusText">
                                        @(Model.IsPublic ? "Опубликовано" : "Черновик")
                                    </div>
                                </div>
                            </div>
                            <button type="button" id="togglePublicationBtn"
                                    class="@(Model.IsPublic ? "auth-btn-secondary bg-red-500 hover:bg-red-600 text-white" : "gold-button") px-6 py-3 rounded-xl">
                                @(Model.IsPublic ? "Снять с публикации" : "Опубликовать")
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Вкладка Главы -->
            <div id="chapters-tab" class="tab-content">
                <div class="white-block">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
                        <h3 class="text-xl font-semibold gradient-text">Главы произведения</h3>
                        <a asp-controller="MyWorks" asp-action="EditChapterCollaborative" asp-route-bookId="@Model.Id" class="gold-button px-6 py-3 rounded-xl">
                            <i class="fas fa-plus mr-2"></i>Добавить главу
                        </a>
                    </div>
                    <div class="space-y-4" id="chaptersList">
                        @foreach (var chapter in Model.Chapters.OrderBy(c => c.Order))
                        {
                            <div class="chapter-item flex items-center justify-between p-4 bg-[var(--border-color)] rounded-xl hover:bg-opacity-50 transition-colors" data-chapter-id="@chapter.Id">
                                <div class="flex items-center gap-4">
                                    <!-- Порядковый номер и кнопки перемещения -->
                                    <div class="flex flex-col items-center gap-1">
                                        <button class="move-up-btn text-gray-400 hover:text-[var(--accent-gold)] transition-colors" @(chapter.Order == 1 ? "disabled" : "")>
                                            <i class="fas fa-chevron-up"></i>
                                        </button>
                                        <div class="w-10 h-10 bg-[var(--accent-gold)] bg-opacity-20 rounded-lg flex items-center justify-center text-primary-label font-semibold">
                                            @chapter.Order
                                        </div>
                                        <button class="move-down-btn text-gray-400 hover:text-[var(--accent-gold)] transition-colors" @(chapter.Order == Model.Chapters.Count ? "disabled" : "")>
                                            <i class="fas fa-chevron-down"></i>
                                        </button>
                                    </div>
                                    <div>
                                        <div class="font-medium email-inverse">@chapter.Title</div>
                                        <div class="text-sm text-secondary-custom flex gap-4">
                                            <span>@chapter.CharacterCount зн.</span>
                                            <span>@chapter.PublicationDate.ToString("dd.MM.yyyy")</span>
                                            <span class="js-status-text flex items-center gap-1">
                                                <i class="fas @(chapter.IsPublic ? "fa-eye text-green-500" : "fa-eye-slash text-gray-500")"></i>
                                                @(chapter.IsPublic ? "Опубликована" : "Черновик")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex gap-2">
                                    <!-- Кнопка редактирования -->
                                    <a asp-controller="MyWorks" asp-action="EditChapterCollaborative" asp-route-bookId="@Model.Id" asp-route-chapterId="@chapter.Id" class="p-2 text-secondary-custom hover:text-[var(--accent-gold)] transition-colors">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <!-- Кнопка переключения публикации -->
                                    <button class="toggle-publish-btn p-2 text-secondary-custom hover:text-green-500 transition-colors" data-is-public="@chapter.IsPublic.ToString().ToLower()">
                                        <i class="fas @(chapter.IsPublic ? "fa-eye-slash" : "fa-eye")"></i>
                                    </button>
                                    <!-- Кнопка удаления -->
                                    <button class="delete-chapter-btn p-2 text-secondary-custom hover:text-red-500 transition-colors">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Вкладка Теги и метаданные -->
            <div id="tags-tab" class="tab-content">
                <div class="white-block" style="overflow: visible !important;">
                    <h3 class="text-xl font-semibold mb-6 gradient-text">Теги произведения</h3>

                    <div class="flex flex-wrap gap-3 mb-6" id="tagsContainer">
                        @foreach (var tag in Model.Tags)
                        {
                            <span class="inline-flex items-center px-4 py-2 rounded-full text-sm bg-gradient-to-r from-[var(--accent-gold)] to-[var(--accent-light)] text-white font-medium shadow-lg">
                                #@tag.TrimStart('#')
                                <button type="button" onclick="removeSelectedTag('@tag')" class="ml-2 hover:text-yellow-200 transition-colors">×</button>
                            </span>
                        }
                    </div>

                    <div class="autocomplete-wrapper">
                        <label for="tagSearch" class="block text-sm font-medium mb-2 text-primary-label">Добавить тег</label>
                        <input type="text" id="tagSearch"
                               class="w-full input-dark rounded-xl px-4 py-3 border focus:ring-2 focus:ring-[var(--accent-gold)] focus:ring-opacity-20 transition-all duration-200"
                               placeholder="Начните вводить тег..."
                               autocomplete="off" />
                        <ul id="tagSuggestions" class="autocomplete-dropdown"></ul>
                        <div class="text-xs text-secondary-custom mt-2">
                            Теги помогают читателям найти ваше произведение.
                        </div>
                    </div>
                </div>

                <!-- Дополнительные настройки -->
                <div class="white-block mt-6">
                    <h3 class="text-xl font-semibold mb-6 gradient-text">Дополнительные настройки</h3>

                    <div class="space-y-4">
                        <!-- КОНТЕНТ 18+ С ЗОЛОТЫМ ЦВЕТОМ -->
                        <div class="flex items-center justify-between p-4 bg-[var(--border-color)] rounded-xl">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center text-red-600">
                                    <i class="fas fa-exclamation-triangle"></i>
                                </div>
                                <div>
                                    <div class="font-medium text-gold">Контент 18+</div>
                                    <div class="text-sm text-secondary-custom">Отметка для взрослого контента</div>
                                </div>
                            </div>
                            <label for="chkAdult" class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" id="chkAdult"
                                       @(Model.IsAdultContent ? "checked" : "")
                                       class="sr-only peer">
                                <div class="w-11 h-6 bg-gray-200 peer-focus:ring-4 peer-focus:ring-[var(--accent-gold)] peer-focus:ring-opacity-20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--accent-gold)]"></div>
                            </label>
                        </div>

                        <!-- ОЗВУЧКА (TTS) С ЦВЕТОМ КАК У EMAIL -->
                        <div class="flex items-center justify-between p-4 bg-[var(--border-color)] rounded-xl">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center text-blue-600">
                                    <i class="fas fa-headphones"></i>
                                </div>
                                <div>
                                    <div class="font-medium email-inverse">Озвучка (TTS)</div>
                                    <div class="text-sm text-secondary-custom">Включить текстовое озвучивание</div>
                                </div>
                            </div>
                            <label for="chkTTS" class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" id="chkTTS"
                                       @(Model.EnableTTS ? "checked" : "")
                                       class="sr-only peer">
                                <div class="w-11 h-6 bg-gray-200 peer-focus:ring-4 peer-focus:ring-[var(--accent-gold)] peer-focus:ring-opacity-20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--accent-gold)]"></div>
                            </label>
                        </div>

                        <!-- РАЗРЕШИТЬ СКАЧИВАНИЕ С ЦВЕТОМ КАК У EMAIL -->
                        <div class="flex items-center justify-between p-4 bg-[var(--border-color)] rounded-xl">
                            <div class="flex items-center gap-3">
                                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center text-green-600">
                                    <i class="fas fa-download"></i>
                                </div>
                                <div>
                                    <div class="font-medium email-inverse">Разрешить скачивание</div>
                                    <div class="text-sm text-secondary-custom">Позволить читателям скачивать книгу</div>
                                </div>
                            </div>
                            <label for="chkDownload" class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" id="chkDownload"
                                       @(Model.AllowDownload ? "checked" : "")
                                       class="sr-only peer">
                                <div class="w-11 h-6 bg-gray-200 peer-focus:ring-4 peer-focus:ring-[var(--accent-gold)] peer-focus:ring-opacity-20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--accent-gold)]"></div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- НОВАЯ ВКЛАДКА: СТАТИСТИКА -->
            <div id="statistics-tab" class="tab-content">
                <div class="white-block">
                    <h3 class="text-xl font-semibold mb-6 gradient-text">Детальная статистика</h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <!-- Основная статистика -->
                        <div class="space-y-4">
                            <h4 class="text-lg font-semibold text-primary-label mb-4">Основные показатели</h4>
                            <div class="flex justify-between items-center p-4 bg-[var(--border-color)] rounded-xl">
                                <span class="text-sm text-gold flex items-center">
                                    <i class="fas fa-eye mr-2"></i>Всего просмотров
                                </span>
                                <span class="font-semibold text-gold text-xl">@Model.ViewsCount</span>
                            </div>
                            <div class="flex justify-between items-center p-4 bg-[var(--border-color)] rounded-xl">
                                <span class="text-sm text-gold flex items-center">
                                    <i class="fas fa-heart mr-2"></i>Всего лайков
                                </span>
                                <span class="font-semibold text-gold text-xl">@Model.LikesCount</span>
                            </div>
                            <div class="flex justify-between items-center p-4 bg-[var(--border-color)] rounded-xl">
                                <span class="text-sm text-gold flex items-center">
                                    <i class="fas fa-font mr-2"></i>Размер книги
                                </span>
                                <span class="font-semibold text-gold text-xl">@Model.TotalCharacters зн.</span>
                            </div>
                        </div>

                        <!-- Статистика по времени -->
                        <div class="space-y-4">
                            <h4 class="text-lg font-semibold text-primary-label mb-4">Активность по годам</h4>
                            @if (Model.YearlyStats != null && Model.YearlyStats.Any())
                            {
                                foreach (var yearStat in Model.YearlyStats.OrderByDescending(y => y.Year))
                                {
                                    <div class="flex justify-between items-center p-4 bg-[var(--border-color)] rounded-xl">
                                        <span class="text-sm text-gold">@yearStat.Year год</span>
                                        <div class="text-right">
                                            <div class="font-semibold text-gold">@yearStat.Views просмотров</div>
                                            <div class="text-sm text-secondary-custom">@yearStat.Likes лайков</div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center p-4 bg-[var(--border-color)] rounded-xl">
                                    <span class="text-secondary-custom">Статистика по годам пока недоступна</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Детальная статистика по главам -->
                    <div class="mt-8">
                        <h4 class="text-lg font-semibold text-primary-label mb-4">Статистика по главам</h4>
                        <div class="space-y-3">
                            @foreach (var chapter in Model.Chapters.OrderBy(c => c.Order))
                            {
                                <div class="flex justify-between items-center p-4 bg-[var(--border-color)] rounded-xl">
                                    <div>
                                        <div class="font-medium text-primary-label">@chapter.Title</div>
                                        <div class="text-sm text-secondary-custom">@chapter.CharacterCount зн. • @chapter.PublicationDate.ToString("dd.MM.yyyy")</div>
                                    </div>
                                    <div class="text-right">
                                        <div class="text-sm text-gold">@(chapter.IsPublic ? "Опубликована" : "Черновик")</div>
                                        <div class="text-xs text-secondary-custom">Глава @chapter.Order</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Боковая панель -->
        <div class="space-y-6">
            <!-- Обложка -->
            <div class="white-block">
                <h3 class="text-lg font-semibold mb-4 text-primary-label">Обложка</h3>
                <div class="text-center">
                    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                    {
                        <img id="cover-preview" src="@Model.CoverImageUrl" alt="Обложка"
                             class="mx-auto mb-4 w-full max-w-xs h-64 object-cover rounded-xl shadow-lg" />
                    }
                    else
                    {
                        <div id="cover-preview" class="w-full h-64 bg-gradient-to-br from-[var(--border-color)] to-gray-300 rounded-xl flex items-center justify-center mb-4">
                            <i class="fas fa-book text-6xl text-secondary-custom opacity-50"></i>
                        </div>
                    }

                    <label for="CoverImage" class="file-btn cursor-pointer inline-flex items-center gap-2 px-6 py-3 rounded-xl w-full justify-center mb-2">
                        <i class="fas fa-upload"></i>
                        <span>Изменить</span>
                        <input type="file" id="CoverImage" form="mainForm" name="CoverImage" class="file-input" accept="image/*" onchange="previewCover(this)" />
                    </label>

                    <!-- КНОПКА УДАЛЕНИЯ ОБЛОЖКИ -->
                    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                    {
                        <button type="button" onclick="removeCover()"
                                class="auth-btn-secondary text-red-600 hover:bg-red-600 hover:text-white w-full justify-center gap-2 py-3 rounded-xl transition-colors">
                            <i class="fas fa-trash"></i> Удалить обложку
                        </button>
                    }
                </div>
            </div>

            <!-- Краткая статистика -->
            <div class="white-block">
                <h3 class="text-lg font-semibold mb-4 text-primary-label">Краткая статистика</h3>
                <div class="space-y-4">
                    <div class="flex justify-between items-center p-3 bg-[var(--border-color)] rounded-lg">
                        <span class="text-sm text-gold flex items-center">
                            <i class="fas fa-eye mr-2"></i>Просмотры
                        </span>
                        <span class="font-semibold text-gold">@Model.ViewsCount</span>
                    </div>
                    <div class="flex justify-between items-center p-3 bg-[var(--border-color)] rounded-lg">
                        <span class="text-sm text-gold flex items-center">
                            <i class="fas fa-heart mr-2"></i>Лайки
                        </span>
                        <span class="font-semibold text-gold">@Model.LikesCount</span>
                    </div>
                    <div class="flex justify-between items-center p-3 bg-[var(--border-color)] rounded-lg">
                        <span class="text-sm text-gold flex items-center">
                            <i class="fas fa-font mr-2"></i>Размер
                        </span>
                        <span class="font-semibold text-gold">@Model.TotalCharacters зн.</span>
                    </div>
                    <div class="flex justify-between items-center p-3 bg-[var(--border-color)] rounded-lg">
                        <span class="text-sm text-gold flex items-center">
                            <i class="fas fa-calendar-alt mr-2"></i>Последнее обновление
                        </span>
                        <span class="font-semibold text-sm text-gold">@Model.LastUpdate.ToString("dd.MM.yy")</span>
                    </div>
                </div>
            </div>

            <!-- ДЕЙСТВИЯ С ДОБАВЛЕННОЙ КНОПКОЙ "ПРОДВИГАТЬ" -->
            <div class="white-block">
                <h3 class="text-lg font-semibold mb-4 text-primary-label">Действия</h3>
                <div class="space-y-3">
                    <!-- КНОПКА ПРОДВИЖЕНИЯ -->
                    <button class="w-full auth-btn-secondary justify-center gap-2 py-3 rounded-xl bg-purple-600 hover:bg-purple-700 text-white transition-colors"
                            onclick="promoteBook(@Model.Id)">
                        <i class="fas fa-rocket mr-2"></i>
                        Продвигать
                    </button>

                    @if (Model.Status != "в процессе")
                    {
                        <button class="w-full auth-btn-secondary justify-center gap-2 py-3 rounded-xl"
                                onclick="updateStatus(@Model.Id, 'в процессе')">
                            <i class="fas fa-sync"></i>
                            В работу
                        </button>
                    }
                    <button class="w-full auth-btn-secondary text-red-600 justify-center gap-2 py-3 rounded-xl" onclick="deleteBook(@Model.Id)">
                        <i class="fas fa-trash"></i> Удалить
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно создания цикла -->
<div id="createCycleModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
    <div class="bg-white dark:bg-gray-800 rounded-xl p-6 w-full max-w-md mx-4">
        <h3 class="text-xl font-semibold mb-4 text-primary-label">Создать новый цикл</h3>
        <form id="createCycleForm">
            <div class="space-y-4">
                <div>
                    <label for="cycleName" class="block text-sm font-medium mb-2 text-primary-label">Название цикла</label>
                    <input type="text" id="cycleName" class="w-full input-dark rounded-xl px-4 py-3" required>
                </div>
            </div>
            <div class="flex gap-3 mt-6">
                <button type="button" onclick="hideCreateCycleModal()" class="auth-btn-secondary flex-1">Отмена</button>
                <button type="submit" class="gold-button flex-1">Создать</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Глобальные переменные
        let allGenres = [];
        let allTags = [];
        let selectedGenres = [];
        let selectedTags = [];

        // Инициализация при загрузке страницы
        document.addEventListener('DOMContentLoaded', function() {
            initializeTabs();
            initializeGenreSelect(); // Новая функция для выпадающего списка жанров
            initializeEmailAutocomplete();
            initializeTagAutocomplete();
            initializePublicationToggle();
            initializeCharacterCounters();
            loadSelectedGenres();
            loadSelectedTags();
            updateStatsDisplay();
            initializeFormUpdates();
        });

        function initializeTabs() {
            const tabButtons = document.querySelectorAll('.tab-button');
            const tabContents = document.querySelectorAll('.tab-content');

            tabButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const tabName = this.getAttribute('data-tab');
                    tabButtons.forEach(btn => btn.classList.remove('active'));
                    tabContents.forEach(content => content.classList.remove('active'));
                    this.classList.add('active');
                    document.getElementById(`${tabName}-tab`).classList.add('active');
                });
            });
        }

        function initializeFormUpdates() {
            // Обновление скрытого поля Status при изменении выпадающего списка
            const statusSelect = document.getElementById('statusSelect');
            if (statusSelect) {
                statusSelect.addEventListener('change', function() {
                    document.getElementById('statusHidden').value = this.value;
                });
            }

            // Обновление скрытого поля WorkType при изменении TypeId
            const typeSelect = document.getElementById('typeSelect');
            if (typeSelect) {
                typeSelect.addEventListener('change', function() {
                    const selectedOption = typeSelect.options[typeSelect.selectedIndex];
                    document.getElementById('workTypeHidden').value = selectedOption.text;
                });
            }
        }

        // Инициализация выбора жанров через выпадающий список
        function initializeGenreSelect() {
            const genreSelect = document.getElementById('genreSelect');
            if (!genreSelect) return;

            genreSelect.addEventListener('change', function() {
                const selectedGenre = this.value;
                if (selectedGenre && !selectedGenres.includes(selectedGenre)) {
                    selectedGenres.push(selectedGenre);
                    updateSelectedGenresDisplay();
                    updateHiddenGenresInput();
                    this.value = ''; // Сбрасываем выбор
                    showToast(`Жанр "${selectedGenre}" добавлен`, 'success');
                }
            });

            // Помечаем выбранные жанры в выпадающем списке
            updateGenreSelectOptions();
        }

        // Обновление опций в выпадающем списке жанров (отключаем выбранные)
        function updateGenreSelectOptions() {
            const genreSelect = document.getElementById('genreSelect');
            if (!genreSelect) return;

            const options = genreSelect.querySelectorAll('option');
            options.forEach(option => {
                if (option.value) {
                    if (selectedGenres.includes(option.value)) {
                        option.disabled = true;
                        if (!option.textContent.includes('(добавлен)')) {
                            option.textContent += ' (добавлен)';
                        }
                    } else {
                        option.disabled = false;
                        option.textContent = option.textContent.replace(' (добавлен)', '');
                    }
                }
            });
        }

        // Загрузка выбранных жанров
        function loadSelectedGenres() {
            const selectedGenresContainer = document.getElementById('selectedGenres');
            const genreSpans = selectedGenresContainer.querySelectorAll('span');
            selectedGenres = Array.from(genreSpans).map(span => {
                return span.textContent.replace('×', '').trim();
            });
        }

        // Загрузка выбранных тегов
        function loadSelectedTags() {
            const tagsContainer = document.getElementById('tagsContainer');
            const tagSpans = tagsContainer.querySelectorAll('span');
            selectedTags = Array.from(tagSpans).map(span => {
                return span.textContent.replace('×', '').trim();
            });
            updateHiddenTagsInput();
        }

        // Удаление выбранного жанра
        function removeSelectedGenre(genre) {
            selectedGenres = selectedGenres.filter(g => g !== genre);
            updateSelectedGenresDisplay();
            updateHiddenGenresInput();
        }

        // Удаление выбранного тега
        function removeSelectedTag(tag) {
            selectedTags = selectedTags.filter(t => t !== tag);
            updateSelectedTagsDisplay();
            updateHiddenTagsInput();
        }

        // Обновление отображения выбранных жанров
        function updateSelectedGenresDisplay() {
            const selectedGenresContainer = document.getElementById('selectedGenres');
            selectedGenresContainer.innerHTML = '';

            selectedGenres.forEach(genre => {
                const span = document.createElement('span');
                span.className = 'inline-flex items-center px-3 py-1 rounded-full text-sm bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200';
                span.innerHTML = `${genre} <button type="button" onclick="removeSelectedGenre('${genre}')" class="ml-2 hover:text-blue-600">×</button>`;
                selectedGenresContainer.appendChild(span);
            });

            updateGenreSelectOptions();
        }

        // Обновление отображения выбранных тегов
        function updateSelectedTagsDisplay() {
            const tagsContainer = document.getElementById('tagsContainer');
            tagsContainer.innerHTML = '';

            selectedTags.forEach(tag => {
                const span = document.createElement('span');
                span.className = 'inline-flex items-center px-4 py-2 rounded-full text-sm bg-gradient-to-r from-[var(--accent-gold)] to-[var(--accent-light)] text-white font-medium shadow-lg';
                span.innerHTML = `${tag} <button type="button" onclick="removeSelectedTag('${tag}')" class="ml-2 hover:text-yellow-200 transition-colors">×</button>`;
                tagsContainer.appendChild(span);
            });
        }

        // Обновление скрытого поля с жанрами
        function updateHiddenGenresInput() {
            document.getElementById('selectedGenresInput').value = selectedGenres.join(',');
        }

        // Обновление скрытого поля с тегами
        function updateHiddenTagsInput() {
            document.getElementById('selectedTagsInput').value = selectedTags.join(',');
        }

        function initializeCharacterCounters() {
            const descriptionTextarea = document.querySelector('textarea[name="Description"]');
            const descriptionCounter = descriptionTextarea?.parentElement.querySelector('.char-count');

            if (descriptionTextarea && descriptionCounter) {
                descriptionTextarea.addEventListener('input', function() {
                    const count = this.value.length;
                    descriptionCounter.textContent = `${count}/2000`;
                });
            }

            // Также добавим для названия
            const titleInput = document.querySelector('input[name="Title"]');
            const titleCounter = titleInput?.parentElement.querySelector('.char-count');

            if (titleInput && titleCounter) {
                titleInput.addEventListener('input', function() {
                    const count = this.value.length;
                    titleCounter.textContent = `${count}/150`;
                });
            }
        }

        // ФУНКЦИЯ ДЛЯ УДАЛЕНИЯ ОБЛОЖКИ
        function removeCover() {
            if (!confirm('Вы уверены, что хотите удалить обложку книги?')) {
                return;
            }

            // Устанавливаем флаг удаления обложки
            document.getElementById('RemoveCover').value = 'true';

            // Сбрасываем поле загрузки файла
            document.getElementById('CoverImage').value = '';

            // Обновляем превью
            const preview = document.getElementById('cover-preview');
            if (preview.tagName === 'IMG') {
                const newPreview = document.createElement('div');
                newPreview.id = 'cover-preview';
                newPreview.className = 'w-full h-64 bg-gradient-to-br from-[var(--border-color)] to-gray-300 rounded-xl flex items-center justify-center mb-4';
                newPreview.innerHTML = '<i class="fas fa-book text-6xl text-secondary-custom opacity-50"></i>';
                preview.parentNode.replaceChild(newPreview, preview);
            }

            // Скрываем кнопку удаления
            const removeButton = document.querySelector('button[onclick="removeCover()"]');
            if (removeButton) {
                removeButton.style.display = 'none';
            }

            showToast('Обложка будет удалена при сохранении изменений', 'success');
        }

        // ФУНКЦИЯ ДЛЯ ПРОДВИЖЕНИЯ КНИГИ
        async function promoteBook(bookId) {
            try {
                const response = await fetch('@Url.Action("PromoteBook", "MyWorks")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        bookId: bookId
                    })
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        showToast('Книга успешно добавлена в продвижение!', 'success');
                    } else {
                        showToast('Ошибка при продвижении книги: ' + result.message, 'error');
                    }
                } else {
                    showToast('Ошибка при продвижении книги', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('Ошибка при продвижении книги', 'error');
            }
        }

        // Автодополнение для тегов
        function initializeTagAutocomplete() {
            const tagInput = document.getElementById('tagSearch');
            const suggestionsList = document.getElementById('tagSuggestions');

            if (!tagInput || !suggestionsList) return;

            let debounceTimeout;
            let currentFocus = -1;

            // Загружаем теги из базы данных
            loadTags();

            tagInput.addEventListener('input', function() {
                clearTimeout(debounceTimeout);
                const query = this.value.trim();

                if (query.length < 1) {
                    suggestionsList.style.display = 'none';
                    return;
                }

                debounceTimeout = setTimeout(() => searchTags(query), 300);
            });

            tagInput.addEventListener('focus', function() {
                const query = this.value.trim();
                if (query.length >= 1) {
                    searchTags(query);
                }
            });

            tagInput.addEventListener('keydown', function(e) {
                const items = suggestionsList.querySelectorAll('li');

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    currentFocus = Math.min(currentFocus + 1, items.length - 1);
                    updateActiveItem(items, 'tag');
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    currentFocus = Math.max(currentFocus - 1, -1);
                    updateActiveItem(items, 'tag');
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (currentFocus > -1 && items[currentFocus]) {
                        selectTagItem(items[currentFocus]);
                    } else if (tagInput.value.trim()) {
                        addTagToSelection(tagInput.value.trim());
                    }
                } else if (e.key === 'Escape') {
                    suggestionsList.style.display = 'none';
                    currentFocus = -1;
                }
            });

            suggestionsList.addEventListener('mousedown', function(e) {
                e.preventDefault();
                const li = e.target.closest('li');
                if (li) {
                    selectTagItem(li);
                }
            });

            tagInput.addEventListener('blur', function() {
                setTimeout(() => {
                    if (!suggestionsList.contains(document.activeElement)) {
                        suggestionsList.style.display = 'none';
                        currentFocus = -1;
                    }
                }, 200);
            });

            async function loadTags() {
                try {
                    const response = await fetch('@Url.Action("GetTags", "MyWorks")');
                    if (response.ok) {
                        allTags = await response.json();
                    } else {
                        console.error('Ошибка при загрузке тегов');
                    }
                } catch (error) {
                    console.error('Ошибка:', error);
                }
            }

            function searchTags(query) {
                const filteredTags = allTags.filter(tag =>
                    tag.name.toLowerCase().includes(query.toLowerCase())
                );
                displayTagSuggestions(filteredTags, query);
            }

            function displayTagSuggestions(tags, query) {
                suggestionsList.innerHTML = '';

                if (tags.length > 0) {
                    tags.forEach(tag => {
                        const li = document.createElement('li');
                        li.className = 'autocomplete-item';
                        li.innerHTML = `
                            <div class="font-medium">#${tag.name}</div>
                            <div class="text-xs text-secondary-custom">Существующий тег</div>
                        `;
                        li.setAttribute('data-tag', tag.name);
                        suggestionsList.appendChild(li);
                    });
                }

                // Всегда показываем опцию для создания нового тега
                const li = document.createElement('li');
                li.className = 'autocomplete-item';
                li.innerHTML = `
                    <div class="font-medium">#${query}</div>
                    <div class="text-xs text-secondary-custom">Создать новый тег</div>
                `;
                li.setAttribute('data-tag', query);
                suggestionsList.appendChild(li);

                suggestionsList.style.display = 'block';
            }

            function selectTagItem(li) {
                const tag = li.getAttribute('data-tag');
                if (tag) {
                    addTagToSelection(tag);
                    tagInput.value = '';
                    suggestionsList.style.display = 'none';
                    currentFocus = -1;
                }
            }

            function addTagToSelection(tag) {
                let formattedTag = tag.trim();
                if (!formattedTag.startsWith('#')) {
                    formattedTag = '#' + formattedTag;
                }

                if (selectedTags.includes(formattedTag)) {
                    showToast('Этот тег уже добавлен к книге', 'warning');
                    return;
                }

                selectedTags.push(formattedTag);
                updateSelectedTagsDisplay();
                updateHiddenTagsInput();
                showToast(`Тег "${formattedTag}" добавлен`, 'success');
            }
        }

        // Автодополнение для email соавторов
        function initializeEmailAutocomplete() {
            const emailInput = document.getElementById('newCoAuthorEmail');
            const suggestionsList = document.getElementById('emailSuggestions');

            if (!emailInput || !suggestionsList) return;

            let debounceTimeout;
            let currentFocus = -1;

            emailInput.addEventListener('input', function() {
                clearTimeout(debounceTimeout);
                const query = this.value.trim();

                if (query.length < 2) {
                    suggestionsList.style.display = 'none';
                    return;
                }

                debounceTimeout = setTimeout(() => fetchUsers(query), 300);
            });

            emailInput.addEventListener('keydown', function(e) {
                const items = suggestionsList.querySelectorAll('li');

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    currentFocus = Math.min(currentFocus + 1, items.length - 1);
                    updateActiveItem(items, 'email');
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    currentFocus = Math.max(currentFocus - 1, -1);
                    updateActiveItem(items, 'email');
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (currentFocus > -1 && items[currentFocus]) {
                        selectEmailItem(items[currentFocus]);
                    }
                } else if (e.key === 'Escape') {
                    suggestionsList.style.display = 'none';
                    currentFocus = -1;
                }
            });

            suggestionsList.addEventListener('mousedown', function(e) {
                e.preventDefault();
                const li = e.target.closest('li');
                if (li) {
                    selectEmailItem(li);
                }
            });

            async function fetchUsers(query) {
                try {
                    showEmailLoadingState();

                    const response = await fetch(`/api/users/search?email=${encodeURIComponent(query)}`);
                    if (!response.ok) {
                        throw new Error('Ошибка при поиске пользователей');
                    }

                    const users = await response.json();
                    displayEmailSuggestions(users);
                } catch (error) {
                    console.error('Ошибка при запросе:', error);
                    showEmailErrorState('Не удалось загрузить пользователей');
                }
            }

            function displayEmailSuggestions(users) {
                suggestionsList.innerHTML = '';

                if (users && users.length > 0) {
                    users.forEach(user => {
                        const li = document.createElement('li');
                        li.className = 'autocomplete-item';

                        const userType = user.hasAuthorProfile ?
                            `<span class="text-green-400 text-xs bg-green-900 bg-opacity-50 px-2 py-1 rounded">Автор</span>` :
                            `<span class="text-blue-400 text-xs bg-blue-900 bg-opacity-50 px-2 py-1 rounded">Читатель</span>`;

                        li.innerHTML = `
                            <div class="flex justify-between items-start mb-1">
                                <div class="font-medium text-gold">${escapeHtml(user.userName)}</div>
                                ${userType}
                            </div>
                            <div class="text-sm email-inverse">${escapeHtml(user.email)}</div>
                            ${user.penName ? `<div class="text-xs mt-1 text-gold">Псевдоним: ${escapeHtml(user.penName)}</div>` : ''}
                        `;
                        li.setAttribute('data-email', user.email);
                        suggestionsList.appendChild(li);
                    });
                    suggestionsList.style.display = 'block';
                } else {
                    suggestionsList.innerHTML = `
                        <li class="autocomplete-item text-center">
                            <div class="mb-2">Пользователь не найден</div>
                            <div class="text-xs text-gold">Приглашение будет отправлено на введенный email</div>
                        </li>`;
                    suggestionsList.style.display = 'block';
                }
            }

            function selectEmailItem(li) {
                const email = li.getAttribute('data-email');
                if (email) {
                    document.getElementById('newCoAuthorEmail').value = email;
                    suggestionsList.style.display = 'none';
                    currentFocus = -1;
                }
            }

            function showEmailLoadingState() {
                suggestionsList.innerHTML = '<li class="autocomplete-item text-center"><i class="fas fa-spinner fa-spin mr-2"></i>Поиск пользователей...</li>';
                suggestionsList.style.display = 'block';
            }

            function showEmailErrorState(message) {
                suggestionsList.innerHTML = `<li class="autocomplete-item text-red-400 text-center">${message}</li>`;
                suggestionsList.style.display = 'block';
            }
        }

        // Модальное окно создания цикла
        function showCreateCycleModal() {
            document.getElementById('createCycleModal').classList.remove('hidden');
        }

        function hideCreateCycleModal() {
            document.getElementById('createCycleModal').classList.add('hidden');
        }

        document.getElementById('createCycleForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const name = document.getElementById('cycleName').value;

            try {
                const response = await fetch('@Url.Action("CreateCycle", "MyWorks")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
