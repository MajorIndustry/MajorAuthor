                    const chapterId = chapterItem.dataset.chapterId;

                    moveChapter(chapterId, 'up');
                });
            });

            // Обработчик для перемещения вниз
            document.querySelectorAll('.move-down-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const chapterItem = this.closest('.chapter-item');
                    const chapterId = chapterItem.dataset.chapterId;

                    moveChapter(chapterId, 'down');
                });
            });
        });

                async function deleteChapter(chapterId, chapterElement) {
            try {
                const response = await fetch('@Url.Action("DeleteChapter", "MyWorks")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `chapterId=${chapterId}`
                });
                if (response.ok) {
                    chapterElement.remove();
                    // ВЫЗЫВАЕМ ФУНКЦИЮ ОБНОВЛЕНИЯ НОМЕРОВ
                    renumberChaptersUI();
                    showToast('Глава успешно удалена', 'success');
                } else {
                    showToast('Ошибка при удалении главы', 'error');
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('Ошибка при удалении главы', 'error');
            }
        }

                function renumberChaptersUI() {
            const chapters = document.querySelectorAll('.chapter-item');

            chapters.forEach((item, index) => {
                // 1. Обновляем цифру в квадратике
                // Ищем div с классом bg-[var(--accent-gold)] и обновляем текст
                const numberBox = item.querySelector('.bg-\\[var\\(--accent-gold\\)\\]');
                if (numberBox) {
                    numberBox.textContent = index + 1; // Нумерация с 1
                }

                // 2. Обновляем состояние стрелочек (disabled)
                const upBtn = item.querySelector('.move-up-btn');
                const downBtn = item.querySelector('.move-down-btn');

                if (upBtn) {
                    upBtn.disabled = (index === 0); // Отключить "Вверх" у первой
                    // Визуальное отключение стилей
                    if(index === 0) upBtn.classList.add('opacity-50', 'cursor-not-allowed');
                    else upBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                }

                if (downBtn) {
                    downBtn.disabled = (index === chapters.length - 1); // Отключить "Вниз" у последней
                    if(index === chapters.length - 1) downBtn.classList.add('opacity-50', 'cursor-not-allowed');
                    else downBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                }
            });
        }

                async function toggleChapterPublish(chapterId, newIsPublic, button) {
            // Сохраняем оригинальный контент на случай ошибки
            const originalContent = button.innerHTML;

            try {
                // Ставим спиннер и блокируем кнопку
                button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                button.disabled = true;

                const response = await fetch('@Url.Action("UpdateChapterStatus", "MyWorks")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        ChapterId: parseInt(chapterId),
                        IsPublic: Boolean(newIsPublic)
                    })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    // 1. ОБНОВЛЕНИЕ КНОПКИ (Полная перезапись innerHTML)
                    if (newIsPublic) {
                        // Если стала публичной -> иконка "закрыть глаз" (чтобы скрыть)
                        button.innerHTML = '<i class="fas fa-eye-slash"></i>';
                        button.dataset.isPublic = 'true';

                        // Меняем цвет кнопки
                        button.classList.remove('text-secondary-custom', 'hover:text-green-500');
                        button.classList.add('text-green-500', 'hover:text-green-700');

                        showToast('Глава опубликована', 'success');
                    } else {
                        // Если стала черновиком -> иконка "открыть глаз" (чтобы опубликовать)
                        button.innerHTML = '<i class="fas fa-eye"></i>';
                        button.dataset.isPublic = 'false';

                        // Меняем цвет кнопки
                        button.classList.remove('text-green-500', 'hover:text-green-700');
                        button.classList.add('text-secondary-custom', 'hover:text-green-500');

                        showToast('Глава снята с публикации', 'success');
                    }

                    // 2. ОБНОВЛЕНИЕ ТЕКСТА СТАТУСА (используем новый класс js-status-text)
                    const chapterItem = button.closest('.chapter-item');
                    const statusSpan = chapterItem.querySelector('.js-status-text');

                    if (statusSpan) {
                        if (newIsPublic) {
                            statusSpan.innerHTML = '<i class="fas fa-eye text-green-500"></i> Опубликована';
                        } else {
                            statusSpan.innerHTML = '<i class="fas fa-eye-slash text-gray-500"></i> Черновик';
                        }
                    }
                } else {
                    // Ошибка от сервера
                    showToast(result.error || 'Ошибка при изменении статуса главы', 'error');
                    button.innerHTML = originalContent;
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('Ошибка соединения', 'error');
                // Возвращаем кнопку в исходное состояние
                button.innerHTML = originalContent;
            } finally {
                button.disabled = false;
            }
        }

                async function moveChapter(chapterId, direction) {
            try {
                const chapterItem = document.querySelector(`[data-chapter-id="${chapterId}"]`);
                const moveButton = chapterItem.querySelector(direction === 'up' ? '.move-up-btn' : '.move-down-btn');

                // Блокируем кнопку на время запроса
                moveButton.disabled = true;
                const originalContent = moveButton.innerHTML;
                moveButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

                const response = await fetch('@Url.Action("UpdateChapterOrder", "MyWorks")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        chapterId: chapterId,
                        direction: direction
                    })
                });

                if (response.ok) {
                    // Перезагружаем страницу, чтобы отобразить новый порядок
                    location.reload();
                } else {
                    showToast('Ошибка при перемещении главы', 'error');
                    moveButton.innerHTML = originalContent;
                    moveButton.disabled = false;
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('Ошибка при перемещении главы', 'error');
                const chapterItem = document.querySelector(`[data-chapter-id="${chapterId}"]`);
                const moveButton = chapterItem.querySelector(direction === 'up' ? '.move-up-btn' : '.move-down-btn');
                moveButton.disabled = false;
                moveButton.innerHTML = direction === 'up' ? '<i class="fas fa-chevron-up"></i>' : '<i class="fas fa-chevron-down"></i>';
            }
        }
        // Вспомогательные функции
        function escapeHtml(unsafe) {
            return unsafe
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function showToast(message, type = 'info') {
            const toast = document.createElement('div');
            const bgColor = type === 'success' ? 'bg-green-500' :
                           type === 'error' ? 'bg-red-500' :
                           type === 'warning' ? 'bg-yellow-500' : 'bg-blue-500';

            toast.className = `fixed top-4 right-4 ${bgColor} text-white px-6 py-3 rounded-xl shadow-lg z-[1000]`;
            toast.textContent = message;

            document.body.appendChild(toast);

            setTimeout(() => {
                toast.remove();
            }, 3000);
        }

        // Глобальные функции для вызова из HTML
        window.removeSelectedGenre = removeSelectedGenre;
        window.removeSelectedTag = removeSelectedTag;
        window.removeCover = removeCover;
        window.promoteBook = promoteBook;
