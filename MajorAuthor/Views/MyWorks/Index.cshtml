@model MajorAuthor.Models.MyWorksViewModel

@{
    ViewData["Title"] = "Мои Произведения";
}

<div class="page-container">
    <div class="content-wrapper">
        <div class="container mx-auto px-4 sm:px-6 py-6 sm:py-8">
            <!-- Заголовок -->
            <header class="text-center mb-8 sm:mb-12">
                <h1 class="text-3xl sm:text-4xl font-bold section-title decorative-title">
                    @ViewData["Title"]
                </h1>
            </header>

            <!-- Message Box -->
            <div id="messageBox" class="message-box hidden mb-6 p-4 rounded-lg text-center transition-all duration-500 ease-in-out" role="alert">
                <span id="messageText" class="block sm:inline"></span>
            </div>

            @if (!Model.IsUserAuthor)
            {
                <!-- Блок для не-авторов -->
                <div class="white-block p-8 text-center mb-8">
                    <div class="mb-6">
                        <i class="fas fa-pen-nib text-5xl text-[var(--accent-gold)] mb-4"></i>
                        <p class="text-lg text-[var(--auth-block-text)] mb-6">Чтобы создавать произведения, вам нужно стать автором.</p>
                    </div>
                    <div class="text-center">
                        <button id="registerAuthorBtn" class="auth-btn-primary px-8 py-3 rounded-lg font-semibold text-lg">
                            Стать автором
                        </button>
                    </div>
                </div>
            }
            else
            {
                <!-- Основной контент для авторов -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                    <!-- Книги -->
                    <div class="white-block p-6 rounded-2xl">
                        <div class="flex justify-between items-center mb-6">
                            <h2 class="text-2xl font-semibold text-[var(--accent-gold)]">Книги</h2>
                            <a href="@Url.Action("CreateBook", "MyWorks")" class="auth-btn-primary px-4 py-2 rounded-lg font-semibold text-sm">
                                <i class="fas fa-plus mr-2"></i>Добавить
                            </a>
                        </div>
                        @if (Model.Works.Any(w => w.Type == "Книга"))
                        {
                            <div class="space-y-4">
                                @foreach (var work in Model.Works.Where(w => w.Type == "Книга"))
                                {
                                    <div data-work-id="@work.Id" data-work-type="@work.Type"
                                         class="work-item p-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)] transition-all duration-300 hover:transform hover:scale-105 cursor-pointer group">
                                        <div class="flex justify-between items-center gap-3">
                                            <span class="work-title text-lg font-medium text-[var(--text-primary)] flex-1 truncate"
                                                  onclick="window.location.href = '@Url.Action("ReadBook", "Read", new { id = work.Id })'">
                                                @work.Title
                                            </span>
                                            <div class="flex space-x-2 flex-shrink-0">
                                                <a href="@Url.Action("BookDashboard", "MyWorks", new { id = work.Id })"
                                                   class="edit-btn p-2 rounded-lg bg-[var(--bg-primary)] text-[var(--text-primary)] hover:bg-[var(--accent-gold)] hover:text-[var(--header-bg)] transition-colors border border-[var(--border-color)]"
                                                   title="Редактировать"
                                                   onclick="event.stopPropagation()">
                                                    <i class="fas fa-edit text-sm"></i>
                                                </a>
                                                <button class="delete-btn p-2 rounded-lg bg-[var(--bg-primary)] text-[var(--text-primary)] hover:bg-red-500 hover:text-white transition-colors border border-[var(--border-color)]"
                                                        title="Удалить"
                                                        onclick="event.stopPropagation()">
                                                    <i class="fas fa-trash text-sm"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-8">
                                <i class="fas fa-book text-4xl text-[var(--text-secondary)] mb-3"></i>
                                <p class="text-[var(--text-secondary)] italic">Книги пока не добавлены.</p>
                            </div>
                        }
                    </div>

                    <!-- Стихи -->
                    <div class="white-block p-6 rounded-2xl">
                        <div class="flex justify-between items-center mb-6">
                            <h2 class="text-2xl font-semibold text-[var(--accent-gold)]">Стихи</h2>
                            <a href="@Url.Action("CreatePoem", "MyWorks")" class="auth-btn-primary px-4 py-2 rounded-lg font-semibold text-sm">
                                <i class="fas fa-plus mr-2"></i>Добавить
                            </a>
                        </div>
                        @if (Model.Works.Any(w => w.Type == "Стих"))
                        {
                            <div class="space-y-4">
                                @foreach (var work in Model.Works.Where(w => w.Type == "Стих"))
                                {
                                    <div data-work-id="@work.Id" data-work-type="@work.Type"
                                         class="work-item p-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)] transition-all duration-300 hover:transform hover:scale-105 cursor-pointer group">
                                        <div class="flex justify-between items-center gap-3">
                                            <span class="work-title text-lg font-medium text-[var(--text-primary)] flex-1 truncate"
                                                  onclick="window.location.href = '@Url.Action("ReadPoem", "Read", new { id = work.Id })'">
                                                @work.Title
                                            </span>
                                            <div class="flex space-x-2 flex-shrink-0">
                                                <a href="@Url.Action("EditPoem", "MyWorks", new { id = work.Id })"
                                                   class="edit-btn p-2 rounded-lg bg-[var(--bg-primary)] text-[var(--text-primary)] hover:bg-[var(--accent-gold)] hover:text-[var(--header-bg)] transition-colors border border-[var(--border-color)]"
                                                   title="Редактировать"
                                                   onclick="event.stopPropagation()">
                                                    <i class="fas fa-edit text-sm"></i>
                                                </a>
                                                <button class="delete-btn p-2 rounded-lg bg-[var(--bg-primary)] text-[var(--text-primary)] hover:bg-red-500 hover:text-white transition-colors border border-[var(--border-color)]"
                                                        title="Удалить"
                                                        onclick="event.stopPropagation()">
                                                    <i class="fas fa-trash text-sm"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-8">
                                <i class="fas fa-pen-fancy text-4xl text-[var(--text-secondary)] mb-3"></i>
                                <p class="text-[var(--text-secondary)] italic">Стихи пока не добавлены.</p>
                            </div>
                        }
                    </div>

                    <!-- Блоги -->
                    <div class="white-block p-6 rounded-2xl">
                        <div class="flex justify-between items-center mb-6">
                            <h2 class="text-2xl font-semibold text-[var(--accent-gold)]">Блоги</h2>
                            <a href="@Url.Action("CreateBlog", "MyWorks")" class="auth-btn-primary px-4 py-2 rounded-lg font-semibold text-sm">
                                <i class="fas fa-plus mr-2"></i>Добавить
                            </a>
                        </div>
                        @if (Model.Works.Any(w => w.Type == "Блог"))
                        {
                            <div class="space-y-4">
                                @foreach (var work in Model.Works.Where(w => w.Type == "Блог"))
                                {
                                    <div data-work-id="@work.Id" data-work-type="@work.Type"
                                         class="work-item p-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)] transition-all duration-300 hover:transform hover:scale-105 cursor-pointer group">
                                        <div class="flex justify-between items-center gap-3">
                                            <span class="work-title text-lg font-medium text-[var(--text-primary)] flex-1 truncate"
                                                  onclick="window.location.href = '@Url.Action("ReadBlog", "Read", new { id = work.Id })'">
                                                @work.Title
                                            </span>
                                            <div class="flex space-x-2 flex-shrink-0">
                                                <a href="@Url.Action("EditBlog", "MyWorks", new { id = work.Id })"
                                                   class="edit-btn p-2 rounded-lg bg-[var(--bg-primary)] text-[var(--text-primary)] hover:bg-[var(--accent-gold)] hover:text-[var(--header-bg)] transition-colors border border-[var(--border-color)]"
                                                   title="Редактировать"
                                                   onclick="event.stopPropagation()">
                                                    <i class="fas fa-edit text-sm"></i>
                                                </a>
                                                <button class="delete-btn p-2 rounded-lg bg-[var(--bg-primary)] text-[var(--text-primary)] hover:bg-red-500 hover:text-white transition-colors border border-[var(--border-color)]"
                                                        title="Удалить"
                                                        onclick="event.stopPropagation()">
                                                    <i class="fas fa-trash text-sm"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-8">
                                <i class="fas fa-blog text-4xl text-[var(--text-secondary)] mb-3"></i>
                                <p class="text-[var(--text-secondary)] italic">Блоги пока не добавлены.</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

<!-- Модальное окно для регистрации автора -->
<div id="registerAuthorModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 py-10 sm:p-0">
        <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity" aria-hidden="true"></div>
        <div class="white-block rounded-lg text-left overflow-hidden transform transition-all sm:my-8 sm:max-w-lg sm:w-full mx-4">
            <div class="px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                <div class="sm:flex sm:items-start">
                    <div class="mt-3 text-center sm:mt-0 sm:text-left w-full">
                        <h3 class="text-lg leading-6 font-medium text-[var(--auth-block-text)]" id="modal-title">
                            Стать автором
                        </h3>
                        <div class="mt-4">
                            <p class="text-sm text-[var(--text-secondary)] mb-4">
                                Чтобы зарегистрироваться как автор, пожалуйста, введите ваше имя или псевдоним.
                            </p>
                            <input type="text" id="penNameInput"
                                   class="auth-input w-full rounded-lg px-4 py-3"
                                   placeholder="Имя или псевдоним">
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-4 py-4 sm:px-6 sm:flex sm:flex-row-reverse gap-3">
                <button type="button" id="submitPenNameBtn" class="auth-btn-primary px-6 py-2 rounded-lg font-semibold">
                    Подтвердить
                </button>
                <button type="button" id="closeModalBtn" class="auth-btn-secondary px-6 py-2 rounded-lg font-medium">
                    Отмена
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно для подтверждения удаления -->
<div id="deleteConfirmModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="delete-modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 py-10 sm:p-0">
        <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity" aria-hidden="true"></div>
        <div class="white-block rounded-lg text-left overflow-hidden transform transition-all sm:my-8 sm:max-w-sm sm:w-full mx-4">
            <div class="px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                <div class="sm:flex sm:items-start">
                    <div class="mt-3 text-center sm:mt-0 sm:text-left w-full">
                        <h3 class="text-lg leading-6 font-medium text-[var(--auth-block-text)]" id="delete-modal-title">
                            Удалить произведение?
                        </h3>
                        <div class="mt-4">
                            <p class="text-sm text-[var(--text-secondary)]">
                                Вы уверены, что хотите удалить это произведение? Это действие нельзя отменить.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="px-4 py-4 sm:px-6 sm:flex sm:flex-row-reverse gap-3">
                <button type="button" id="confirmDeleteBtn" class="px-6 py-2 rounded-lg font-semibold bg-red-500 text-white hover:bg-red-600 transition-colors">
                    Удалить
                </button>
                <button type="button" id="cancelDeleteBtn" class="auth-btn-secondary px-6 py-2 rounded-lg font-medium">
                    Отмена
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Основные стили для размещения футера внизу */
    .page-container {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .content-wrapper {
        flex: 1 0 auto;
    }

    .footer {
        flex-shrink: 0;
    }

    .message-box {
        opacity: 0;
        transform: translateY(-10px);
        transition: all 0.5s ease-in-out;
    }

        .message-box.show {
            opacity: 1;
            transform: translateY(0);
        }

        .message-box.success {
            background-color: rgba(34, 197, 94, 0.1);
            border: 1px solid rgba(34, 197, 94, 0.3);
            color: rgb(21, 128, 61);
        }

        .message-box.error {
            background-color: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: rgb(185, 28, 28);
        }

    .work-item {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        .work-item:hover {
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
            border-color: var(--accent-gold);
        }

    /* Стили для кнопок действий - теперь всегда видны */
    .edit-btn, .delete-btn {
        opacity: 0.8;
        transition: all 0.3s ease;
    }

        .edit-btn:hover, .delete-btn:hover {
            opacity: 1;
            transform: scale(1.05);
        }

    /* Улучшенная видимость кнопок */
    .edit-btn {
        background-color: var(--bg-primary) !important;
        color: var(--text-primary) !important;
        border: 1px solid var(--border-color) !important;
    }

        .edit-btn:hover {
            background-color: var(--accent-gold) !important;
            color: var(--header-bg) !important;
            border-color: var(--accent-gold) !important;
        }

    .delete-btn {
        background-color: var(--bg-primary) !important;
        color: var(--text-primary) !important;
        border: 1px solid var(--border-color) !important;
    }

        .delete-btn:hover {
            background-color: #dc2626 !important;
            color: white !important;
            border-color: #dc2626 !important;
        }

    /* Адаптивность */
    @@media (max-width: 1024px) {
        .grid-cols-3 {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .container {
            padding-left: 1rem;
            padding-right: 1rem;
        }

        .white-block {
            padding: 1.5rem;
        }

        .section-title {
            font-size: 1.75rem;
        }

        .work-title {
            font-size: 1rem;
        }

        .edit-btn, .delete-btn {
            padding: 0.5rem !important;
        }
    }

    /* Плавные переходы */
    .transition-all {
        transition-property: all;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 300ms;
    }

    /* Улучшенное усечение текста */
    .truncate {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const registerModal = document.getElementById("registerAuthorModal");
        const openModalBtn = document.getElementById("registerAuthorBtn");
        const closeModalBtn = document.getElementById("closeModalBtn");
        const submitBtn = document.getElementById("submitPenNameBtn");
        const penNameInput = document.getElementById("penNameInput");
        const messageBox = document.getElementById("messageBox");
        const messageText = document.getElementById("messageText");
        const deleteConfirmModal = document.getElementById('deleteConfirmModal');
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
        const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');

        let workToDelete = null;

        function showMessage(text, isError = false) {
            messageText.textContent = text;
            messageBox.className = 'message-box mb-6 p-4 rounded-lg text-center transition-all duration-500 ease-in-out';

            if (isError) {
                messageBox.classList.add('error');
            } else {
                messageBox.classList.add('success');
            }

            messageBox.classList.remove('hidden');
            messageBox.classList.add('show');

            setTimeout(() => {
                messageBox.classList.remove('show');
                setTimeout(() => {
                    messageBox.classList.add('hidden');
                }, 500);
            }, 5000);
        }

        function toggleModal(modal, show) {
            if (show) {
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            } else {
                modal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }

        // Event listeners for author registration modal
        if (openModalBtn) {
            openModalBtn.addEventListener("click", () => toggleModal(registerModal, true));
        }
        closeModalBtn.addEventListener("click", () => toggleModal(registerModal, false));
        registerModal.addEventListener("click", (e) => {
            if (e.target.id === "registerAuthorModal") {
                toggleModal(registerModal, false);
            }
        });

        submitBtn.addEventListener("click", async function () {
            const penName = penNameInput.value.trim();
            if (!penName) {
                showMessage("Пожалуйста, введите псевдоним или имя.", true);
                return;
            }

            try {
                const response = await fetch("/MyWorks/RegisterAuthor", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ penName: penName })
                });

                const result = await response.json();
                if (result.success) {
                    showMessage("Поздравляем, вы стали автором!");
                    setTimeout(() => {
                        window.location.reload();
                    }, 1000);
                } else {
                    showMessage("Ошибка: " + result.message, true);
                }
            } catch (error) {
                console.error("Ошибка: ", error);
                showMessage("Произошла ошибка при регистрации.", true);
            }
        });

        // Event listeners for delete confirmation modal
        document.querySelectorAll('.delete-btn').forEach(button => {
            button.addEventListener('click', (e) => {
                e.stopPropagation();
                const workItem = e.target.closest('.work-item');
                workToDelete = {
                    id: workItem.dataset.workId,
                    type: workItem.dataset.workType,
                    element: workItem
                };
                toggleModal(deleteConfirmModal, true);
            });
        });

        cancelDeleteBtn.addEventListener('click', () => {
            toggleModal(deleteConfirmModal, false);
            workToDelete = null;
        });

        deleteConfirmModal.addEventListener('click', (e) => {
            if (e.target.id === 'deleteConfirmModal') {
                toggleModal(deleteConfirmModal, false);
                workToDelete = null;
            }
        });

        confirmDeleteBtn.addEventListener('click', async () => {
            if (!workToDelete) return;

            try {
                const response = await fetch(`/MyWorks/DeleteWork?id=${workToDelete.id}&type=${workToDelete.type}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                if (response.ok) {
                    // Remove the element from the DOM
                    workToDelete.element.remove();
                    showMessage(`Произведение "${workToDelete.type}" успешно удалено.`);
                } else {
                    const error = await response.json();
                    showMessage(`Ошибка при удалении: ${error.message}`, true);
                }
            } catch (error) {
                console.error('Ошибка:', error);
                showMessage('Произошла ошибка при удалении произведения.', true);
            } finally {
                toggleModal(deleteConfirmModal, false);
                workToDelete = null;
            }
        });

        // ESC key to close modals
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                toggleModal(registerModal, false);
                toggleModal(deleteConfirmModal, false);
            }
        });
                // Проверка доступности псевдонима в реальном времени
        penNameInput.addEventListener('input', async function() {
            const penName = this.value.trim();

            if (penName.length < 2) {
                return;
            }

            try {
                const response = await fetch(`/MyWorks/CheckPenNameAvailability?penName=${encodeURIComponent(penName)}`);
                const result = await response.json();

                if (result.available) {
                    this.classList.remove('border-red-500');
                    this.classList.add('border-green-500');
                    submitBtn.disabled = false;
                } else {
                    this.classList.remove('border-green-500');
                    this.classList.add('border-red-500');
                    submitBtn.disabled = true;
                }

                // Показываем подсказку
                showPenNameHint(result.message, result.available);
            } catch (error) {
                console.error('Ошибка при проверке псевдонима:', error);
            }
        });

        function showPenNameHint(message, isSuccess) {
            let hintElement = document.getElementById('penNameHint');
            if (!hintElement) {
                hintElement = document.createElement('div');
                hintElement.id = 'penNameHint';
                hintElement.className = 'text-sm mt-2';
                penNameInput.parentNode.appendChild(hintElement);
            }

            hintElement.textContent = message;
            hintElement.className = `text-sm mt-2 ${isSuccess ? 'text-green-600' : 'text-red-600'}`;
        }
    });
</script>