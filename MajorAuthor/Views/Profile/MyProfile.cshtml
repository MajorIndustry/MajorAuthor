@using System.Security.Claims
@using MajorAuthor.Data
@using MajorAuthor.Services
@using Microsoft.AspNetCore.Identity
@model MajorAuthor.Models.MyProfileViewModel
@inject UserManager<ApplicationUser> UserManager
@inject IAuthorService AuthorService
@{
    ViewData["Title"] = Model.IsOwnProfile ? "Мой профиль" : "Профиль автора";
    var isOtherReaderProfile = !Model.IsAuthor && !Model.IsOwnProfile;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isCurrentUserAuthor = false;
    if (!string.IsNullOrEmpty(currentUserId))
    {
        var currentUserAuthor = await AuthorService.GetAuthorByUserIdAsync(currentUserId);
        isCurrentUserAuthor = currentUserAuthor != null;
    }
}

<div class="container mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <header class="text-center mb-8 sm:mb-12">
        <h1 class="text-3xl sm:text-4xl font-bold section-title decorative-title">
            @ViewData["Title"]
        </h1>
    </header>

    <div class="white-block p-6 sm:p-8 rounded-2xl mb-8 sm:mb-12">
        <div class="flex flex-col sm:flex-row items-center gap-6 sm:gap-8">
            <div class="flex-shrink-0">
                <img src="@Model.PhotoUrl" alt="Фото профиля"
                     class="w-24 h-24 sm:w-32 sm:h-32 rounded-full object-cover border-4 border-[var(--accent-gold)] shadow-lg"
                     onerror="this.onerror=null;this.src='https://placehold.co/128x128/ccc/333?text=AV';">
            </div>

            <div class="text-center sm:text-left flex-grow space-y-3 sm:space-y-4">
                @if (Model.IsAuthor)
                {
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h2 class="text-2xl sm:text-3xl font-semibold text-[var(--auth-block-text)] mb-1">
                                @Model.DisplayName
                                <span class="text-[var(--accent-gold)] ml-2">(Автор)</span>
                            </h2>
                            @if (!string.IsNullOrEmpty(Model.FullName))
                            {
                                <p class="text-lg text-[var(--text-secondary)]">@Model.FullName</p>
                            }
                        </div>

                        @if (!Model.IsOwnProfile)
                        {
                            <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 flex-shrink-0">
                                <button id="followButton"
                                        class="@(Model.IsFollowing ? "auth-btn-secondary" : "auth-btn-primary") px-6 py-3 rounded-lg font-semibold transition-all duration-300"
                                        data-author-id="@Model.AuthorId"
                                        data-is-following="@Model.IsFollowing.ToString().ToLower()">
                                    <i class="@(Model.IsFollowing ? "fas fa-user-minus" : "fas fa-user-plus") mr-2"></i>
                                    <span id="followText">
                                        @(Model.IsFollowing ? "Отписаться" : "Подписаться")
                                    </span>
                                </button>

                                @if (isCurrentUserAuthor)
                                {
                                    <button id="messageButton"
                                            class="auth-btn-primary px-6 py-3 rounded-lg font-semibold transition-all duration-300 flex items-center"
                                            data-user-id="@Model.UserId">
                                        <i class="fas fa-envelope mr-2"></i>
                                        <span>Написать сообщение</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="flex flex-wrap gap-4 sm:gap-6 justify-center sm:justify-start">
                        <div class="text-center">
                            <div id="followerCount" class="text-2xl sm:text-3xl font-bold text-[var(--accent-gold)]">@Model.FollowerCount</div>
                            <div class="text-sm text-[var(--text-secondary)]">Подписчиков</div>
                        </div>
                        @if (Model.AuthoredBooks != null)
                        {
                            <div class="text-center">
                                <div class="text-2xl sm:text-3xl font-bold text-[var(--accent-gold)]">@Model.AuthoredBooks.Count</div>
                                <div class="text-sm text-[var(--text-secondary)]">Книг</div>
                            </div>
                        }
                        @if (Model.AuthoredBlogs != null)
                        {
                            <div class="text-center">
                                <div class="text-2xl sm:text-3xl font-bold text-[var(--accent-gold)]">@Model.AuthoredBlogs.Count</div>
                                <div class="text-sm text-[var(--text-secondary)]">Блогов</div>
                            </div>
                        }
                        @if (Model.AuthoredPoems != null)
                        {
                            <div class="text-center">
                                <div class="text-2xl sm:text-3xl font-bold text-[var(--accent-gold)]">@Model.AuthoredPoems.Count</div>
                                <div class="text-sm text-[var(--text-secondary)]">Стихов</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-semibold text-[var(--auth-block-text)] mb-2">
                            @Model.DisplayName
                        </h2>
                        <p class="text-lg text-[var(--text-secondary)]">Читатель</p>
                    </div>
                    <div class="flex flex-wrap gap-4 sm:gap-6 justify-center sm:justify-start">
                        @if (Model.IsOwnProfile && Model.ReadBooks != null)
                        {
                            <div class="text-center">
                                <div class="text-2xl sm:text-3xl font-bold text-[var(--accent-gold)]">@Model.ReadBooks.Count</div>
                                <div class="text-sm text-[var(--text-secondary)]">Прочитано</div>
                            </div>
                        }
                        @if (Model.IsOwnProfile && Model.FavoriteBooks != null)
                        {
                            <div class="text-center">
                                <div class="text-2xl sm:text-3xl font-bold text-[var(--accent-gold)]">@Model.FavoriteBooks.Count</div>
                                <div class="text-sm text-[var(--text-secondary)]">В закладках</div>
                            </div>
                        }
                        @if (Model.LikedBooks != null)
                        {
                            <div class="text-center">
                                <div class="text-2xl sm:text-3xl font-bold text-[var(--accent-gold)]">@Model.LikedBooks.Count</div>
                                <div class="text-sm text-[var(--text-secondary)]">Понравившихся книг</div>
                            </div>
                        }
                        @if (Model.LikedPoems != null)
                        {
                            <div class="text-center">
                                <div class="text-2xl sm:text-3xl font-bold text-[var(--accent-gold)]">@Model.LikedPoems.Count</div>
                                <div class="text-sm text-[var(--text-secondary)]">Понравившихся стихов</div>
                            </div>
                        }
                        @if (Model.LikedBlogs != null)
                        {
                            <div class="text-center">
                                <div class="text-2xl sm:text-3xl font-bold text-[var(--accent-gold)]">@Model.LikedBlogs.Count</div>
                                <div class="text-sm text-[var(--text-secondary)]">Понравившихся блогов</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div id="profileContentContainer">
        @await Html.PartialAsync("_ProfileContentPartial", Model)
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
             // --- Скрипт для кнопки Подписки/Отписки ---
             const followButton = document.getElementById('followButton');
             if (followButton) {
                followButton.addEventListener('click', handleFollowClick);
             }

            const messageButton = document.getElementById('messageButton');
             if (messageButton) {
                messageButton.addEventListener('click', function() {
                    const userId = this.dataset.userId;
                    window.location.href = '@Url.Action("Conversation", "Messages")' + '?userId=' + userId;
                });
             }

             // --- НОВЫЙ СКРИПТ ДЛЯ ЖИВОГО ПОИСКА ---

             // Глобальная переменная для хранения текущего поискового запроса
            let currentSearchQuery = '';
            let searchTimeout;
            const profileUserId = '@Model.UserId'; // Получаем ID профиля из модели

            // Функция для выполнения поиска
            function performProfileSearch(query) {
                currentSearchQuery = query;
                showLoadingIndicator();

                $.ajax({
                    url: '@Url.Action("SearchOnProfile", "Profile")',
                    type: 'GET',
                    data: {
                        query: query,
                        userId: profileUserId // Передаем ID пользователя, чей профиль мы смотрим
                    },
                    success: function (data) {
                        $('#profileContentContainer').html(data);
                        // Опционально: можно обновить URL, но для фильтрации это может быть излишне
                        // updateBrowserHistory(query);
                    },
                    error: function () {
                        hideLoadingIndicator();
                        showError('Произошла ошибка при поиске. Пожалуйста, попробуйте еще раз.');
                    }
                });
            }

            // Функция для очистки поиска
            function clearSearch() {
                currentSearchQuery = '';
                performProfileSearch('');
                // Также очищаем поле ввода в шапке
                $('#mainSearchInput').val('');
                $('#searchInputMobile').val('');
            }

            // Функция для показа индикатора загрузки
            function showLoadingIndicator() {
                $('#profileContentContainer').html(`
                    <div class="white-block text-center py-12">
                        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-[var(--accent-gold)] mx-auto mb-4"></div>
                        <p class="text-[var(--auth-block-text)]">Поиск по профилю...</p>
                    </div>
                `);
            }

            // Функция для скрытия индикатора (вызывается заменой HTML)
            function hideLoadingIndicator() { }

            // Функция для показа ошибки
            function showError(message) {
                $('#profileContentContainer').html(`
                    <div class="white-block text-center py-12">
                        <i class="fas fa-exclamation-triangle text-4xl text-red-500 mb-4"></i>
                        <p class="text-[var(--auth-block-text)]">${message}</p>
                    </div>
                `);
            }

            // Перехватываем отправку форм поиска на странице Профиля
            $('#mainSearchForm, #mobileSearchForm').on('submit', function (e) {
                // Проверяем, что мы на странице профиля
                if (window.location.pathname.toLowerCase().includes('/profile/')) {
                    const query = $(this).find('input[type="text"]').val().trim();
                    e.preventDefault(); // <-- ВАЖНО: Предотвращаем отправку формы
                    performProfileSearch(query);

                    // Закрываем поисковые формы после отправки
                    $('#mainSearchInputWrapper').removeClass('active');
                    $('#searchWrapperMobile').removeClass('active');
                    $('.search-toggle-desktop').removeClass('hidden-when-active');
                }
            });

            // Обработчик для live search (поиск при вводе)
            $('#mainSearchInput, #searchInputMobile').on('input', function () {
                // Проверяем, что мы на странице профиля
                if (window.location.pathname.toLowerCase().includes('/profile/')) {
                    clearTimeout(searchTimeout);
                    const query = $(this).val().trim();

                    // Если запрос достаточно длинный, выполняем поиск
                    if (query.length >= 2) {
                        searchTimeout = setTimeout(() => {
                            performProfileSearch(query);
                        }, 500); // Задержка в 500ms
                    } else if (query.length === 0 && currentSearchQuery) {
                        // Если запрос очищен, а предыдущий был - очищаем поиск
                        clearSearch();
                    }
                }
            });
        });

        // --- Существующий код для подписки ---
               async function handleFollowClick(event) {
            const button = event.currentTarget;
            const authorId = button.dataset.authorId;
            const isFollowing = button.dataset.isFollowing === 'true';

            button.disabled = true;
            const originalHtml = button.innerHTML;
            button.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Загрузка...';

            try {
                const url = isFollowing ? '@Url.Action("UnfollowAuthor", "Profile")' : '@Url.Action("FollowAuthor", "Profile")';
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    body: JSON.stringify({ authorId: parseInt(authorId) })
                });

                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }

                const result = await response.json();

                if (result.success) {
                    const newFollowingState = !isFollowing;
                    button.dataset.isFollowing = newFollowingState.toString();

                    if (newFollowingState) {
                        button.classList.remove('auth-btn-primary');
                        button.classList.add('auth-btn-secondary');
                        button.innerHTML = '<i class="fas fa-user-minus mr-2"></i>Отписаться';
                    } else {
                        button.classList.remove('auth-btn-secondary');
                        button.classList.add('auth-btn-primary');
                        button.innerHTML = '<i class="fas fa-user-plus mr-2"></i>Подписаться';
                    }

                    // Обновляем счетчик подписчиков
                    const followerCountElement = document.getElementById('followerCount');
                    if (followerCountElement && result.followerCount !== undefined) {
                        followerCountElement.textContent = result.followerCount;
                    }

                    // Обновляем список подписчиков
                    updateFollowersList(result.followers);

                    showNotification(
                        newFollowingState ? 'Вы подписались на автора' : 'Вы отписались от автора',
                        'success'
                    );
                } else {
                    showNotification(result.message || 'Произошла ошибка', 'error');
                    button.innerHTML = originalHtml;
                }

            } catch (error) {
                console.error('Request failed:', error);
                showNotification('Произошла ошибка при выполнении действия', 'error');
                button.innerHTML = originalHtml;
            } finally {
                button.disabled = false;
            }
        }

               // Функция для обновления списка подписчиков
        function updateFollowersList(followers) {
            const followersContainer = document.querySelector('#followersGrid');
            if (!followersContainer) return;

            // Очищаем текущий список
            followersContainer.innerHTML = '';

            // Добавляем новых подписчиков
            if (followers && followers.length > 0) {
                followers.forEach(follower => {
                    const followerElement = document.createElement('div');
                    followerElement.className = 'follower-item flex items-center space-x-3 p-3 rounded-lg bg-[var(--bg-secondary)] cursor-pointer transition-all duration-300 hover:bg-[var(--accent-gold)] hover:bg-opacity-20';
                    followerElement.setAttribute('data-follower-userid', follower.userId);
                    followerElement.onclick = function() {
                        window.location.href = '@Url.Action("ReaderProfile", "Profile")' + '?id=' + follower.userId;
                    };

                    const avatar = document.createElement('div');
                    avatar.className = 'w-10 h-10 rounded-full bg-[var(--accent-gold)] flex items-center justify-center text-[var(--header-bg)] font-semibold';
                    avatar.textContent = (follower.userName || 'П').toUpperCase().charAt(0);

                    const nameDiv = document.createElement('div');
                    nameDiv.className = 'font-medium text-[var(--text-primary)]';
                    nameDiv.textContent = follower.userName || 'Пользователь';

                    followerElement.appendChild(avatar);
                    followerElement.appendChild(nameDiv);
                    followersContainer.appendChild(followerElement);
                });
            } else {
                // Если подписчиков нет, показываем сообщение
                const noFollowersMessage = document.createElement('div');
                noFollowersMessage.className = 'col-span-full text-center py-8';
                noFollowersMessage.innerHTML = `
                    <i class="fas fa-users text-4xl text-[var(--text-secondary)] mb-4"></i>
                    <h3 class="text-xl font-semibold text-[var(--auth-block-text)] mb-2">Подписчиков пока нет</h3>
                    <p class="text-[var(--text-secondary)]">Здесь появятся пользователи, которые подпишутся на вас.</p>
                `;
                followersContainer.appendChild(noFollowersMessage);
            }

            // Обновляем кнопку "Все" если она есть - ТЕПЕРЬ С ID
            const allFollowersButton = document.getElementById('allFollowersButton');
            if (allFollowersButton && followers) {
                const count = followers.length;
                allFollowersButton.textContent = `Все (${count})`;
            }
        }

        function showNotification(message, type) {
            const notification = document.createElement('div');
            notification.className = `fixed top-4 right-4 z-50 px-6 py-3 rounded-lg shadow-lg ${
                type === 'success' ? 'bg-green-500 text-white' : 'bg-red-500 text-white'
            }`;
            notification.textContent = message;
            document.body.appendChild(notification);

            setTimeout(() => {
                if (notification.parentNode) {
                    document.body.removeChild(notification);
                }
            }, 3000);
        }
    </script>
}