@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Получаем данные текущего пользователя
            const currentUserId = document.getElementById('currentUserId')?.value;
            const currentUserName = document.getElementById('currentUserName')?.value || 'Пользователь';
            const currentUserAvatar = document.getElementById('currentUserAvatar')?.value || '';

            // Управление вкладками
            const tabButtons = document.querySelectorAll('.tab-button');
            const tabPanels = document.querySelectorAll('.tab-panel');

            tabButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const tabId = this.getAttribute('data-tab');

                    // Обновляем активные элементы
                    tabButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');

                    tabPanels.forEach(panel => {
                        panel.classList.remove('active');
                        panel.classList.add('hidden');
                    });

                    const activePanel = document.getElementById(tabId + 'Tab');
                    if (activePanel) {
                        activePanel.classList.remove('hidden');
                        activePanel.classList.add('active');
                    }
                });
            });

            // Навигация для похожих книг
            const similarBooksContainer = document.querySelector('.similar-books-scroll-container');
            const similarBooksWrapper = document.querySelector('.similar-books-wrapper');
            const prevBtn = document.querySelector('.similar-books-nav.prev');
            const nextBtn = document.querySelector('.similar-books-nav.next');

            if (similarBooksContainer && similarBooksWrapper && prevBtn && nextBtn) {
                const scrollAmount = 300;

                prevBtn.addEventListener('click', () => {
                    similarBooksContainer.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                });

                nextBtn.addEventListener('click', () => {
                    similarBooksContainer.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                });

                function updateNavButtons() {
                    const { scrollLeft, scrollWidth, clientWidth } = similarBooksContainer;
                    prevBtn.style.display = scrollLeft > 0 ? 'flex' : 'none';
                    nextBtn.style.display = scrollLeft < scrollWidth - clientWidth - 10 ? 'flex' : 'none';
                }

                similarBooksContainer.addEventListener('scroll', updateNavButtons);
                window.addEventListener('resize', updateNavButtons);
                updateNavButtons();
            }

            // Счетчик символов в комментариях
            const commentText = document.getElementById('commentText');
            const charCount = document.getElementById('charCount');

            if (commentText && charCount) {
                commentText.addEventListener('input', function() {
                    const length = this.value.length;
                    charCount.textContent = `${length}/500`;

                    if (length > 500) {
                        charCount.classList.add('text-red-500');
                        this.classList.add('border-red-500');
                    } else {
                        charCount.classList.remove('text-red-500');
                        this.classList.remove('border-red-500');
                    }
                });
            }

            // Отправка комментария
            const commentForm = document.getElementById('commentForm');
            if (commentForm) {
                commentForm.addEventListener('submit', async function(e) {
                    e.preventDefault();

                    const commentTextValue = document.getElementById('commentText')?.value.trim();
                    const bookId = document.getElementById('bookId')?.value;

                    // Получаем токен из формы
                    const token = document.querySelector('#commentForm input[name="__RequestVerificationToken"]')?.value;

                    if (!commentTextValue) {
                        showToast('Введите текст комментария', 'error');
                        return;
                    }

                    if (commentTextValue.length > 500) {
                        showToast('Комментарий слишком длинный (макс. 500 символов)', 'error');
                        return;
                    }

                    try {
                        const response = await fetch('@Url.Action("AddBookComment", "Read")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'RequestVerificationToken': token
                            },
                            body: `id=${encodeURIComponent(bookId)}&commentText=${encodeURIComponent(commentTextValue)}`
                        });

                        if (!response.ok) {
                            throw new Error(`HTTP error! status: ${response.status}`);
                        }

                        const result = await response.json();

                        if (result.success && result.comment) {
                            // Добавляем новый комментарий в список
                            const commentsList = document.getElementById('commentsList');
                            const newCommentHTML = createCommentHTML(result.comment, currentUserId);

                            // Создаем временный контейнер для преобразования строки в DOM
                            const tempDiv = document.createElement('div');
                            tempDiv.innerHTML = newCommentHTML.trim();
                            const newCommentElement = tempDiv.firstChild;

                            // Убираем сообщение о пустых комментариях
                            const emptyState = commentsList.querySelector('.text-center');
                            if (emptyState) {
                                emptyState.remove();
                            }

                            // Добавляем комментарий в начало списка
                            commentsList.insertBefore(newCommentElement, commentsList.firstChild);

                            // Очищаем форму
                            if (commentText) {
                                commentText.value = '';
                                charCount.textContent = '0/500';
                                charCount.classList.remove('text-red-500');
                            }

                            showToast('Комментарий добавлен', 'success');
                        } else {
                            showToast(result.message || 'Ошибка при добавлении комментария', 'error');
                        }
                    } catch (error) {
                        console.error('Ошибка:', error);
                        showToast('Ошибка соединения', 'error');
                    }
                });
            }

            // Обработка действий с комментариями
            document.addEventListener('click', function(e) {
                // Удаление комментария
                if (e.target.closest('.delete-comment')) {
                    const button = e.target.closest('.delete-comment');
                    const commentId = button.getAttribute('data-comment-id');

                    if (confirm('Вы уверены, что хотите удалить этот комментарий?')) {
                        deleteComment(commentId, button);
                    }
                }

                // Редактирование комментария
                if (e.target.closest('.edit-comment')) {
                    const button = e.target.closest('.edit-comment');
                    const commentId = button.getAttribute('data-comment-id');
                    const currentText = button.getAttribute('data-comment-text');
                    editComment(commentId, currentText, button);
                }

                // Ответ на комментарий
                if (e.target.closest('.reply-comment')) {
                    const button = e.target.closest('.reply-comment');
                    const commentId = button.getAttribute('data-comment-id');
                    showReplyForm(commentId, button);
                }

                // Редактирование ответа
                if (e.target.closest('.edit-reply')) {
                    const button = e.target.closest('.edit-reply');
                    const replyId = button.getAttribute('data-reply-id');
                    const currentText = button.getAttribute('data-reply-text');
                    editReply(replyId, currentText, button);
                }

                // Удаление ответа
                if (e.target.closest('.delete-reply')) {
                    const button = e.target.closest('.delete-reply');
                    const replyId = button.getAttribute('data-reply-id');
                    deleteReply(replyId, button);
                }
            });
            
            // Добавьте обработчик для кнопки скачивания
            const downloadButton = document.getElementById('downloadButton');
            if (downloadButton) {
                downloadButton.addEventListener('click', function(e) {
                    e.preventDefault();

                    // Показываем модальное окно с подтверждением
                    if (confirm('Вы действительно хотите скачать книгу? Это может занять некоторое время в зависимости от размера книги.')) {
                        const bookId = this.getAttribute('data-book-id');

                        // Показываем индикатор загрузки
                        const originalText = this.innerHTML;
                        this.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Генерация PDF...';
                        this.disabled = true;

                        // Начинаем скачивание
                        window.location.href = this.href;

                        // Через 3 секунды возвращаем исходное состояние
                        setTimeout(() => {
                            this.innerHTML = originalText;
                            this.disabled = false;
                        }, 3000);
                    }
                });
            }
            
            // Лайки
            const likeButton = document.getElementById('likeButton');
            if (likeButton) {
                likeButton.addEventListener('click', async function() {
                    const bookId = this.getAttribute('data-book-id');
                    const isAuthor = this.getAttribute('data-is-author') === 'true';

                    if (isAuthor) {
                        showToast('Вы не можете ставить лайк своей книге', 'error');
                        return;
                    }

                    try {
                        const response = await fetch('@Url.Action("LikeBook", "Read")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: `id=${encodeURIComponent(bookId)}`
                        });

                        const result = await response.json();

                        if (result.success) {
                            // Обновляем UI
                            const likeCount = document.getElementById('likeCount');
                            if (likeCount) {
                                likeCount.textContent = result.likesCount;
                            }

                            // Обновляем счетчик в статистике
                            const likesCountStat = document.getElementById('likesCountStat');
                            if (likesCountStat) {
                                likesCountStat.textContent = result.likesCount;
                            }

                            if (result.hasLiked) {
                                this.classList.add('active');
                                const span = this.querySelector('span:not(.ml-2)');
                                if (span) span.textContent = 'Лайк';
                                showToast('Лайк добавлен', 'success');
                            } else {
                                this.classList.remove('active');
                                const span = this.querySelector('span:not(.ml-2)');
                                if (span) span.textContent = 'Нравится';
                                showToast('Лайк удален', 'info');
                            }
                        } else {
                            showToast(result.message || 'Ошибка', 'error');
                        }
                    } catch (error) {
                        console.error('Ошибка:', error);
                        showToast('Ошибка соединения', 'error');
                    }
                });
            }

            // Закладки
            const favoriteButton = document.getElementById('favoriteButton');
            if (favoriteButton) {
                favoriteButton.addEventListener('click', async function() {
                    const bookId = this.getAttribute('data-book-id');

                    try {
                        const response = await fetch('@Url.Action("ToggleFavorite", "Read")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: `id=${encodeURIComponent(bookId)}`
                        });

                        const result = await response.json();

                        if (result.success) {
                            if (result.isInFavorites) {
                                this.classList.add('active');
                                const span = this.querySelector('span');
                                if (span) span.textContent = 'В закладках';
                                showToast('Книга добавлена в закладки', 'success');
                            } else {
                                this.classList.remove('active');
                                const span = this.querySelector('span');
                                if (span) span.textContent = 'В закладки';
                                showToast('Книга удалена из закладок', 'info');
                            }
                        } else {
                            showToast(result.message || 'Ошибка', 'error');
                        }
                    } catch (error) {
                        console.error('Ошибка:', error);
                        showToast('Ошибка соединения', 'error');
                    }
                });
            }

            // Вспомогательные функции
            function createCommentHTML(comment, currentUserId) {
                const userInitial = comment.userName ? comment.userName[0].toUpperCase() : '?';
                const timestamp = new Date(comment.timestamp).toLocaleDateString('ru-RU', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });

                const isCurrentUser = comment.userId === currentUserId;

                return `
                    <div class="comment-item" data-comment-id="${comment.id}" style="opacity: 0; transform: translateX(-20px); animation: fadeIn 0.3s ease-out forwards;">
                        <div class="comment-avatar">
                            ${comment.userAvatar ?
                                `<img src="${comment.userAvatar}" alt="${comment.userName}" class="w-10 h-10 rounded-full object-cover">` :
                                `<span class="text-white font-semibold">${userInitial}</span>`
                            }
                        </div>
                        <div class="comment-content">
                            <div class="comment-header">
                                <div>
                                    <span class="comment-author">${escapeHtml(comment.userName || 'Пользователь')}</span>
                                    <span class="comment-time ml-2">${timestamp}</span>
                                </div>
                                ${isCurrentUser ? `
                                    <div class="flex gap-2">
                                        <button class="reply-comment text-blue-500 hover:text-blue-700 transition-colors"
                                                data-comment-id="${comment.id}"
                                                title="Ответить">
                                            <i class="fas fa-reply"></i>
                                        </button>
                                        <button class="edit-comment text-amber-500 hover:text-amber-700 transition-colors"
                                                data-comment-id="${comment.id}"
                                                data-comment-text="${escapeHtml(comment.content)}"
                                                title="Редактировать">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="delete-comment text-red-500 hover:text-red-700 transition-colors"
                                                data-comment-id="${comment.id}"
                                                title="Удалить комментарий">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                ` : ''}
                            </div>
                            <div class="comment-text mt-2">
                                ${escapeHtml(comment.content)}
                            </div>
                            <div class="replies-container ml-8 mt-4 space-y-4" data-comment-id="${comment.id}"></div>
                            <div class="reply-form-container mt-3 hidden" data-comment-id="${comment.id}"></div>
                        </div>
                    </div>
                `;
            }

            function createReplyHTML(replyData, isCurrentUser = false) {
                const userInitial = replyData.userName ? replyData.userName[0].toUpperCase() : '?';
                const timestamp = new Date(replyData.timestamp).toLocaleDateString('ru-RU', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                });

                return `
                    <div class="comment-item comment-reply" data-reply-id="${replyData.id}">
                        <div class="comment-avatar">
                            ${replyData.userAvatar ?
                                `<img src="${replyData.userAvatar}" alt="${replyData.userName}" class="w-8 h-8 rounded-full object-cover">` :
                                `<span class="text-white font-semibold text-sm">${userInitial}</span>`
                            }
                        </div>
                        <div class="comment-content">
                            <div class="comment-header">
                                <div>
                                    <span class="comment-author text-sm">${escapeHtml(replyData.userName || 'Пользователь')}</span>
                                    <span class="comment-time ml-2 text-xs">${timestamp}</span>
                                </div>
                                ${isCurrentUser ? `
                                    <div class="flex gap-2">
                                        <button class="edit-reply text-amber-500 hover:text-amber-700 transition-colors"
                                                data-reply-id="${replyData.id}"
                                                data-reply-text="${escapeHtml(replyData.content)}"
                                                title="Редактировать">
                                            <i class="fas fa-edit text-xs"></i>
                                        </button>
                                        <button class="delete-reply text-red-500 hover:text-red-700 transition-colors"
                                                data-reply-id="${replyData.id}"
                                                title="Удалить ответ">
                                            <i class="fas fa-trash text-xs"></i>
                                        </button>
                                    </div>
                                ` : ''}
                            </div>
                            <div class="comment-text mt-2 text-sm">
                                ${escapeHtml(replyData.content)}
                            </div>
                        </div>
                    </div>
                `;
            }

            async function deleteComment(commentId, button) {
                try {
                    const response = await fetch('@Url.Action("DeleteBookComment", "Read")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: `commentId=${encodeURIComponent(commentId)}`
                    });

                    const result = await response.json();

                    if (result.success) {
                        const commentElement = button.closest('.comment-item');
                        commentElement.style.opacity = '0';
                        commentElement.style.transform = 'translateX(-20px)';

                        setTimeout(() => {
                            commentElement.remove();

                            // Если комментариев не осталось, показываем сообщение
                            const commentsList = document.getElementById('commentsList');
                            if (commentsList.children.length === 0) {
                                commentsList.innerHTML = `
                                    <div class="text-center py-8">
                                        <div class="text-5xl text-[var(--accent-gold)] mb-4 opacity-50">
                                            <i class="fas fa-comment-slash"></i>
                                        </div>
                                        <p class="text-xl text-secondary-custom mb-2">Комментариев пока нет</p>
                                        <p class="text-sm text-secondary-custom">Будьте первым, кто оставит комментарий!</p>
                                    </div>
                                `;
                            }

                            showToast('Комментарий удален', 'success');
                        }, 300);
                    } else {
                        showToast(result.message || 'Ошибка при удалении комментария', 'error');
                    }
                } catch (error) {
                    console.error('Ошибка:', error);
                    showToast('Ошибка соединения', 'error');
                }
            }

            function showReplyForm(commentId, button) {
                const commentElement = document.querySelector(`[data-comment-id="${commentId}"]`);
                const replyFormContainer = commentElement.querySelector('.reply-form-container');

                if (replyFormContainer.classList.contains('hidden')) {
                    replyFormContainer.innerHTML = `
                        <form class="reply-form space-y-2">
                            <textarea class="w-full px-3 py-2 bg-[var(--bg-primary)] text-[var(--text-primary)]
                                         rounded border border-[var(--border-color)] focus:border-[var(--accent-gold)]
                                         focus:ring-1 focus:ring-[var(--accent-gold)] resize-none text-sm"
                                      rows="2"
                                      placeholder="Введите ответ..." required></textarea>
                            <div class="flex gap-2">
                                <button type="submit" class="gold-button text-sm px-3 py-1">
                                    <i class="fas fa-paper-plane mr-1"></i>Ответить
                                </button>
                                <button type="button" class="cancel-reply text-sm px-3 py-1 border border-[var(--border-color)] rounded hover:bg-[var(--border-color)]">
                                    Отмена
                                </button>
                            </div>
                        </form>
                    `;

                    replyFormContainer.classList.remove('hidden');

                    // Обработка отправки ответа
                    const replyForm = replyFormContainer.querySelector('.reply-form');
                    replyForm.addEventListener('submit', async function(e) {
                        e.preventDefault();
                        const replyText = this.querySelector('textarea').value.trim();

                        if (replyText) {
                            try {
                                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                                const response = await fetch('@Url.Action("AddReplyToComment", "Read")', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/x-www-form-urlencoded',
                                        'RequestVerificationToken': token
                                    },
                                    body: `commentId=${encodeURIComponent(commentId)}&replyText=${encodeURIComponent(replyText)}`
                                });

                                const result = await response.json();

                                if (result.success && result.reply) {
                                    // Находим или создаем контейнер для ответов
                                    let repliesContainer = commentElement.querySelector('.replies-container');
                                    if (!repliesContainer) {
                                        repliesContainer = document.createElement('div');
                                        repliesContainer.className = 'replies-container ml-8 mt-4 space-y-4';
                                        repliesContainer.setAttribute('data-comment-id', commentId);
                                        commentElement.querySelector('.comment-content').appendChild(repliesContainer);
                                    }

                                    // Создаем HTML ответа
                                    const replyHTML = createReplyHTML(result.reply, true);

                                    // Создаем DOM элемент из строки
                                    const tempDiv = document.createElement('div');
                                    tempDiv.innerHTML = replyHTML.trim();
                                    const replyElement = tempDiv.firstChild;

                                    // Добавляем ответ в контейнер
                                    repliesContainer.appendChild(replyElement);

                                    // Очищаем и скрываем форму
                                    this.querySelector('textarea').value = '';
                                    replyFormContainer.classList.add('hidden');

                                    showToast('Ответ добавлен', 'success');

                                    // Добавляем обработчики для кнопок редактирования и удаления
                                    const editButton = replyElement.querySelector('.edit-reply');
                                    const deleteButton = replyElement.querySelector('.delete-reply');

                                    if (editButton) {
                                        editButton.addEventListener('click', function() {
                                            const replyId = this.getAttribute('data-reply-id');
                                            const currentText = this.getAttribute('data-reply-text');
                                            editReply(replyId, currentText, this);
                                        });
                                    }

                                    if (deleteButton) {
                                        deleteButton.addEventListener('click', function() {
                                            const replyId = this.getAttribute('data-reply-id');
                                            deleteReply(replyId, this);
                                        });
                                    }
                                } else {
                                    showToast(result.message || 'Ошибка при добавлении ответа', 'error');
                                }
                            } catch (error) {
                                console.error('Ошибка:', error);
                                showToast('Ошибка соединения', 'error');
                            }
                        }
                    });

                    // Отмена ответа
                    replyFormContainer.querySelector('.cancel-reply').addEventListener('click', function() {
                        replyFormContainer.classList.add('hidden');
                        replyFormContainer.innerHTML = '';
                    });
                } else {
                    replyFormContainer.classList.add('hidden');
                    replyFormContainer.innerHTML = '';
                }
            }

            async function editComment(commentId, currentText, button) {
                const commentElement = document.querySelector(`[data-comment-id="${commentId}"]`);
                const commentTextElement = commentElement.querySelector('.comment-text');

                commentTextElement.innerHTML = `
                    <form class="edit-form">
                        <textarea class="w-full px-3 py-2 bg-[var(--bg-primary)] text-[var(--text-primary)]
                                     rounded border border-[var(--border-color)] focus:border-[var(--accent-gold)]
                                     focus:ring-1 focus:ring-[var(--accent-gold)] resize-none"
                                  rows="3" required>${escapeHtml(currentText)}</textarea>
                        <div class="flex gap-2 mt-2">
                            <button type="submit" class="gold-button text-sm px-3 py-1">
                                <i class="fas fa-save mr-1"></i>Сохранить
                            </button>
                            <button type="button" class="cancel-edit text-sm px-3 py-1 border border-[var(--border-color)] rounded hover:bg-[var(--border-color)]">
                                Отмена
                            </button>
                        </div>
                    </form>
                `;

                const editForm = commentTextElement.querySelector('.edit-form');
                editForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const newText = this.querySelector('textarea').value.trim();

                    if (newText && newText !== currentText) {
                        try {
                            // Отправляем запрос на обновление комментария
                            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                            const response = await fetch('@Url.Action("EditBookComment", "Read")', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded',
                                    'RequestVerificationToken': token
                                },
                                body: `commentId=${encodeURIComponent(commentId)}&commentText=${encodeURIComponent(newText)}`
                            });

                            const result = await response.json();

                            if (result.success) {
                                commentTextElement.textContent = newText;
                                button.setAttribute('data-comment-text', newText);
                                showToast('Комментарий отредактирован', 'success');
                            } else {
                                showToast(result.message || 'Ошибка при редактировании', 'error');
                                commentTextElement.textContent = currentText;
                            }
                        } catch (error) {
                            console.error('Ошибка:', error);
                            showToast('Ошибка соединения', 'error');
                            commentTextElement.textContent = currentText;
                        }
                    }
                });

                editForm.querySelector('.cancel-edit').addEventListener('click', function() {
                    commentTextElement.textContent = currentText;
                });
            }

            async function editReply(replyId, currentText, button) {
                const replyElement = button.closest('.comment-reply');
                const replyTextElement = replyElement.querySelector('.comment-text');

                const editForm = document.createElement('form');
                editForm.className = 'edit-reply-form';
                editForm.innerHTML = `
                    <textarea class="w-full px-3 py-2 bg-[var(--bg-primary)] text-[var(--text-primary)]
                                 rounded border border-[var(--border-color)] focus:border-[var(--accent-gold)]
                                 focus:ring-1 focus:ring-[var(--accent-gold)] resize-none text-sm"
                              rows="2" required>${escapeHtml(currentText)}</textarea>
                    <div class="flex gap-2 mt-2">
                        <button type="submit" class="gold-button text-xs px-3 py-1">
                            <i class="fas fa-save mr-1"></i>Сохранить
                        </button>
                        <button type="button" class="cancel-edit-reply text-xs px-3 py-1 border border-[var(--border-color)] rounded hover:bg-[var(--border-color)]">
                            Отмена
                        </button>
                    </div>
                `;

                replyTextElement.innerHTML = '';
                replyTextElement.appendChild(editForm);

                editForm.addEventListener('submit', async function(e) {
                    e.preventDefault();
                    const newText = this.querySelector('textarea').value.trim();

                    if (newText && newText !== currentText) {
                        try {
                            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                            const response = await fetch('@Url.Action("EditReply", "Read")', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded',
                                    'RequestVerificationToken': token
                                },
                                body: `replyId=${encodeURIComponent(replyId)}&replyText=${encodeURIComponent(newText)}`
                            });

                            const result = await response.json();

                            if (result.success) {
                                replyTextElement.textContent = newText;
                                button.setAttribute('data-reply-text', newText);
                                showToast('Ответ отредактирован', 'success');
                            } else {
                                showToast(result.message || 'Ошибка при редактировании', 'error');
                                replyTextElement.textContent = currentText;
                            }
                        } catch (error) {
                            console.error('Ошибка:', error);
                            showToast('Ошибка соединения', 'error');
                            replyTextElement.textContent = currentText;
                        }
                    }
                });

                editForm.querySelector('.cancel-edit-reply').addEventListener('click', function() {
                    replyTextElement.textContent = currentText;
                });
            }

            async function deleteReply(replyId, button) {
                if (confirm('Вы уверены, что хотите удалить этот ответ?')) {
                    try {
                        const response = await fetch('@Url.Action("DeleteReply", "Read")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            body: `replyId=${encodeURIComponent(replyId)}`
                        });

                        const result = await response.json();

                        if (result.success) {
                            const replyElement = button.closest('.comment-reply');
                            replyElement.style.opacity = '0';
                            replyElement.style.transform = 'translateX(-20px)';

                            setTimeout(() => {
                                replyElement.remove();
                                showToast('Ответ удален', 'success');
                            }, 300);
                        } else {
                            showToast(result.message || 'Ошибка при удалении ответа', 'error');
                        }
                    } catch (error) {
                        console.error('Ошибка:', error);
                        showToast('Ошибка соединения', 'error');
                    }
                }
            }

            function showToast(message, type = 'info') {
                // Создаем элемент тоста
                const toast = document.createElement('div');
                toast.className = `fixed bottom-4 right-4 z-50 px-4 py-3 rounded-lg shadow-lg
                                   transition-all duration-300 transform translate-x-full
                                   ${type === 'success' ? 'bg-green-500 text-white' :
                                     type === 'error' ? 'bg-red-500 text-white' :
                                     type === 'info' ? 'bg-blue-500 text-white' :
                                     'bg-[var(--accent-gold)] text-white'}`;

                // Создаем иконку
                const icon = document.createElement('i');
                icon.className = `fas fa-${type === 'success' ? 'check' : type === 'error' ? 'exclamation' : 'info-circle'} mr-2`;

                // Создаем текст
                const text = document.createElement('span');
                text.textContent = message;

                // Собираем тост
                const container = document.createElement('div');
                container.className = 'flex items-center gap-2';
                container.appendChild(icon);
                container.appendChild(text);
                toast.appendChild(container);

                // Добавляем тост на страницу
                document.body.appendChild(toast);

                // Анимация появления
                setTimeout(() => {
                    toast.style.transform = 'translateX(0)';
                }, 100);

                // Удаляем тост через 3 секунды
                setTimeout(() => {
                    toast.style.transform = 'translateX(100%)';
                    setTimeout(() => {
                        if (toast.parentNode) {
                            document.body.removeChild(toast);
                        }
                    }, 300);
                }, 3000);
            }

            function escapeHtml(unsafe) {
                if (!unsafe) return '';
                return unsafe
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }
        });
    </script>
}