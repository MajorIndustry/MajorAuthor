                                                        <span><i class="far fa-file-alt"></i> @book.Chapters?.Count(c => c.IsPublic) глав</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <a asp-controller="Read" asp-action="ReadBook" asp-route-id="@book.Id" class="block">
                                    <div class="cycle-book-card">
                                        <div class="flex items-start gap-4">
                                            <div class="flex-shrink-0">
                                                @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                                                {
                                                    <img src="@book.CoverImageUrl" alt="@book.Title"
                                                         class="w-20 h-28 object-cover rounded-lg">
                                                }
                                                else
                                                {
                                                    <div class="w-20 h-28 gradient-bg rounded-lg flex items-center justify-center">
                                                        <span class="text-white text-xl">📖</span>
                                                    </div>
                                                }
                                            </div>
                                            <div class="flex-1">
                                                <div class="flex items-start justify-between">
                                                    <div>
                                                        <h4 class="text-lg font-semibold text-theme-aware mb-1">
                                                            @book.Title
                                                        </h4>
                                                        <div class="flex flex-wrap items-center gap-2 mb-2">
                                                            @foreach (var author in book.BookAuthors.Take(2))
                                                            {
                                                                <a asp-controller="Profile" asp-action="UserProfile" asp-route-id="@author.Author.Id" class="author-name-gold text-sm">
                                                                    @author.Author.PenName
                                                                </a>
                                                            }
                                                        </div>
                                                        <div class="flex gap-4 text-sm text-secondary-custom">
                                                            <span><i class="far fa-eye"></i> @book.ReadsCount</span>
                                                            <span><i class="fas fa-heart text-red-500"></i> @book.LikesCount</span>
                                                            <span><i class="far fa-file-alt"></i> @book.Chapters?.Count(c => c.IsPublic) глав</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    private string GetReadingTime(int pageCount)
    {
        return Math.Max(1, (int)Math.Ceiling(pageCount * 1.0)).ToString();
    }
