﻿@using System.Security.Claims
@using MajorAuthor.Data.Entities
@model MajorAuthor.Models.BookReadViewModel
@{
    ViewData["Title"] = Model.Book.Title;
}

<div class="container mx-auto px-4 py-6 max-w-6xl">
    <!-- Верхняя часть с обложкой и основной информацией -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 mb-8">
        <!-- Обложка -->
        <div class="lg:col-span-1">
            @if (!string.IsNullOrEmpty(Model.Book.CoverImageUrl))
            {
                <div class="book-cover-container shadow-2xl rounded-xl overflow-hidden">
                    <img src="@Model.Book.CoverImageUrl" alt="@Model.Book.Title"
                         class="w-full h-auto object-cover hover:scale-105 transition-transform duration-300">
                </div>
            }
            else
            {
                <div class="book-cover-container gradient-bg rounded-xl h-80 flex items-center justify-center shadow-2xl">
                    <span class="text-7xl text-white">📚</span>
                </div>
            }
        </div>

        <!-- Основная информация -->
        <div class="lg:col-span-3">
            <!-- Заголовок и авторы -->
            <div class="mb-6">
                <h1 class="book-title-main text-4xl md:text-5xl font-bold gradient-text mb-4">@Model.Book.Title</h1>

                <!-- Авторы -->
                <div class="flex flex-wrap items-center gap-3 mb-4">
                    <span class="text-secondary-custom font-medium">Авторы:</span>
                    @foreach (var author in Model.Authors)
                    {
                        <a asp-controller="Profile" asp-action="UserProfile" asp-route-id="@author.Id"
                           class="author-name-gold inline-flex items-center gap-2 px-4 py-2 rounded-full transition-all duration-300 hover:scale-105 hover:shadow-lg">
                            <i class="fas fa-user-edit text-sm"></i>
                            <span class="font-semibold">@author.PenName</span>
                        </a>
                    }
                </div>
            </div>

            <!-- Статистика в ряд -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                <div class="stat-card">
                    <div class="stat-icon text-blue-500">
                        <i class="fas fa-eye text-2xl"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-number text-2xl font-bold">@Model.Book.ReadsCount</div>
                        <div class="stat-label text-sm text-secondary-custom">Просмотров</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon text-red-500">
                        <i class="fas fa-heart text-2xl"></i>
                    </div>
                    <div class="stat-content">
                        <div id="likesCountStat" class="stat-number text-2xl font-bold">@Model.Book.LikesCount</div>
                        <div class="stat-label text-sm text-secondary-custom">Лайков</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon text-green-500">
                        <i class="fas fa-comment text-2xl"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-number text-2xl font-bold">@Model.Comments.Count</div>
                        <div class="stat-label text-sm text-secondary-custom">Комментариев</div>
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon text-purple-500">
                        <i class="fas fa-book-open text-2xl"></i>
                    </div>
                    <div class="stat-content">
                        <div class="stat-number text-2xl font-bold">@Model.PublishedChapters.Count</div>
                        <div class="stat-label text-sm text-secondary-custom">Глав</div>
                    </div>
                </div>
            </div>

            <!-- Кнопки действий -->
            <div class="flex flex-wrap gap-4 mb-6">
                @if (Model.PublishedChapters.Any())
                {
                    <!-- Кнопка "Читать сначала" -->
                    <a asp-controller="Read" asp-action="ReadChapter"
                       asp-route-bookId="@Model.Book.Id" asp-route-chapterId="@Model.PublishedChapters.First().Id"
                       class="action-button read-from-start">
                        <i class="fas fa-play mr-2 text-lg"></i>
                        <span class="font-bold">Читать сначала</span>
                        <span class="ml-2 bg-white/20 px-2 py-1 rounded text-sm">@Model.PublishedChapters.Count глав</span>
                    </a>
                    
                    <!-- Кнопка "Продолжить чтение" -->
                    {
                        var continueChapter = Model.PublishedChapters.FirstOrDefault(c => c.Id == Model.ContinueReadingChapterId);
                        if (continueChapter != null && Model.HasReadingProgress)
                        {
                            <a asp-controller="Read" asp-action="ReadChapter"
                               asp-route-bookId="@Model.Book.Id" asp-route-chapterId="@continueChapter.Id"
                               class="action-button continue-button">
                                <i class="fas fa-forward mr-2 text-lg"></i>
                                <span class="font-bold">Продолжить чтение</span>
                                <span class="ml-2 bg-white/20 px-2 py-1 rounded text-sm">
                                    Глава @continueChapter.Order
                                    @if (Model.ReadChapterIds.Contains(continueChapter.Id))
                                    {
                                        <i class="fas fa-check ml-1 text-green-300"></i>
                                    }
                                </span>
                            </a>
                        }
                    }
                }

                <button id="likeButton"
                        data-book-id="@Model.Book.Id"
                        data-is-author="@Model.IsAuthor"
                        class="action-button like-button @(Model.HasLiked ? "active" : "") @(Model.IsAuthor ? "opacity-50 cursor-not-allowed" : "")"
                        @(Model.IsAuthor ? "disabled" : "")>
                    <i class="fas fa-heart mr-2 text-lg"></i>
                    <span class="font-bold">@(Model.HasLiked ? "Лайк" : "Нравится")</span>
                    <span id="likeCount" class="ml-2 bg-white/20 px-2 py-1 rounded font-bold">@Model.Book.LikesCount</span>
                </button>

                <button id="favoriteButton" data-book-id="@Model.Book.Id"
                        class="action-button favorite-button @(Model.IsInFavorites ? "active" : "")">
                    <i class="fas fa-bookmark mr-2 text-lg"></i>
                    <span class="font-bold">@(Model.IsInFavorites ? "В закладках" : "В закладки")</span>
                    @if (Model.IsInFavorites)
                    {
                        <span class="ml-2 bg-white/20 px-2 py-1 rounded text-sm">
                            <i class="fas fa-check"></i>
                        </span>
                    }
                </button>
                @if (Model.Book.AllowDownload && Model.PublishedChapters.Any())
                {
                    <a asp-controller="Read" asp-action="DownloadBook" asp-route-id="@Model.Book.Id"
                       class="action-button download-button" id="downloadButton">
                        <i class="fas fa-download mr-2 text-lg"></i>
                        <span class="font-bold">Скачать книгу</span>
                        <span class="ml-2 bg-white/20 px-2 py-1 rounded text-sm">
                            <i class="fas fa-file-pdf"></i> PDF
                        </span>
                    </a>
                }
            </div>

            <!-- Жанры и теги -->
            <div class="mb-6">
                <div class="flex flex-wrap items-center gap-2 mb-3">
                    <span class="text-secondary-custom font-medium mr-2">Жанры:</span>
                    @foreach (var genre in Model.Genres.Take(5))
                    {
                        <span class="genre-badge">
                            @genre.Name
                        </span>
                    }
                    @if (Model.Genres.Count > 5)
                    {
                        <span class="text-secondary-custom text-sm">+@(Model.Genres.Count - 5)</span>
                    }
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <span class="text-secondary-custom font-medium mr-2">Теги:</span>
                    @foreach (var tag in Model.Tags.Take(8))
                    {
                        <span class="tag-badge">
                            #@tag.Name
                        </span>
                    }
                    @if (Model.Tags.Count > 8)
                    {
                        <span class="text-secondary-custom text-sm">+@(Model.Tags.Count - 8)</span>
                    }
                </div>
            </div>

            <!-- Дополнительная информация -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm mb-6">
                <div class="info-item">
                    <i class="fas fa-calendar text-[var(--accent-gold)] mr-2"></i>
                    <span class="text-secondary-custom">Дата публикации:</span>
                    <span class="font-medium text-theme-aware ml-2">
                        @Model.Book.PublicationDate.ToString("dd.MM.yyyy")
                    </span>
                </div>
                <div class="info-item">
                    <i class="fas fa-book text-[var(--accent-gold)] mr-2"></i>
                    <span class="text-secondary-custom">Тип:</span>
                    <span class="font-medium text-theme-aware ml-2">
                        @Model.Book.Type?.Name
                    </span>
                </div>
                <div class="info-item">
                    <i class="fas fa-clock text-[var(--accent-gold)] mr-2"></i>
                    <span class="text-secondary-custom">Статус:</span>
                    <span class="font-medium text-theme-aware ml-2">
                        @Model.Book.Status?.Name
                    </span>
                </div>
                @if (Model.Book.IsAdultContent)
                {
                    <div class="info-item">
                        <i class="fas fa-exclamation-triangle text-red-500 mr-2"></i>
                        <span class="text-red-500 font-medium">Контент 18+</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Вкладки -->
    <div class="white-block">
        <div class="book-tabs mb-6" id="bookTabs">
            <button class="tab-button active" data-tab="main">
                <i class="fas fa-home mr-2"></i>Главная
            </button>

            <button class="tab-button" data-tab="chapters">
                <i class="fas fa-list-ol mr-2"></i>Главы
                <span class="ml-2 bg-blue-500 text-white text-xs rounded-full px-2 py-1">@Model.PublishedChapters.Count</span>
            </button>

            @if (Model.Cycle != null)
            {
                <button class="tab-button" data-tab="cycle">
                    <i class="fas fa-infinity mr-2"></i>Цикл
                    <span class="ml-2 bg-purple-500 text-white text-xs rounded-full px-2 py-1">@(Model.CycleBooks.Count + 1)</span>
                </button>
            }
        </div>

        <!-- Контент вкладок -->
        <div id="tabContent">
            <!-- Вкладка "Главная" -->
            <div id="mainTab" class="tab-panel active">
                <!-- Описание книги -->
                @if (!string.IsNullOrEmpty(Model.Book.Description))
                {
                    <div class="white-block mb-8">
                        <h3 class="text-xl font-bold mb-4 text-[var(--auth-block-text)]">Описание</h3>
                        <div class="text-[var(--auth-block-text)] leading-relaxed whitespace-pre-line">
                            @Model.Book.Description
                        </div>
                    </div>
                }

                <!-- Похожие книги -->
                <div class="mb-8">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-2xl font-bold text-[var(--auth-block-text)]">Похожие книги</h3>
                        <span class="text-secondary-custom text-sm">@Model.SimilarBooks.Count найдено</span>
                    </div>

                    @if (Model.SimilarBooks.Any())
                    {
                        <div class="relative">
                            <div class="similar-books-scroll-container">
                                <div class="similar-books-wrapper">
                                    @foreach (var book in Model.SimilarBooks)
                                    {
                                        <div class="similar-book-card">
                                            <a asp-controller="Read" asp-action="ReadBook" asp-route-id="@book.Id" class="block">
                                                @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                                                {
                                                    <div class="similar-book-cover">
                                                        <img src="@book.CoverImageUrl" alt="@book.Title"
                                                             class="w-full h-48 object-cover rounded-lg mb-3">
                                                        <div class="similar-book-overlay">
                                                            <span class="read-more">Читать</span>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="w-full h-48 gradient-bg rounded-lg flex items-center justify-center mb-3">
                                                        <span class="text-3xl text-white">📖</span>
                                                    </div>
                                                }
                                                <h4 class="font-semibold text-[var(--auth-block-text)] mb-2 truncate" title="@book.Title">
                                                    @book.Title
                                                </h4>
                                                <div class="text-sm text-secondary-custom mb-2 truncate">
                                                    @string.Join(", ", book.BookAuthors.Take(2).Select(ba => ba.Author.PenName))
                                                </div>
                                                <div class="flex justify-between text-xs text-secondary-custom">
                                                    <span><i class="far fa-eye"></i> @book.ReadsCount</span>
                                                    <span><i class="fas fa-heart text-red-500"></i> @book.LikesCount</span>
                                                    <span><i class="fas fa-book-open"></i> @book.Chapters.Count(c => c.IsPublic)</span>
                                                </div>
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Кнопки навигации для скролла -->
                            <button class="similar-books-nav prev hidden md:flex">
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <button class="similar-books-nav next hidden md:flex">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="white-block text-center py-8">
                            <div class="text-5xl text-[var(--accent-gold)] mb-4 opacity-50">
                                <i class="fas fa-book"></i>
                            </div>
                            <p class="text-xl text-secondary-custom mb-2">Похожих книг не найдено</p>
                            <p class="text-sm text-secondary-custom">Система рекомендаций еще изучает ваши предпочтения</p>
                        </div>
                    }
                </div>

                <!-- Комментарии -->
                <div class="white-block">
                    <h3 class="text-2xl font-bold mb-6 text-[var(--auth-block-text)] border-b border-[var(--border-color)] pb-3">Комментарии</h3>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="comment-form-container mb-8">
                            <form id="commentForm" class="space-y-4">
                                @Html.AntiForgeryToken()
                                <input type="hidden" id="bookId" value="@Model.Book.Id" />
                                <textarea id="commentText"
                                      class="w-full px-4 py-3 bg-[var(--bg-primary)] text-[var(--text-primary)]
                                                 rounded-lg border border-[var(--border-color)] focus:border-[var(--accent-gold)]
                                                 focus:ring-2 focus:ring-[var(--accent-gold)] focus:ring-opacity-50 resize-none"
                                      rows="3"
                                      placeholder="Напишите ваш комментарий... (максимум 500 символов)"></textarea>
                                <div class="flex justify-between items-center">
                                    <div id="charCount" class="text-sm text-secondary-custom">0/500</div>
                                    <button type="submit"
                                            class="gold-button px-6 py-2">
                                        <i class="fas fa-paper-plane mr-2"></i>Отправить
                                    </button>
                                </div>
                            </form>
                        </div>

                        <input type="hidden" id="currentUserId" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" />
                        <input type="hidden" id="currentUserName" value="@User.Identity.Name" />
                        <input type="hidden" id="currentUserAvatar" value="@(User.FindFirstValue("AvatarUrl") ?? "")" />
                    }
                    else
                    {
                        <div class="mb-6 p-4 bg-yellow-50 dark:bg-yellow-900/20 rounded-lg border border-yellow-200 dark:border-yellow-800">
                            <p class="text-center text-secondary-custom">
                                <a asp-controller="Account" asp-action="Login"
                                   class="text-[var(--accent-gold)] hover:underline font-medium">
                                    Войдите
                                </a>, чтобы оставлять комментарии
                            </p>
                        </div>
                    }

                    <!-- Список комментариев -->
                    <div id="commentsList" class="space-y-6">
                        @if (Model.Comments.Any())
                        {
                            @foreach (var comment in Model.Comments)
                            {
                                <div class="comment-item" data-comment-id="@comment.Id">
                                    <div class="comment-avatar">
                                        @if (!string.IsNullOrEmpty(comment.UserAvatar))
                                        {
                                            <img src="@comment.UserAvatar" alt="@comment.UserName"
                                                 class="w-10 h-10 rounded-full object-cover">
                                        }
                                        else
                                        {
                                            <span class="text-white font-semibold">@(comment.UserName?[0].ToString().ToUpper() ?? "?")</span>
                                        }
                                    </div>
                                    <div class="comment-content">
                                        <div class="comment-header">
                                            <div>
                                                <span class="comment-author">@comment.UserName</span>
                                                <span class="comment-time ml-2">
                                                    @comment.Timestamp.ToString("dd.MM.yyyy HH:mm")
                                                </span>
                                            </div>
                                            @if (comment.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                                            {
                                                <div class="flex gap-2">
                                                    <button class="reply-comment text-blue-500 hover:text-blue-700 transition-colors"
                                                            data-comment-id="@comment.Id"
                                                            title="Ответить">
                                                        <i class="fas fa-reply"></i>
                                                    </button>
                                                    <button class="edit-comment text-amber-500 hover:text-amber-700 transition-colors"
                                                            data-comment-id="@comment.Id"
                                                            data-comment-text="@comment.Content"
                                                            title="Редактировать">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="delete-comment text-red-500 hover:text-red-700 transition-colors"
                                                            data-comment-id="@comment.Id"
                                                            title="Удалить комментарий">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                        <div class="comment-text mt-2">
                                            @comment.Content
                                        </div>

                                        <!-- Ответы на комментарий -->
                                        <div class="replies-container ml-8 mt-4 space-y-4" data-comment-id="@comment.Id">
                                            @foreach (var reply in comment.Replies ?? new List<CommentViewModel>())
                                            {
                                                <div class="comment-item comment-reply" data-reply-id="@reply.Id">
                                                    <div class="comment-avatar">
                                                        @if (!string.IsNullOrEmpty(reply.UserAvatar))
                                                        {
                                                            <img src="@reply.UserAvatar" alt="@reply.UserName"
                                                                 class="w-8 h-8 rounded-full object-cover">
                                                        }
                                                        else
                                                        {
                                                            <span class="text-white font-semibold text-sm">@(reply.UserName?[0].ToString().ToUpper() ?? "?")</span>
                                                        }
                                                    </div>
                                                    <div class="comment-content">
                                                        <div class="comment-header">
                                                            <div>
                                                                <span class="comment-author text-sm">@reply.UserName</span>
                                                                <span class="comment-time ml-2 text-xs">
                                                                    @reply.Timestamp.ToString("dd.MM.yyyy HH:mm")
                                                                </span>
                                                            </div>
                                                            @if (reply.UserId == User.FindFirstValue(ClaimTypes.NameIdentifier))
                                                            {
                                                                <div class="flex gap-2">
                                                                    <button class="edit-reply text-amber-500 hover:text-amber-700 transition-colors"
                                                                            data-reply-id="@reply.Id"
                                                                            data-reply-text="@reply.Content"
                                                                            title="Редактировать">
                                                                        <i class="fas fa-edit text-xs"></i>
                                                                    </button>
                                                                    <button class="delete-reply text-red-500 hover:text-red-700 transition-colors"
                                                                            data-reply-id="@reply.Id"
                                                                            title="Удалить ответ">
                                                                        <i class="fas fa-trash text-xs"></i>
                                                                    </button>
                                                                </div>
                                                            }
                                                        </div>
                                                        <div class="comment-text mt-2 text-sm">
                                                            @reply.Content
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <div class="reply-form-container mt-3 hidden" data-comment-id="@comment.Id">
                                            <!-- Форма ответа будет здесь -->
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-8">
                                <div class="text-5xl text-[var(--accent-gold)] mb-4 opacity-50">
                                    <i class="fas fa-comment-slash"></i>
                                </div>
                                <p class="text-xl text-secondary-custom mb-2">Комментариев пока нет</p>
                                <p class="text-sm text-secondary-custom">Будьте первым, кто оставит комментарий!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Вкладка "Главы" -->
            <div id="chaptersTab" class="tab-panel hidden">
                @if (Model.PublishedChapters.Any())
                {
                    <div class="grid grid-cols-1 gap-4">
                        @foreach (var chapter in Model.PublishedChapters.OrderBy(c => c.Order))
                        {
                            var isRead = Model.ReadChapterIds.Contains(chapter.Id);
                            
                            <div class="chapter-card @(isRead ? "read-chapter" : "")">
                                <div class="flex justify-between items-center mb-3">
                                    <div class="chapter-order-badge">
                                        Глава @chapter.Order
                                    </div>
                                    @if (isRead)
                                    {
                                        <div class="read-status">
                                            <i class="fas fa-check-circle text-green-500 text-xl"></i>
                                            <span class="text-green-500 text-sm font-medium ml-1">Прочитано</span>
                                        </div>
                                    }
                                </div>
                                <h3 class="chapter-title text-lg font-semibold mb-2 truncate text-theme-aware" title="@chapter.Title">
                                    @chapter.Title
                                </h3>
                                <div class="chapter-meta text-sm text-secondary-custom mb-4">
                                    <div class="flex flex-wrap gap-3">
                                        <span><i class="far fa-calendar mr-1"></i>@chapter.PublicationDate.ToString("dd.MM.yyyy")</span>
                                        <span><i class="far fa-file-alt mr-1"></i>@chapter.Pages.Count стр.</span>
                                        <span><i class="far fa-clock mr-1"></i>@GetReadingTime(chapter.Pages.Count) мин</span>
                                    </div>
                                </div>
                                <a asp-controller="Read" asp-action="ReadChapter" 
                                   asp-route-bookId="@Model.Book.Id" asp-route-chapterId="@chapter.Id"
                                   class="gold-button w-full text-center justify-center @(isRead ? "read-chapter-button" : "")">
                                    <i class="fas fa-book-open mr-2"></i>
                                    @(isRead ? "Перечитать" : "Читать")
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-12">
                        <div class="text-5xl text-[var(--accent-gold)] mb-4 opacity-50">
                            <i class="fas fa-book-open"></i>
                        </div>
                        <p class="text-xl text-secondary-custom mb-2">Главы еще не опубликованы</p>
                        <p class="text-sm text-secondary-custom">Автор еще работает над произведением</p>
                    </div>
                }
            </div>

            <!-- Вкладка "Цикл" -->
            @if (Model.Cycle != null)
            {
                <div id="cycleTab" class="tab-panel hidden">
                    <div class="mb-8">
                        <h3 class="text-2xl font-bold mb-2 text-[var(--auth-block-text)]">@Model.Cycle.Name</h3>
                        <p class="text-secondary-custom mb-6">
                            Цикл создан <span class="author-name-gold font-semibold">@Model.Cycle.Author.PenName</span>
                        </p>
                    </div>

                    <div class="space-y-6">
                        @{
                            var allCycleBooks = new List<Book> { Model.Book };
                            allCycleBooks.AddRange(Model.CycleBooks.OrderBy(b => b.PublicationDate));
                        }

                        @foreach (var book in allCycleBooks)
                        {
                            if (book.Id == Model.Book.Id)
                            {
                                <div class="cycle-book-card current-book">
                                    <div class="flex items-start gap-4">
                                        <div class="flex-shrink-0">
