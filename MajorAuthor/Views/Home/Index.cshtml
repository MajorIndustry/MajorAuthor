@model MajorAuthor.Models.HomeViewModel
@using MajorAuthor.Data
@using Microsoft.AspNetCore.Identity
@using MajorAuthor.Data.Entities
@inject UserManager<ApplicationUser> UserManager
@inject MajorAuthorDbContext DbContext
@{
    ViewData["Title"] = "Главная";
    var currentUser = await UserManager.GetUserAsync(User);
    var isAuthor = false;

    if (currentUser != null)
    {
        await DbContext.Entry(currentUser)
            .Reference(u => u.AuthorProfile)
            .LoadAsync();
        isAuthor = currentUser.AuthorProfile != null;
    }

    // Функция для получения случайных книг
    var random = new Random();
    var promotedBooks = Model.PromotedBooks?.Where(b => b.IsPublic).OrderBy(x => random.Next()).Take(5).ToList() ?? new List<HomeViewModel.BookDisplayModel>();
}

<div class="min-h-screen bg-gradient-to-br from-[var(--bg-primary)] to-[var(--bg-secondary)]">
    <!-- Hero Section -->
    <section class="relative py-12 sm:py-16 lg:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-[var(--text-primary)] mb-6">
                Добро пожаловать в
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--accent-gold)] to-[var(--accent-light)]">
                    MajorAuthor
                </span>
            </h1>
            <p class="text-xl sm:text-2xl text-[var(--text-primary)] max-w-3xl mx-auto mb-8">
                Платформа для авторов и читателей. Откройте для себя уникальные произведения,
                находите талантливых авторов и делитесь своим творчеством.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <a href="#popular" class="auth-btn-primary px-8 py-3 text-lg">
                    <i class="fas fa-fire mr-2"></i>Популярное
                </a>
                <a href="#new" class="auth-btn-secondary px-8 py-3 text-lg">
                    <i class="fas fa-star mr-2"></i>Новинки
                </a>
            </div>
        </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Popular Books Section -->
        <section id="popular" class="mb-12">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)] flex items-center">
                    <i class="fas fa-fire text-[var(--accent-gold)] mr-3"></i>
                    Популярные книги
                </h2>
                <div class="flex space-x-2">
                    <button class="rating-period-btn active" data-period="all">Все время</button>
                    <button class="rating-period-btn" data-period="week">За неделю</button>
                    <button class="rating-period-btn" data-period="month">За месяц</button>
                    <button class="rating-period-btn" data-period="year">За год</button>
                </div>
            </div>

            <!-- Все время -->
            <div class="rating-period-content active" id="rating-period-all">
                @if (Model.PopularBooks != null && Model.PopularBooks.Any(b => b.IsPublic))
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-8">
                        @{
                            var popularBooks = Model.PopularBooks.Where(b => b.IsPublic).Take(8).ToList();
                        }
                        @foreach (var book in popularBooks)
                        {
                            <div class="white-block group cursor-pointer transform transition-all duration-300 hover:scale-105 hover:shadow-xl book-item"
                                 data-href="@Url.Action("ReadBook", "Read", new { id = book.Id })">
                                <div class="relative overflow-hidden rounded-t-xl">
                                    @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                                    {
                                        <img src="@book.CoverImageUrl" alt="Обложка книги"
                                             class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-110"
                                             onerror="handleImgError(this)">
                                    }
                                    else
                                    {
                                        <div class="w-full h-48 bg-gradient-to-br from-[var(--border-color)] to-gray-300 flex items-center justify-center">
                                            <i class="fas fa-book text-4xl text-secondary-custom opacity-50"></i>
                                        </div>
                                    }
                                    @if (book.IsAdultContent)
                                    {
                                        <span class="absolute top-2 left-2 bg-red-500 text-white text-xs px-2 py-1 rounded-full font-bold">18+</span>
                                    }
                                    <div class="absolute top-2 right-2 bg-[var(--accent-gold)] text-white text-xs px-2 py-1 rounded-full font-bold shadow-lg flex items-center">
                                        <i class="fas fa-star mr-1"></i>@book.Rating.ToString("0.0")
                                    </div>
                                    <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-4">
                                        <div class="flex justify-between items-end text-white">
                                            <div>
                                                <div class="flex items-center text-sm">
                                                    <i class="fas fa-eye mr-1"></i>
                                                    <span>@book.ReadsCount.ToString("N0")</span>
                                                </div>
                                                <div class="flex items-center text-sm mt-1">
                                                    <i class="fas fa-heart mr-1 text-red-400"></i>
                                                    <span>@book.LikesCount.ToString("N0")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="p-4">
                                    <h3 class="font-semibold text-lg text-[var(--auth-block-text)] line-clamp-2 mb-2 group-hover:text-[var(--accent-gold)] transition-colors">
                                        @book.Title
                                    </h3>

                                    <!-- Авторы -->
                                    @if (book.Authors != null && book.Authors.Any())
                                    {
                                        <div class="flex flex-wrap gap-1 mb-3">
                                            @foreach (var author in book.Authors.Take(3))
                                            {
                                                <span class="text-xs author-badge px-2 py-1 rounded-full">
                                                    @author
                                                </span>
                                            }
                                            @if (book.Authors.Count > 3)
                                            {
                                                <span class="text-xs bg-gray-500 bg-opacity-20 text-gray-500 px-2 py-1 rounded-full">
                                                    +@(book.Authors.Count - 3)
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex flex-wrap gap-1 mb-3">
                                            <span class="text-xs author-badge px-2 py-1 rounded-full">
                                                @book.AuthorName
                                            </span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(book.Description))
                                    {
                                        <p class="text-sm text-[var(--auth-block-text)] opacity-90 line-clamp-2 mb-3">
                                            @book.Description
                                        </p>
                                    }

                                    <!-- Жанры с белым текстом -->
                                    <div class="flex flex-wrap gap-1 mb-3">
                                        @foreach (var genre in book.Genres.Take(3))
                                        {
                                            <span class="text-xs genre-badge px-2 py-1 rounded-full">
                                                @genre
                                            </span>
                                        }
                                        @if (book.Genres.Count > 3)
                                        {
                                            <span class="text-xs bg-gray-500 bg-opacity-20 text-gray-500 px-2 py-1 rounded-full">
                                                +@(book.Genres.Count - 3)
                                            </span>
                                        }
                                    </div>

                                    <!-- Теги с темно-желтым текстом -->
                                    @if (book.Tags != null && book.Tags.Any())
                                    {
                                        <div class="flex flex-wrap gap-1 mb-3">
                                            @foreach (var tag in book.Tags.Take(3))
                                            {
                                                <span class="text-xs tag-badge px-2 py-1 rounded-full">
                                                    #@tag.TrimStart('#')
                                                </span>
                                            }
                                            @if (book.Tags.Count > 3)
                                            {
                                                <span class="text-xs bg-gray-500 bg-opacity-20 text-gray-500 px-2 py-1 rounded-full">
                                                    +@(book.Tags.Count - 3)
                                                </span>
                                            }
                                        </div>
                                    }

                                    <div class="flex items-center justify-between text-xs text-[var(--auth-block-text)] opacity-70 mt-3 pt-3 border-t border-[var(--auth-block-border)]">
                                        <span class="content-type-badge">
                                            <i class="fas fa-book"></i>Книга
                                        </span>
                                        <span>@book.PublicationDate.ToString("dd.MM.yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="white-block text-center py-12">
                        <i class="fas fa-book text-4xl text-[var(--auth-block-text)] opacity-70 mb-4"></i>
                        <p class="text-[var(--auth-block-text)]">Популярные книги появятся здесь</p>
                        <p class="text-sm text-[var(--auth-block-text)] opacity-70 mt-2">Читайте и оценивайте произведения</p>
                    </div>
                }
            </div>

