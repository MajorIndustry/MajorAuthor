@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // =======================================================
            // 1. ЛОГИКА ПЕРЕКЛЮЧЕНИЯ ПЕРИОДОВ ДЛЯ КНИГ
            // =======================================================
            document.querySelectorAll('.rating-period-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const period = this.getAttribute('data-period');

                    // Remove active class from all buttons and contents
                    document.querySelectorAll('.rating-period-btn').forEach(btn => btn.classList.remove('active'));
                    document.querySelectorAll('.rating-period-content').forEach(content => content.classList.remove('active'));

                    // Add active class to clicked button and corresponding content
                    this.classList.add('active');
                    const periodContent = document.getElementById(`rating-period-${period}`);
                    if (periodContent) {
                        periodContent.classList.add('active');
                    }
                });
            });

            // =======================================================
            // 2. ЛОГИКА ПЕРЕКЛЮЧЕНИЯ ПЕРИОДОВ ДЛЯ СТИХОВ
            // =======================================================
            document.querySelectorAll('.poem-rating-period-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const period = this.getAttribute('data-period');

                    // Remove active class from all buttons and contents
                    document.querySelectorAll('.poem-rating-period-btn').forEach(btn => btn.classList.remove('active'));
                    document.querySelectorAll('.poem-rating-period-content').forEach(content => content.classList.remove('active'));

                    // Add active class to clicked button and corresponding content
                    this.classList.add('active');
                    const contentElement = document.getElementById(`poem-rating-period-${period.replace('poems-', '')}`);
                    if (contentElement) {
                        contentElement.classList.add('active');
                    }
                });
            });

            // =======================================================
            // 3. ЛОГИКА ПЕРЕКЛЮЧЕНИЯ ТАБОВ
            // =======================================================
            document.querySelectorAll('.tab-button').forEach(button => {
                button.addEventListener('click', function () {
                    const tabId = this.getAttribute('data-tab');

                    // Remove active class from all buttons and contents
                    document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
                    document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

                    // Add active class to clicked button and corresponding content
                    this.classList.add('active');
                    const tabContent = document.getElementById(`tab-${tabId}`);
                    if (tabContent) {
                        tabContent.classList.add('active');
                    }
                });
            });

            // =======================================================
            // 4. ПОСЛЕДОВАТЕЛЬНАЯ АНИМАЦИЯ ПОЯВЛЕНИЯ ВСЕХ ЭЛЕМЕНТОВ
            // =======================================================
            function startSequentialAnimation() {
                const allBlocks = document.querySelectorAll('.white-block');
                let delay = 0;

                allBlocks.forEach((block, index) => {
                    // Устанавливаем задержку для каждого блока
                    setTimeout(() => {
                        block.classList.add('animate-fade-in-up');
                    }, delay);

                    // Увеличиваем задержку для следующего блока
                    delay += 100; // 100ms между анимациями
                });
            }

            // Запускаем анимацию после полной загрузки страницы
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', startSequentialAnimation);
            } else {
                // DOM уже готов
                setTimeout(startSequentialAnimation, 300);
            }

            // =======================================================
            // 5. SMOOTH SCROLLING FOR ANCHOR LINKS
            // =======================================================
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });

            // =======================================================
            // 6. ФИКС ДЛЯ ИСЧЕЗАЮЩИХ ЭЛЕМЕНТОВ
            // =======================================================
            function fixDisappearingElements() {
                // Принудительно перезапускаем анимацию для всех элементов
                const allItems = document.querySelectorAll('.book-item, .poem-item, .blog-item, .author-item, .new-item');

                allItems.forEach(item => {
                    // Сбрасываем анимацию
                    item.style.animation = 'none';
                    item.offsetHeight; // Trigger reflow
                    item.style.animation = null;

                    // Убеждаемся, что элемент видим
                    item.style.opacity = '1';
                    item.style.visibility = 'visible';
                    item.style.transform = 'translateY(0)';
                });
            }

            // Запускаем фикс после загрузки и при изменении размера окна
            window.addEventListener('load', fixDisappearingElements);
            window.addEventListener('resize', fixDisappearingElements);

            // Также запускаем фикс при переключении вкладок
            document.querySelectorAll('.tab-button, .rating-period-btn, .poem-rating-period-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    setTimeout(fixDisappearingElements, 100);
                });
            });

            // =====================================================
            // 7. ПРИКРЕПЛЕНИЕ ОБОЖЕК К КНИГАМ И УПРАВЛЕНИЕ КЛИКАМИ
            // =====================================================
            document.querySelectorAll('.book-item').forEach(item => {
                if (!item.dataset.bound) {
                    item.addEventListener('click', function(e) {
                        // игнорировать клики на интерактивные дочерние элементы
                        const tag = e.target.tagName.toLowerCase();
                        if (['button','a','input','label'].includes(tag) || e.target.closest('button, a')) return;
                        const href = this.getAttribute('data-href');
                        if (href) window.location.href = href;
                    });
                    item.dataset.bound = 'true';
                }
            });

            // Обработчик ошибок изображений для резервного покрытия
            window.handleImgError = function(img) {
                try {
                    img.onerror = null;
                    const parent = img.parentElement;
                    if (!parent) return;
                    const fallback = document.createElement('div');
                    fallback.className = 'w-full h-48 bg-gradient-to-br from-[var(--border-color)] to-gray-300 flex items-center justify-center';
                    fallback.innerHTML = '<i class="fas fa-book text-4xl text-secondary-custom opacity-50"></i>';
                    parent.replaceChild(fallback, img);
                } catch (e) { /* игнорировать */ }
            };
        });
    </script>
}