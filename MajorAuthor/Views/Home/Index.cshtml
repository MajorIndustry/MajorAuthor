                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="white-block text-center py-8">
                        <i class="fas fa-magic text-3xl text-[var(--auth-block-text)] opacity-70 mb-3"></i>
                        <p class="text-[var(--auth-block-text)]">Рекомендации появятся после оценки произведений</p>
                        <p class="text-sm text-[var(--auth-block-text)] opacity-70 mt-2">Читайте и оценивайте книги, чтобы получать персонализированные рекомендации</p>
                    </div>
                }
            </section>
        }
    </div>
</div>

