@model MajorAuthor.ViewModels.NotificationListViewModel

@{
    ViewData["Title"] = "Уведомления";
}

<style>
    .notification-header-gold {
        background: linear-gradient(135deg, #A7885F, #C09A6B);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-shadow: 0 2px 4px rgba(167, 136, 95, 0.3);
        font-weight: 700;
        letter-spacing: 0.5px;
    }

    body.dark-theme .notification-header-gold {
        background: linear-gradient(135deg, #FFD700, #B8860B);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .notification-item {
        transition: all 0.3s ease;
        border-left: 3px solid transparent;
        position: relative;
    }

        .notification-item.unread {
            border-left-color: var(--accent-gold);
            background: linear-gradient(90deg, rgba(var(--accent-gold-rgb), 0.05), transparent);
        }

        .notification-item:hover {
            transform: translateX(2px);
        }

        .notification-item.selected {
            background: linear-gradient(90deg, rgba(59, 130, 246, 0.1), transparent);
            border-left-color: #3b82f6;
        }

    .notification-type-badge {
        background: linear-gradient(135deg, var(--accent-gold), var(--accent-light));
        color: var(--header-bg);
        padding: 0.2rem 0.6rem;
        border-radius: 12px;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .notification-time {
        color: var(--text-secondary);
        font-size: 0.8rem;
    }

    .notification-message {
        color: var(--text-primary);
        line-height: 1.4;
    }

    .notification-empty-state {
        text-align: center;
        padding: 3rem 2rem;
    }

    .notification-empty-icon {
        font-size: 4rem;
        background: linear-gradient(135deg, var(--accent-gold), var(--accent-light));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 1rem;
    }

    .gold-button {
        background: linear-gradient(135deg, var(--accent-gold), var(--accent-light));
        color: var(--header-bg);
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

        .gold-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(var(--accent-gold-rgb), 0.3);
            color: var(--header-bg);
        }

    /* Контекстное меню */
    .context-menu {
        position: fixed;
        background: var(--auth-block-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        z-index: 1000;
        min-width: 180px;
        display: none;
        overflow: hidden;
    }

    .context-menu-item {
        padding: 0.75rem 1rem;
        cursor: pointer;
        transition: all 0.2s ease;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

        .context-menu-item:last-child {
            border-bottom: none;
        }

        .context-menu-item:hover {
            background: var(--border-color);
        }

        .context-menu-item.delete {
            color: #ef4444;
        }

            .context-menu-item.delete:hover {
                background: #fef2f2;
                color: #dc2626;
            }

    body.dark-theme .context-menu-item.delete:hover {
        background: #7f1d1d;
        color: #fca5a5;
    }

    /* Анимации */
    @@keyframes slideInNotification {
        from {
            opacity: 0;
            transform: translateX(-20px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .notification-slide-in {
        animation: slideInNotification 0.3s ease-out;
    }

    .fade-out {
        animation: fadeOut 0.3s ease-out forwards;
    }

    @@keyframes fadeOut {
        from {
            opacity: 1;
            transform: scale(1);
        }

        to {
            opacity: 0;
            transform: scale(0.8);
        }
    }

    /* Массовые действия */
    .bulk-actions {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        background: var(--auth-block-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 1rem 1.5rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        z-index: 100;
        display: none;
        align-items: center;
        gap: 1rem;
        backdrop-filter: blur(10px);
    }

        .bulk-actions.show {
            display: flex;
            animation: slideUp 0.3s ease-out;
        }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateX(-50%) translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
    }

    .selection-count {
        font-weight: 600;
        color: var(--accent-gold);
    }

    /* Чекбокс выбора */
    .notification-checkbox {
        position: absolute;
        left: -10px;
        top: 50%;
        transform: translateY(-50%) scale(0);
        transition: all 0.3s ease;
        z-index: 10;
    }

    .selection-mode .notification-checkbox {
        transform: translateY(-50%) scale(1);
    }

    .notification-item:hover .notification-checkbox {
        transform: translateY(-50%) scale(1);
    }
</style>

<div class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Заголовок -->
    <div class="text-center mb-8">
        <h1 class="text-4xl font-bold notification-header-gold mb-2">
            <i class="fas fa-bell mr-3"></i>УВЕДОМЛЕНИЯ
        </h1>
        <p class="text-gray-600 dark:text-gray-400">Управляйте своими уведомлениями</p>
    </div>

    <!-- Панель управления -->
    <div class="white-block mb-6">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-4">
                @if (Model.UnreadCount > 0)
                {
                    <div class="flex items-center gap-2 bg-gradient-to-r from-amber-50 to-orange-50 dark:from-amber-900/20 dark:to-orange-900/20 px-4 py-2 rounded-lg border border-amber-200 dark:border-amber-800">
                        <span class="w-2 h-2 bg-amber-500 rounded-full animate-pulse"></span>
                        <span class="text-amber-800 dark:text-amber-200 font-semibold">
                            Непрочитанных: <span class="text-lg">@Model.UnreadCount</span>
                        </span>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-2 text-green-600 dark:text-green-400">
                        <i class="fas fa-check-circle"></i>
                        <span class="font-semibold">Все уведомления прочитаны</span>
                    </div>
                }
            </div>

            <div class="flex gap-3">
                <button id="markAllAsReadPage" class="gold-button text-sm">
                    <i class="fas fa-check-double"></i>
                    Прочитать все
                </button>

                <button id="enableSelectionMode" class="auth-btn-secondary text-sm">
                    <i class="fas fa-mouse-pointer"></i>
                    Выбрать
                </button>
            </div>
        </div>
    </div>

    <!-- Список уведомлений -->
    <div class="white-block" id="notificationsContainer">
        @if (Model.Notifications.Any())
        {
            <div id="notificationsList" class="divide-y divide-gray-100 dark:divide-gray-700">
                @foreach (var notification in Model.Notifications)
                {
                    <div class="notification-item group relative p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 cursor-pointer transition-all duration-200 @(!notification.IsRead ? "unread notification-slide-in" : "")"
                         data-notification-id="@notification.Id"
                         data-notification-read="@notification.IsRead"
                         data-notification-target="@notification.TargetUrl"
                         onclick="handleNotificationClick(event, @notification.Id, '@(notification.TargetUrl ?? "")')"
                         oncontextmenu="showContextMenu(event, @notification.Id)">

                        <!-- Скрытый чекбокс для выбора -->
                        <input type="checkbox"
                               class="notification-checkbox w-5 h-5 text-amber-600 rounded border-gray-300 focus:ring-amber-500 cursor-pointer"
                               value="@notification.Id"
                               onclick="event.stopPropagation()">

                        <div class="flex items-start justify-between mb-3">
                            <div class="flex items-center gap-3">
                                @if (!notification.IsRead)
                                {
                                    <span class="w-2 h-2 bg-amber-500 rounded-full animate-pulse flex-shrink-0 mt-2"
                                          title="Не прочитано"></span>
                                }

                                @if (!string.IsNullOrEmpty(notification.Type))
                                {
                                    <span class="notification-type-badge text-xs">
                                        @GetTypeIcon(notification.Type) @GetTypeLabel(notification.Type)
                                    </span>
                                }
                            </div>

                            <span class="notification-time text-sm flex-shrink-0">
                                <i class="far fa-clock mr-1"></i>@notification.FormattedDate
                            </span>
                        </div>

                        <p class="notification-message text-gray-800 dark:text-gray-200 mb-2 @(!notification.IsRead ? "font-semibold" : "")">
                            @notification.Message
                        </p>

                        @if (!string.IsNullOrEmpty(notification.TargetUrl))
                        {
                            <div class="flex items-center gap-2 text-amber-600 dark:text-amber-400 text-sm font-medium mt-3">
                                <i class="fas fa-external-link-alt"></i>
                                <span>Перейти к содержимому</span>
                                <i class="fas fa-chevron-right text-xs"></i>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Пагинация -->
            @if (Model.TotalPages > 1)
            {
                <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-600 mt-4">
                    <nav class="flex items-center justify-between">
                        <div>
                            @if (Model.CurrentPage > 1)
                            {
                                <a href="@Url.Action("Index", new { page = Model.CurrentPage - 1 })"
                                   class="gold-button text-sm">
                                    <i class="fas fa-arrow-left"></i>
                                    Назад
                                </a>
                            }
                        </div>

                        <div class="flex items-center gap-2 text-sm">
                            <span class="text-gray-600 dark:text-gray-400">Страница</span>
                            <span class="notification-header-gold font-bold text-lg">@Model.CurrentPage</span>
                            <span class="text-gray-600 dark:text-gray-400">из</span>
                            <span class="font-semibold text-gray-800 dark:text-gray-200">@Model.TotalPages</span>
                        </div>

                        <div>
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a href="@Url.Action("Index", new { page = Model.CurrentPage + 1 })"
                                   class="gold-button text-sm">
                                    Вперед
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            }
                        </div>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="notification-empty-state">
                <div class="notification-empty-icon">
                    <i class="fas fa-bell-slash"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Нет уведомлений</h3>
                <p class="text-gray-500 dark:text-gray-400 mb-6 max-w-md mx-auto">
                    Здесь появятся ваши уведомления о новых комментариях, лайках, сообщениях и других событиях
                </p>
                <div class="flex flex-col sm:flex-row gap-3 justify-center">
                    <a asp-controller="Home" asp-action="Index" class="gold-button">
                        <i class="fas fa-home"></i>
                        На главную
                    </a>
                    <a asp-controller="Catalog" asp-action="AllBooks" class="auth-btn-secondary">
                        <i class="fas fa-book"></i>
                        Найти произведения
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Контекстное меню -->
<div id="contextMenu" class="context-menu">
    <div class="context-menu-item" data-action="mark-read">
        <i class="fas fa-check-circle"></i>
        Пометить прочитанным
    </div>
    <div class="context-menu-item" data-action="select">
        <i class="fas fa-mouse-pointer"></i>
        Выбрать
    </div>
    <div class="context-menu-item delete" data-action="delete">
        <i class="fas fa-trash-alt"></i>
        Удалить
    </div>
</div>

<!-- Панель массовых действий -->
<div id="bulkActions" class="bulk-actions">
    <div class="flex items-center gap-4">
        <span class="selection-count" id="selectedCount">0</span>
        <span>уведомлений выбрано</span>
    </div>
    <div class="flex gap-2">
        <button id="bulkMarkRead" class="gold-button text-sm">
            <i class="fas fa-check-double"></i>
            Прочитать
        </button>
        <button id="bulkDelete" class="auth-btn-secondary text-sm bg-red-500 hover:bg-red-600 text-white border-red-500">
            <i class="fas fa-trash-alt"></i>
            Удалить
        </button>
        <button id="cancelSelection" class="auth-btn-secondary text-sm">
            <i class="fas fa-times"></i>
            Отмена
        </button>
    </div>
</div>

@section Scripts {
    <script>
        let selectionMode = false;
        let currentNotificationId = null;

        // Контекстное меню
        function showContextMenu(event, notificationId) {
            event.preventDefault();
            currentNotificationId = notificationId;

            const contextMenu = document.getElementById('contextMenu');
            contextMenu.style.display = 'block';
            contextMenu.style.left = event.pageX + 'px';
            contextMenu.style.top = event.pageY + 'px';

            // Обновляем состояние пунктов меню
            const notificationElement = document.querySelector(`[data-notification-id="${notificationId}"]`);
            const isRead = notificationElement.getAttribute('data-notification-read') === 'True';

            const markReadItem = contextMenu.querySelector('[data-action="mark-read"]');
            if (isRead) {
                markReadItem.style.display = 'none';
            } else {
                markReadItem.style.display = 'flex';
            }
        }

        // Закрытие контекстного меню
        document.addEventListener('click', function() {
            document.getElementById('contextMenu').style.display = 'none';
        });

        // Обработка действий контекстного меню
        document.getElementById('contextMenu').addEventListener('click', function(e) {
            const action = e.target.closest('.context-menu-item')?.dataset.action;
            if (!action || !currentNotificationId) return;

            switch (action) {
                case 'mark-read':
                    markAsRead(currentNotificationId);
                    break;
                case 'select':
                    enableSelectionMode();
                    // Автоматически выбираем текущее уведомление
                    const checkbox = document.querySelector(`[data-notification-id="${currentNotificationId}"] .notification-checkbox`);
                    if (checkbox) {
                        checkbox.checked = true;
                        updateSelectionState();
                    }
                    break;
                case 'delete':
                    deleteNotification(currentNotificationId);
                    break;
            }

            this.style.display = 'none';
        });

        // Обработка клика по уведомлению
        function handleNotificationClick(event, notificationId, targetUrl) {
            // Если в режиме выбора - игнорируем переход
            if (selectionMode) {
                const checkbox = event.currentTarget.querySelector('.notification-checkbox');
                if (checkbox && !event.target.matches('a, a *')) {
                    checkbox.checked = !checkbox.checked;
                    updateSelectionState();
                }
                return;
            }

            // Обычный режим - отмечаем прочитанным и переходим
            markAsRead(notificationId, () => {
                if (targetUrl && targetUrl.trim() !== '') {
                    window.location.href = targetUrl;
                }
            });
        }

        // Включение режима выбора
        function enableSelectionMode() {
            selectionMode = true;
            document.getElementById('notificationsContainer').classList.add('selection-mode');
            document.getElementById('bulkActions').classList.add('show');
            updateSelectionState();
        }

        // Отключение режима выбора
        function disableSelectionMode() {
            selectionMode = false;
            document.getElementById('notificationsContainer').classList.remove('selection-mode');
            document.getElementById('bulkActions').classList.remove('show');

            // Снимаем все выделения
            document.querySelectorAll('.notification-checkbox:checked').forEach(checkbox => {
                checkbox.checked = false;
            });
            updateSelectionState();
        }

        // Обновление состояния выбора
        function updateSelectionState() {
            const selectedCount = document.querySelectorAll('.notification-checkbox:checked').length;
            document.getElementById('selectedCount').textContent = selectedCount;

            if (selectedCount === 0 && selectionMode) {
                disableSelectionMode();
            }
        }

        // Пометить как прочитанное
        async function markAsRead(notificationId, callback = null) {
            const element = document.querySelector(`[data-notification-id="${notificationId}"]`);
            if (element) {
                element.classList.remove('unread');
                element.setAttribute('data-notification-read', 'True');
                element.querySelector('.bg-amber-500')?.remove();
                element.querySelector('.font-semibold')?.classList.remove('font-semibold');
            }

            try {
                await fetch('/Notification/MarkAsRead', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: notificationId })
                });

                // Обновляем счетчик в хедере
                if (typeof notificationManager !== 'undefined') {
                    setTimeout(() => notificationManager.loadNotificationCount(), 200);
                }

                if (callback) callback();
            } catch (error) {
                console.error('Ошибка:', error);
            }
        }

        // Удалить уведомление
        async function deleteNotification(notificationId) {
            if (!confirm('Удалить это уведомление?')) return;

            const element = document.querySelector(`[data-notification-id="${notificationId}"]`);
            if (element) {
                element.classList.add('fade-out');
            }

            try {
                await fetch('/Notification/DeleteSingle', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: notificationId })
                });

                setTimeout(() => {
                    if (element) element.remove();

                    // Проверяем, остались ли уведомления
                    if (document.querySelectorAll('.notification-item').length === 0) {
                        window.location.reload();
                    }
                }, 300);

            } catch (error) {
                console.error('Ошибка:', error);
            }
        }

        // Массовые операции
        document.getElementById('bulkMarkRead')?.addEventListener('click', async function() {
            const selectedIds = Array.from(document.querySelectorAll('.notification-checkbox:checked'))
                .map(checkbox => parseInt(checkbox.value));

            if (selectedIds.length === 0) return;

            for (const id of selectedIds) {
                await markAsRead(id);
            }

            disableSelectionMode();
        });

        document.getElementById('bulkDelete')?.addEventListener('click', async function() {
            const selectedIds = Array.from(document.querySelectorAll('.notification-checkbox:checked'))
                .map(checkbox => parseInt(checkbox.value));

            if (selectedIds.length === 0) return;

            if (!confirm(`Удалить ${selectedIds.length} уведомлений?`)) return;

            // Анимация удаления
            selectedIds.forEach(id => {
                const element = document.querySelector(`[data-notification-id="${id}"]`);
                if (element) element.classList.add('fade-out');
            });

            try {
                await fetch('/Notification/Delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(selectedIds)
                });

                setTimeout(() => {
                    selectedIds.forEach(id => {
                        const element = document.querySelector(`[data-notification-id="${id}"]`);
                        if (element) element.remove();
                    });

                    // Перезагружаем если не осталось уведомлений
                    if (document.querySelectorAll('.notification-item').length === 0) {
                        window.location.reload();
                    }

                    disableSelectionMode();
                }, 300);

            } catch (error) {
                console.error('Ошибка:', error);
            }
        });

        // Обработчики кнопок
        document.getElementById('enableSelectionMode')?.addEventListener('click', enableSelectionMode);
        document.getElementById('cancelSelection')?.addEventListener('click', disableSelectionMode);

        document.getElementById('markAllAsReadPage')?.addEventListener('click', function() {
            if (confirm('Отметить все уведомления как прочитанные?')) {
                fetch('/Notification/MarkAllAsRead', { method: 'POST' })
                    .then(response => {
                        if (response.ok) window.location.reload();
                    });
            }
        });

        // Закрытие контекстного меню по ESC
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.getElementById('contextMenu').style.display = 'none';
                if (selectionMode) {
                    disableSelectionMode();
                }
            }
        });
    </script>
}

@functions {
    private string GetTypeLabel(string type)
    {
        var labels = new Dictionary<string, string>
        {
            ["new_comment"] = "Комментарий",
            ["new_like"] = "Лайк",
            ["new_message"] = "Сообщение",
            ["system"] = "Системное",
            ["update"] = "Обновление",
            ["new_follower"] = "Подписчик",
            ["content_approved"] = "Публикация",
            ["content_rejected"] = "Модерация"
        };
        return labels.GetValueOrDefault(type, type);
    }

    private string GetTypeIcon(string type)
    {
        var icons = new Dictionary<string, string>
        {
            ["new_comment"] = "fas fa-comment",
            ["new_like"] = "fas fa-heart",
            ["new_message"] = "fas fa-envelope",
            ["system"] = "fas fa-cog",
            ["update"] = "fas fa-sync",
            ["new_follower"] = "fas fa-user-plus",
            ["content_approved"] = "fas fa-check-circle",
            ["content_rejected"] = "fas fa-exclamation-circle"
        };
        return icons.GetValueOrDefault(type, "fas fa-bell");
    }
}