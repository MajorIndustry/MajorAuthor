@model MajorAuthor.Models.CatalogViewModel

<!-- Сетка книг -->
@if (Model.Books.Any())
{
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-8" id="booksGrid">
        @foreach (var book in Model.Books)
        {
            <div class="white-block group cursor-pointer transform transition-all duration-300 hover:scale-105 hover:shadow-xl book-item"
                 data-href="@Url.Action("ReadBook", "Read", new { id = book.Id })">
                <div class="relative overflow-hidden rounded-t-xl">
                    @if (!string.IsNullOrEmpty(book.CoverImageUrl))
                    {
                        <img src="@book.CoverImageUrl" alt="Обложка книги"
                             class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-110"
                             onerror="handleImgError(this)">
                    }
                    else
                    {
                        <div class="w-full h-48 bg-gradient-to-br from-[var(--border-color)] to-gray-300 flex items-center justify-center">
                            <i class="fas fa-book text-4xl text-secondary-custom opacity-50"></i>
                        </div>
                    }
                    @if (book.IsAdultContent)
                    {
                        <span class="absolute top-2 left-2 bg-red-500 text-white text-xs px-2 py-1 rounded-full font-bold">18+</span>
                    }
                    <div class="absolute top-2 right-2 bg-[var(--accent-gold)] text-white text-xs px-2 py-1 rounded-full font-bold shadow-lg flex items-center">
                        <i class="fas fa-star mr-1"></i>@book.Rating.ToString("0.0")
                    </div>
                    <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent p-4">
                        <div class="flex justify-between items-end text-white">
                            <div>
                                <div class="flex items-center text-sm">
                                    <i class="fas fa-eye mr-1"></i>
                                    <span>@book.ReadsCount.ToString("N0")</span>
                                </div>
                                <div class="flex items-center text-sm mt-1">
                                    <i class="fas fa-heart mr-1 text-red-400"></i>
                                    <span>@book.LikesCount.ToString("N0")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="p-4">
                    <h3 class="font-semibold text-lg text-[var(--auth-block-text)] line-clamp-2 mb-2 group-hover:text-[var(--accent-gold)] transition-colors">
                        @book.Title
                    </h3>

                    <!-- Авторы -->
                    @if (book.Authors != null && book.Authors.Any())
                    {
                        <div class="flex flex-wrap gap-1 mb-3">
                            @foreach (var author in book.Authors.Take(3))
                            {
                                <span class="text-xs author-badge px-2 py-1 rounded-full">
                                    @author
                                </span>
                            }
                            @if (book.Authors.Count > 3)
                            {
                                <span class="text-xs bg-gray-500 bg-opacity-20 text-gray-500 px-2 py-1 rounded-full">
                                    +@(book.Authors.Count - 3)
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-wrap gap-1 mb-3">
                            <span class="text-xs author-badge px-2 py-1 rounded-full">
                                @book.AuthorName
                            </span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(book.Description))
                    {
                        <p class="text-sm text-[var(--auth-block-text)] opacity-90 line-clamp-2 mb-3">
                            @book.Description
                        </p>
                    }

                    <!-- Жанры с белым текстом -->
                    <div class="flex flex-wrap gap-1 mb-3">
                        @foreach (var genre in book.Genres.Take(3))
                        {
                            <span class="text-xs genre-badge px-2 py-1 rounded-full">
                                @genre
                            </span>
                        }
                        @if (book.Genres.Count > 3)
                        {
                            <span class="text-xs bg-gray-500 bg-opacity-20 text-gray-500 px-2 py-1 rounded-full">
                                +@(book.Genres.Count - 3)
                            </span>
                        }
                    </div>

                    <!-- Теги с темно-желтым текстом -->
                    @if (book.Tags != null && book.Tags.Any())
                    {
                        <div class="flex flex-wrap gap-1 mb-3">
                            @foreach (var tag in book.Tags.Take(3))
                            {
                                <span class="text-xs tag-badge px-2 py-1 rounded-full">
                                    #@tag.TrimStart('#')
                                </span>
                            }
                            @if (book.Tags.Count > 3)
                            {
                                <span class="text-xs bg-gray-500 bg-opacity-20 text-gray-500 px-2 py-1 rounded-full">
                                    +@(book.Tags.Count - 3)
                                </span>
                            }
                        </div>
                    }

                    <div class="flex items-center justify-between text-xs text-[var(--auth-block-text)] opacity-70 mt-3 pt-3 border-t border-[var(--auth-block-border)]">
                        <span class="content-type-badge">
                            <i class="fas fa-book"></i>Книга
                        </span>
                        <span>@book.PublicationDate.ToString("dd.MM.yyyy")</span>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Пагинация -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex justify-center items-center space-x-2" id="paginationContainer">
            @if (Model.Page > 1)
            {
                <a href="@Url.Action("AllBooks", new { sortBy = Model.SortBy, sortOrder = Model.SortOrder, page = Model.Page - 1, searchQuery = Model.SearchQuery, genres = Model.SelectedGenres, tags = Model.SelectedTags })"
                   class="pagination-btn" data-page="@(Model.Page - 1)">
                    <i class="fas fa-chevron-left mr-2"></i>Назад
                </a>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                if (i == Model.Page)
                {
                    <span class="pagination-btn active">@i</span>
                }
                else if (i == 1 || i == Model.TotalPages || (i >= Model.Page - 2 && i <= Model.Page + 2))
                {
                    <a href="@Url.Action("AllBooks", new { sortBy = Model.SortBy, sortOrder = Model.SortOrder, page = i, searchQuery = Model.SearchQuery, genres = Model.SelectedGenres, tags = Model.SelectedTags })"
                       class="pagination-btn" data-page="@i">@i</a>
                }
                else if (i == Model.Page - 3 || i == Model.Page + 3)
                {
                    <span class="pagination-btn">...</span>
                }
            }

            @if (Model.Page < Model.TotalPages)
            {
                <a href="@Url.Action("AllBooks", new { sortBy = Model.SortBy, sortOrder = Model.SortOrder, page = Model.Page + 1, searchQuery = Model.SearchQuery, genres = Model.SelectedGenres, tags = Model.SelectedTags })"
                   class="pagination-btn" data-page="@(Model.Page + 1)">
                    Вперед<i class="fas fa-chevron-right ml-2"></i>
                </a>
            }
        </div>
    }
}
else
{
    <div class="white-block text-center py-12">
        <i class="fas fa-book text-4xl text-[var(--auth-block-text)] opacity-70 mb-4"></i>
        <p class="text-[var(--auth-block-text)]">
            @(string.IsNullOrEmpty(Model.SearchQuery) ? "Книги не найдены" : "По вашему запросу ничего не найдено")
        </p>
        <p class="text-sm text-[var(--auth-block-text)] opacity-70 mt-2">
            @(string.IsNullOrEmpty(Model.SearchQuery) ? "Попробуйте изменить параметры сортировки или фильтры" : "Попробуйте изменить поисковый запрос или фильтры")
        </p>
        @if (!string.IsNullOrEmpty(Model.SearchQuery) || !string.IsNullOrEmpty(Model.SelectedGenres) || !string.IsNullOrEmpty(Model.SelectedTags))
        {
            <button onclick="clearSearchAndFilters()" class="auth-btn-primary mt-4">
                <i class="fas fa-times mr-2"></i>Очистить поиск и фильтры
            </button>
        }
    </div>
}

<style>
    /* Стили для бейджей авторов */
    .author-badge {
        background: rgba(59, 130, 246, 0.15) !important;
        color: rgb(30, 64, 175) !important;
        border: 1px solid rgba(59, 130, 246, 0.3) !important;
    }

    .genre-badge {
        background: var(--accent-gold) !important;
        color: white !important;
        border: 1px solid var(--accent-gold) !important;
    }

    .tag-badge {
        background: rgba(255, 193, 7, 0.15) !important;
        color: #b45309 !important;
        border: 1px solid rgba(255, 193, 7, 0.3) !important;
    }
</style>

<script>
    // Функция для обработки ошибок изображений
    function handleImgError(img) {
        try {
            img.onerror = null;
            const parent = img.parentElement;
            if (!parent) return;
            const fallback = document.createElement('div');
            fallback.className = 'w-full h-48 bg-gradient-to-br from-[var(--border-color)] to-gray-300 flex items-center justify-center';
            fallback.innerHTML = '<i class="fas fa-book text-4xl text-secondary-custom opacity-50"></i>';
            parent.replaceChild(fallback, img);
        } catch (e) { /* игнорировать */ }
    }

    // Обработчик клика по карточке книги
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.book-item').forEach(item => {
            if (!item.dataset.bound) {
                item.addEventListener('click', function(e) {
                    const tag = e.target.tagName.toLowerCase();
                    if (['button','a','input','label'].includes(tag) || e.target.closest('button, a')) return;
                    const href = this.getAttribute('data-href');
                    if (href) window.location.href = href;
                });
                item.dataset.bound = 'true';
            }
        });
    });
</script>