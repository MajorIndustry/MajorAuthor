@model MajorAuthor.Models.ViewModels.SearchViewModel
@{
    ViewData["Title"] = $"Результаты поиска для: {Model.SearchQuery}";
    Layout = "_Layout";

    string GetTabUrl(string tabName) => Url.Action("Index", new { query = Model.SearchQuery, tab = tabName, workSortBy = Model.WorkSortBy, authorSortBy = Model.AuthorSortBy });
    string GetWorkSortUrl(string tabName, string sortBy) => Url.Action("Index", new { query = Model.SearchQuery, tab = tabName, workSortBy = sortBy, authorSortBy = Model.AuthorSortBy });
    string GetAuthorSortUrl(string tabName, string sortBy) => Url.Action("Index", new { query = Model.SearchQuery, tab = tabName, workSortBy = Model.WorkSortBy, authorSortBy = sortBy });
}

<div class="min-h-screen flex flex-col items-center py-2 sm:py-4 md:py-8 w-full">
    <div class="w-full mx-auto px-2 sm:px-3 md:px-4 lg:px-6 max-w-7xl">

        <!-- Обновленный заголовок -->
        <div class="text-center mb-4 sm:mb-6 md:mb-8">
            <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold section-title decorative-title">
                Результаты поиска
            </h1>
        </div>

        @if (!Model.HasResults)
        {
            <div class="text-center py-8 sm:py-12 md:py-16 border border-[var(--border-color)] rounded-lg bg-[var(--bg-secondary)] mx-2">
                <p class="text-lg sm:text-xl md:text-2xl text-[var(--text-secondary)] mb-3 sm:mb-4">
                    😔 Ничего не найдено по запросу **"@Model.SearchQuery"**.
                </p>
                <p class="text-sm sm:text-base md:text-lg text-[var(--text-secondary)] px-4">
                    Попробуйте изменить поисковый запрос или проверить орфографию.
                </p>
            </div>
        }
        else
        {
            <div class="flex flex-col">
                <!-- Адаптивные вкладки с горизонтальным скроллом на мобильных -->
                <div class="text-xs sm:text-sm font-medium text-[var(--text-secondary)] border-b border-[var(--border-color)] mb-4 sm:mb-6 overflow-x-auto scrollbar-hide">
                    <ul class="flex flex-nowrap -mb-px min-w-max px-2 sm:px-0">
                        <li class="flex-shrink-0">
                            <a href="@GetTabUrl("all")" class="@(Model.ActiveTab == "all" ? "search-tab-active" : "search-tab-inactive") text-xs sm:text-sm px-3 sm:px-4 py-2 sm:py-4">
                                Все (@Model.AllCount)
                            </a>
                        </li>
                        <li class="flex-shrink-0">
                            <a href="@GetTabUrl("poems")" class="@(Model.ActiveTab == "poems" ? "search-tab-active" : "search-tab-inactive") text-xs sm:text-sm px-3 sm:px-4 py-2 sm:py-4">
                                Стихи (@Model.Poems.Count)
                            </a>
                        </li>
                        <li class="flex-shrink-0">
                            <a href="@GetTabUrl("books")" class="@(Model.ActiveTab == "books" ? "search-tab-active" : "search-tab-inactive") text-xs sm:text-sm px-3 sm:px-4 py-2 sm:py-4">
                                Книги (@Model.Books.Count)
                            </a>
                        </li>
                        <li class="flex-shrink-0">
                            <a href="@GetTabUrl("blogs")" class="@(Model.ActiveTab == "blogs" ? "search-tab-active" : "search-tab-inactive") text-xs sm:text-sm px-3 sm:px-4 py-2 sm:py-4">
                                Блоги (@Model.Blogs.Count)
                            </a>
                        </li>
                        <li class="flex-shrink-0">
                            <a href="@GetTabUrl("authors")" class="@(Model.ActiveTab == "authors" ? "search-tab-active" : "search-tab-inactive") text-xs sm:text-sm px-3 sm:px-4 py-2 sm:py-4">
                                Авторы (@Model.Authors.Count)
                            </a>
                        </li>
                    </ul>
                </div>

                <div id="tab-content" class="py-2 sm:py-4 overflow-hidden">
                    @if (Model.ActiveTab == "all")
                    {
                        <div class="flex flex-col xl:flex-row gap-4 sm:gap-6">
                            <!-- Произведения - полная ширина на мобильных -->
                            <section class="w-full xl:w-2/3 mb-6 xl:mb-0" id="all-works-tab">
                                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-3 sm:mb-4 border-b border-[var(--border-color)] pb-2">
                                    <h2 class="text-lg sm:text-xl md:text-2xl font-semibold section-title mb-2 sm:mb-0">
                                        Произведения (@Model.WorksCount)
                                    </h2>
                                    @if (Model.AllWorks != null && Model.AllWorks.Any())
                                    {
                                        <div class="flex flex-wrap gap-1 sm:gap-2 flex-shrink-0">
                                            <a href="@GetWorkSortUrl("all", "title")" class="@(Model.WorkSortBy == "title" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                                <i class="fas fa-sort-alpha-down me-1"></i> <span class="hidden xs:inline">По</span> алфавиту
                                            </a>
                                            <a href="@GetWorkSortUrl("all", "views")" class="@(Model.WorkSortBy == "views" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                                <i class="fas fa-eye me-1"></i> <span class="hidden xs:inline">По</span> просмотрам
                                            </a>
                                            <a href="@GetWorkSortUrl("all", "likes")" class="@(Model.WorkSortBy == "likes" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                                <i class="fas fa-heart me-1"></i> <span class="hidden xs:inline">По</span> лайкам
                                            </a>
                                        </div>
                                    }
                                </div>

                                @if (Model.AllWorks != null && Model.AllWorks.Any())
                                {
                                    <div class="grid grid-cols-1 gap-3 sm:gap-4 overflow-hidden">
                                        @foreach (var work in Model.AllWorks)
                                        {
                                            <div onclick="window.location.href = '@Url.Action(work.TargetAction, "Read", new { id = work.Id })'" class="white-block cursor-pointer mx-1 sm:mx-0">
                                                <div class="work-type-badge text-xs">@work.Type</div>
                                                <h3 class="work-title text-lg sm:text-xl">@work.Title</h3>
                                                <p class="author-name text-sm">Автор: @work.AuthorName</p>
                                                <p class="content-snippet text-sm sm:text-base">
                                                    @(work.Type == "Книга" ? "Книга" : work.ContentSnippet)
                                                </p>
                                                <div class="stats-container">
                                                    <div class="stat-item views text-xs sm:text-sm">
                                                        <i class="far fa-eye stat-icon"></i>
                                                        <span>@work.ViewsCount</span>
                                                    </div>
                                                    <div class="stat-item likes text-xs sm:text-sm">
                                                        <i class="fas fa-thumbs-up stat-icon"></i>
                                                        <span>@work.LikesCount</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-center text-[var(--text-secondary)] py-4 text-sm sm:text-base">Произведения по запросу не найдены.</p>
                                }
                            </section>

                            <!-- Авторы - полная ширина на мобильных -->
                            <section class="w-full xl:w-1/3" id="all-authors-tab">
                                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-3 sm:mb-4 border-b border-[var(--border-color)] pb-2">
                                    <h2 class="text-lg sm:text-xl md:text-2xl font-semibold section-title mb-2 sm:mb-0">
                                        Авторы (@Model.Authors.Count)
                                    </h2>
                                    @if (Model.Authors != null && Model.Authors.Any())
                                    {
                                        <div class="flex flex-wrap gap-1 sm:gap-2 flex-shrink-0">
                                            <a href="@GetAuthorSortUrl("all", "name")" class="@(Model.AuthorSortBy == "name" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                                <i class="fas fa-sort-alpha-down me-1"></i> <span class="hidden xs:inline">По</span> имени
                                            </a>
                                            <a href="@GetAuthorSortUrl("all", "subscribers")" class="@(Model.AuthorSortBy == "subscribers" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                                <i class="fas fa-users me-1"></i> <span class="hidden xs:inline">По</span> подписчикам
                                            </a>
                                        </div>
                                    }
                                </div>

                                @if (Model.Authors != null && Model.Authors.Any())
                                {
                                    <div class="grid grid-cols-1 gap-3 sm:gap-4 overflow-hidden">
                                        @foreach (var author in Model.Authors)
                                        {
                                            <div onclick="window.location.href = '@Url.Action("UserProfile", "Profile", new { id = author.Id })'" class="white-block author-card cursor-pointer mx-1 sm:mx-0">
                                                <img src="@author.PhotoUrl" alt="Аватар автора" class="author-avatar w-10 h-10 sm:w-12 sm:h-12" onerror="this.onerror=null;this.src='https://placehold.co/48x48/D4AF37/FFFFFF?text=А';">
                                                <div class="author-info">
                                                    <h3 class="author-main-name text-base sm:text-lg">@author.Name</h3>
                                                    @if (!string.IsNullOrWhiteSpace(author.PenName))
                                                    {
                                                        <p class="author-pen-name text-xs sm:text-sm">Псевдоним: @author.PenName</p>
                                                    }
                                                    <div class="author-subscribers text-xs">
                                                        <i class="fas fa-users"></i>
                                                        <span>@author.SubscribersCount подписчиков</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-center text-[var(--text-secondary)] py-4 text-sm sm:text-base">Авторы по запросу не найдены.</p>
                                }
                            </section>
                        </div>
                    }

                    @if (Model.ActiveTab == "poems")
                    {
                        <section class="mb-6 sm:mb-8" id="poems-tab">
                            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-3 sm:mb-4">
                                <h2 class="text-lg sm:text-xl md:text-2xl font-semibold section-title mb-2 sm:mb-0">Стихи (@Model.Poems.Count)</h2>
                                @if (Model.Poems != null && Model.Poems.Any())
                                {
                                    <div class="flex flex-wrap gap-1 sm:gap-2">
                                        <a href="@GetWorkSortUrl("poems", "title")" class="@(Model.WorkSortBy == "title" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                            <i class="fas fa-sort-alpha-down me-1"></i> <span class="hidden xs:inline">По</span> алфавиту
                                        </a>
                                        <a href="@GetWorkSortUrl("poems", "views")" class="@(Model.WorkSortBy == "views" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                            <i class="fas fa-eye me-1"></i> <span class="hidden xs:inline">По</span> просмотрам
                                        </a>
                                        <a href="@GetWorkSortUrl("poems", "likes")" class="@(Model.WorkSortBy == "likes" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                            <i class="fas fa-heart me-1"></i> <span class="hidden xs:inline">По</span> лайкам
                                        </a>
                                    </div>
                                }
                            </div>

                            @if (Model.Poems != null && Model.Poems.Any())
                            {
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 md:gap-6 overflow-hidden">
                                    @foreach (var poem in Model.Poems)
                                    {
                                        <div onclick="window.location.href = '@Url.Action("ReadPoem", "Read", new { id = poem.Id })'" class="white-block cursor-pointer mx-1 sm:mx-0">
                                            <div class="work-type-badge text-xs">Стих</div>
                                            <h3 class="work-title text-lg sm:text-xl">@poem.Title</h3>
                                            <p class="author-name text-sm">Автор: @poem.AuthorName</p>
                                            <p class="content-snippet text-sm sm:text-base">@poem.ContentSnippet</p>
                                            <div class="stats-container">
                                                <div class="stat-item views text-xs sm:text-sm">
                                                    <i class="far fa-eye stat-icon"></i>
                                                    <span>@poem.ViewsCount</span>
                                                </div>
                                                <div class="stat-item likes text-xs sm:text-sm">
                                                    <i class="fas fa-thumbs-up stat-icon"></i>
                                                    <span>@poem.LikesCount</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-center text-[var(--text-secondary)] py-4 text-sm sm:text-base">Стихи по запросу не найдены.</p>
                            }
                        </section>
                    }

                    @if (Model.ActiveTab == "books")
                    {
                        <section class="mb-6 sm:mb-8" id="books-tab">
                            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-3 sm:mb-4">
                                <h2 class="text-lg sm:text-xl md:text-2xl font-semibold section-title mb-2 sm:mb-0">Книги (@Model.Books.Count)</h2>
                                @if (Model.Books != null && Model.Books.Any())
                                {
                                    <div class="flex flex-wrap gap-1 sm:gap-2">
                                        <a href="@GetWorkSortUrl("books", "title")" class="@(Model.WorkSortBy == "title" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                            <i class="fas fa-sort-alpha-down me-1"></i> <span class="hidden xs:inline">По</span> алфавиту
                                        </a>
                                        <a href="@GetWorkSortUrl("books", "views")" class="@(Model.WorkSortBy == "views" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                            <i class="fas fa-eye me-1"></i> <span class="hidden xs:inline">По</span> просмотрам
                                        </a>
                                        <a href="@GetWorkSortUrl("books", "likes")" class="@(Model.WorkSortBy == "likes" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                            <i class="fas fa-heart me-1"></i> <span class="hidden xs:inline">По</span> лайкам
                                        </a>
                                    </div>
                                }
                            </div>

                            @if (Model.Books != null && Model.Books.Any())
                            {
                                <div class="grid grid-cols-2 xs:grid-cols-3 sm:grid-cols-3 md:grid-cols-4 gap-2 sm:gap-3 md:gap-4 lg:gap-6 overflow-hidden">
                                    @foreach (var book in Model.Books)
                                    {
                                        <div onclick="window.location.href = '@Url.Action("ReadBook", "Read", new { id = book.Id })'" class="white-block cursor-pointer text-center mx-1 sm:mx-0">
                                            <img src="@book.CoverImageUrl" alt="Обложка книги" class="w-12 h-18 sm:w-14 sm:h-20 md:w-16 md:h-24 object-cover mx-auto mb-2 sm:mb-3 rounded" onerror="this.onerror=null;this.src='https://placehold.co/60x90/D4AF37/FFFFFF?text=Книга';">
                                            <div class="work-type-badge text-xs">Книга</div>
                                            <h3 class="work-title text-sm sm:text-base md:text-lg">@book.Title</h3>
                                            <p class="author-name text-xs sm:text-sm">Автор: @book.AuthorName</p>
                                            @if (book.IsAdultContent)
                                            {
                                                <span class="text-xs text-red-500 font-bold">18+</span>
                                            }
                                            <div class="stats-container justify-center mt-2 sm:mt-3">
                                                <div class="stat-item views text-xs">
                                                    <i class="far fa-eye stat-icon"></i>
                                                    <span>@book.ViewsCount</span>
                                                </div>
                                                <div class="stat-item likes text-xs">
                                                    <i class="fas fa-thumbs-up stat-icon"></i>
                                                    <span>@book.LikesCount</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-center text-[var(--text-secondary)] py-4 text-sm sm:text-base">Книги по запросу не найдены.</p>
                            }
                        </section>
                    }

                    @if (Model.ActiveTab == "blogs")
                    {
                        <section class="mb-6 sm:mb-8" id="blogs-tab">
                            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-3 sm:mb-4">
                                <h2 class="text-lg sm:text-xl md:text-2xl font-semibold section-title mb-2 sm:mb-0">Блоги (@Model.Blogs.Count)</h2>
                                @if (Model.Blogs != null && Model.Blogs.Any())
                                {
                                    <div class="flex flex-wrap gap-1 sm:gap-2">
                                        <a href="@GetWorkSortUrl("blogs", "title")" class="@(Model.WorkSortBy == "title" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                            <i class="fas fa-sort-alpha-down me-1"></i> <span class="hidden xs:inline">По</span> алфавиту
                                        </a>
                                        <a href="@GetWorkSortUrl("blogs", "views")" class="@(Model.WorkSortBy == "views" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                            <i class="fas fa-eye me-1"></i> <span class="hidden xs:inline">По</span> просмотрам
                                        </a>
                                        <a href="@GetWorkSortUrl("blogs", "likes")" class="@(Model.WorkSortBy == "likes" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                            <i class="fas fa-heart me-1"></i> <span class="hidden xs:inline">По</span> лайкам
                                        </a>
                                    </div>
                                }
                            </div>

                            @if (Model.Blogs != null && Model.Blogs.Any())
                            {
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 md:gap-6 overflow-hidden">
                                    @foreach (var blog in Model.Blogs)
                                    {
                                        <div onclick="window.location.href = '@Url.Action("ReadBlog", "Read", new { id = blog.Id })'" class="white-block cursor-pointer mx-1 sm:mx-0">
                                            <div class="work-type-badge text-xs">Блог</div>
                                            <h3 class="work-title text-lg sm:text-xl">@blog.Title</h3>
                                            <p class="author-name text-sm">Автор: @blog.AuthorName</p>
                                            <p class="content-snippet text-sm sm:text-base">@blog.ContentSnippet</p>
                                            <div class="stats-container">
                                                <div class="stat-item views text-xs sm:text-sm">
                                                    <i class="far fa-eye stat-icon"></i>
                                                    <span>@blog.ViewsCount</span>
                                                </div>
                                                <div class="stat-item likes text-xs sm:text-sm">
                                                    <i class="fas fa-thumbs-up stat-icon"></i>
                                                    <span>@blog.LikesCount</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-center text-[var(--text-secondary)] py-4 text-sm sm:text-base">Блоги по запросу не найдены.</p>
                            }
                        </section>
                    }

                    @if (Model.ActiveTab == "authors")
                    {
                        <section class="mb-6 sm:mb-8" id="authors-tab">
                            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center mb-3 sm:mb-4">
                                <h2 class="text-lg sm:text-xl md:text-2xl font-semibold section-title mb-2 sm:mb-0">Авторы (@Model.Authors.Count)</h2>
                                @if (Model.Authors != null && Model.Authors.Any())
                                {
                                    <div class="flex flex-wrap gap-1 sm:gap-2">
                                        <a href="@GetAuthorSortUrl("authors", "name")" class="@(Model.AuthorSortBy == "name" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                            <i class="fas fa-sort-alpha-down me-1"></i> <span class="hidden xs:inline">По</span> имени
                                        </a>
                                        <a href="@GetAuthorSortUrl("authors", "subscribers")" class="@(Model.AuthorSortBy == "subscribers" ? "sort-button-active" : "sort-button-inactive") text-xs px-2 py-1 sm:px-3 sm:py-1">
                                            <i class="fas fa-users me-1"></i> <span class="hidden xs:inline">По</span> подписчикам
                                        </a>
                                    </div>
                                }
                            </div>

                            @if (Model.Authors != null && Model.Authors.Any())
                            {
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 md:gap-6 overflow-hidden">
                                    @foreach (var author in Model.Authors)
                                    {
                                        <div onclick="window.location.href = '@Url.Action("UserProfile", "Profile", new { id = author.Id })'" class="white-block author-card cursor-pointer mx-1 sm:mx-0">
                                            <img src="@author.PhotoUrl" alt="Аватар автора" class="author-avatar w-10 h-10 sm:w-12 sm:h-12 md:w-16 md:h-16" onerror="this.onerror=null;this.src='https://placehold.co/60x60/D4AF37/FFFFFF?text=А';">
                                            <div class="author-info">
                                                <h3 class="author-main-name text-base sm:text-lg md:text-xl">@author.Name</h3>
                                                @if (!string.IsNullOrWhiteSpace(author.PenName))
                                                {
                                                    <p class="author-pen-name text-xs sm:text-sm">Псевдоним: @author.PenName</p>
                                                }
                                                <div class="author-subscribers text-xs">
                                                    <i class="fas fa-users"></i>
                                                    <span>@author.SubscribersCount подписчиков</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-center text-[var(--text-secondary)] py-4 text-sm sm:text-base">Авторы по запросу не найдены.</p>
                            }
                        </section>
                    }
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Стили для декоративного заголовка */
    .decorative-title {
        position: relative;
        display: inline-block;
        padding: 0 1rem;
    }

        .decorative-title::before,
        .decorative-title::after {
            content: "";
            position: absolute;
            top: 50%;
            width: 40px;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--accent-color));
        }

        .decorative-title::before {
            left: -20px;
            transform: translateX(-100%);
        }

        .decorative-title::after {
            right: -20px;
            transform: translateX(100%);
            background: linear-gradient(90deg, var(--accent-color), transparent);
        }

    @@media (max-width: 640px) {
        .decorative-title::before, .decorative-title::after

    {
        width: 20px;
    }

    .decorative-title::before {
        left: -10px;
    }

    .decorative-title::after {
        right: -10px;
    }

    }

    /* Скрываем полосу прокрутки когда не нужна */
    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

